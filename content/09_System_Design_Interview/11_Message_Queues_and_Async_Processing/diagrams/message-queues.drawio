<mxCell id="j6" value="s4" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="262" y="130" width="70" height="30" as="geometry"/></mxCell>
<mxCell id="j7" value="main queue" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="j8" value="indexer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="124" width="120" height="42" as="geometry"/></mxCell>
<mxCell id="j9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j6" target="j8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="j10" value="try 1 fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="128" width="90" height="34" as="geometry"/></mxCell>
<mxCell id="j11" value="try 2 fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675" y="128" width="90" height="34" as="geometry"/></mxCell>
<mxCell id="j12" value="try 3 fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="128" width="90" height="34" as="geometry"/></mxCell>
<mxCell id="j13" value="DLQ: poison" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="j14" value="N = 3" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="j8" target="j13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="240"/></Array></mxGeometry></mxCell>
