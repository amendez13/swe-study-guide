<mxCell id="j18" value="effect" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="310" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="j19" value="queue keeps handing the same head" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="j20" value="blocks every message behind it" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="336" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="j21" value="log partition" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="j22" value="member never advances past it; that partition stalls" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="362" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="j23" value="N is a product choice (3 is common). Wait between tries → Unreliable Networks. A growing DLQ is a processing failure even if the main queue looks healthy (Observability)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
