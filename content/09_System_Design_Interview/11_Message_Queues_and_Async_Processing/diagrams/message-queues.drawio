<mxCell id="k20" value="crash point" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="k21" value="result" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="k22" value="before the send" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="k23" value="row still unsent → sent after restart" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="356" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="k24" value="after send, before mark" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="k25" value="sent again → consumers stay idempotent" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="382" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="k26" value="Database and broker preparing together → Two-Phase Commit. Compensating chain → Saga Pattern. The outbox is one local commit plus a later publish." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="820" height="40" as="geometry"/></mxCell>
