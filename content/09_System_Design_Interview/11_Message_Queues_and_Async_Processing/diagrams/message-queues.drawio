<mxCell id="j16" value="inspect, fix the page or bug, replay on purpose" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="266" width="240" height="30" as="geometry"/></mxCell>
