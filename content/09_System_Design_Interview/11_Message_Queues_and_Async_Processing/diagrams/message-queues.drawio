<mxCell id="i27" value="disk limit" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="614" y="132.0" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="i28" value="buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="i29" value="hold a spike that will drain" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="126" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="i30" value="drop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="164" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="i31" value="only where a loss is acceptable (per-minute sample)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="190" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="i32" value="throttle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="228" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="i33" value="slow the producer; limiter maths → Rate Limiting" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="254" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="i34" value="scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="292" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="i35" value="add consumers up to the partition count" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="318" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="i36" value="Signals: lag (group offset behind log head) and depth (messages a queue holds). Charts and alerts → Observability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="820" height="32" as="geometry"/></mxCell>
