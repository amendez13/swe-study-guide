  <diagram id="tls" name="Worker CPU After Offload">
    <mxGraphModel dx="900" dy="326" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="326" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="m41" value="Worker CPU After Offload" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="m42" value="4 workers × 1,000 ms CPU/s. Handler 8 ms; TLS on the worker adds 4 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="m43" value="TLS on the worker" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="m44" value="handler 8 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="116" width="240" height="34" as="geometry"/></mxCell>
<mxCell id="m45" value="TLS 4 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="116" width="120" height="34" as="geometry"/></mxCell>
<mxCell id="m46" value="12 ms → 4 × 1,000 / 12 = 333 QPS" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="116" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="m47" value="TLS on the balancer" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="m48" value="handler 8 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="166" width="240" height="34" as="geometry"/></mxCell>
<mxCell id="m49" value="8 ms → 500 QPS" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="166" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="m410" value="Terminating on the balancer also keeps the certificate in one place and lets Layer 7 read the path. Re-encrypting to the worker puts the 4 ms back." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="m411" value="&lt;b&gt;Answer:&lt;/b&gt; 333 QPS when the workers terminate TLS, 500 QPS when the balancer does." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
