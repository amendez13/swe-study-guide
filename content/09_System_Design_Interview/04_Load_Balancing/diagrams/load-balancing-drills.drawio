<mxCell id="m221" value="DNS should publish a few stable public addresses (the balancers); web-tier membership is the balancer&#x27;s job." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="m222" value="&lt;b&gt;Answer:&lt;/b&gt; The resolver can return the dead address for 70 s; the balancer drops the server 10 s after the first failed probe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="820" height="40" as="geometry"/></mxCell>
