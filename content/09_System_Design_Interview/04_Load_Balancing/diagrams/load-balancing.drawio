<mxCell id="l84" value="request&lt;br&gt;Cookie: lb_backend=web-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="200" height="46" as="geometry"/></mxCell>
<mxCell id="l85" value="balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="110" height="34" as="geometry"/></mxCell>
