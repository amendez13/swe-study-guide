<mxCell id="l726" value="probe on a timer: TCP connect or GET /health" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="244" width="380" height="26" as="geometry"/></mxCell>
<mxCell id="l727" value="shorter interval detects faster, costs probe traffic" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="520" y="244" width="340" height="26" as="geometry"/></mxCell>
