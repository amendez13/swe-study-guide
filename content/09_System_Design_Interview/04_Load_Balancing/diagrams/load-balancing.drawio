<mxCell id="l221" value="adding 10.0.4.14 is pool membership, not a DNS change" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="320" width="360" height="18" as="geometry"/></mxCell>
<mxCell id="l222" value="✗ Publishing every web server in DNS turns each add, remove, and crash into a client-visible change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dns" name="DNS-Level Load Balancing">
    <mxGraphModel dx="900" dy="366" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="366" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="l31" value="DNS-Level Load Balancing" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="l32" value="DNS can answer one name with several addresses, but caches hold the answer for the TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="l33" value="$&amp;nbsp;dig&amp;nbsp;pickup.example.com&lt;br&gt;;;&amp;nbsp;ANSWER&amp;nbsp;SECTION:&lt;br&gt;pickup.example.com.&amp;nbsp;&amp;nbsp;60&amp;nbsp;&amp;nbsp;IN&amp;nbsp;&amp;nbsp;A&amp;nbsp;&amp;nbsp;203.0.113.10&lt;br&gt;pickup.example.com.&amp;nbsp;&amp;nbsp;60&amp;nbsp;&amp;nbsp;IN&amp;nbsp;&amp;nbsp;A&amp;nbsp;&amp;nbsp;203.0.113.11" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="420" height="82" as="geometry"/></mxCell>
<mxCell id="l34" value="resolver cache&lt;br&gt;keeps the answer 60 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="l35" value="a dead address stays in rotation until the record is edited and every cache expires" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="166" width="340" height="36" as="geometry"/></mxCell>
<mxCell id="l36" value="No per-request health check: use DNS for a few stable public addresses" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="l37" value="pickup.example.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="170" height="36" as="geometry"/></mxCell>
<mxCell id="l38" value="LB 203.0.113.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="232" width="150" height="32" as="geometry"/></mxCell>
