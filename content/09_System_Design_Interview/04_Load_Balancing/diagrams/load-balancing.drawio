<mxCell id="l113" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l16" target="l112"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l114" value="server 3 ✗ not answering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="204" width="200" height="38" as="geometry"/></mxCell>
