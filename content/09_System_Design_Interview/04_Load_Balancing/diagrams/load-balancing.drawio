<mxCell id="l820" value="one server gets the whole office" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="230" height="30" as="geometry"/></mxCell>
<mxCell id="l821" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l816" target="l820"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l822" value="a phone that changes networks lands on a new server" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="590" y="280" width="270" height="30" as="geometry"/></mxCell>
<mxCell id="l823" value="Header: the app (or a hop in front) sets a header the balancer hashes. Same pin, app chooses the key." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="l824" value="One TCP connection is already pinned (a WebSocket while it stays up). The pin piles load on the servers people hit first, and a restart drops their sessions. Move the session to a shared store (Scalability Fundamentals)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="386" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
