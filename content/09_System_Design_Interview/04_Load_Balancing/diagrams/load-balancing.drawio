<mxCell id="l14" value="client 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="100" height="34" as="geometry"/></mxCell>
<mxCell id="l15" value="client 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="100" height="34" as="geometry"/></mxCell>
<mxCell id="l16" value="load balancer&lt;br&gt;(one address)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="160" width="140" height="56" as="geometry"/></mxCell>
