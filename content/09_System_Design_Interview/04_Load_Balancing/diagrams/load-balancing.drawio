    </mxGraphModel>
  </diagram>
  <diagram id="l4l7" name="Layer 4 vs. Layer 7 Load Balancing">
    <mxGraphModel dx="900" dy="420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="420" math="0" shadow="0">
