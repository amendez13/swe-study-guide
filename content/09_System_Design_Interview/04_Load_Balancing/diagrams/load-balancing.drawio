<mxCell id="l46" value="sees IP + port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="146" width="110" height="46" as="geometry"/></mxCell>
<mxCell id="l47" value="door pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="100" height="30" as="geometry"/></mxCell>
