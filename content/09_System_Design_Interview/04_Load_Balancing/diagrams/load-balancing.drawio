<mxCell id="l816" value="NAT 10.9.9.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="280" width="110" height="30" as="geometry"/></mxCell>
<mxCell id="l817" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l813" target="l816"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l818" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l814" target="l816"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
