<mxCell id="l116" value="server 4 (just added)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="256" width="200" height="38" as="geometry"/></mxCell>
<mxCell id="l117" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="l16" target="l116"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l118" value="stops receiving new work" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="690" y="204" width="170" height="38" as="geometry"/></mxCell>
<mxCell id="l119" value="capacity rises; clients see no change" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="690" y="256" width="170" height="38" as="geometry"/></mxCell>
<mxCell id="l120" value="This is what makes a horizontal web tier usable: extra machines nobody can reach add no capacity. The same box reappears between web and app tiers, or in front of a database proxy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="front" name="In Front of the Web Tier">
    <mxGraphModel dx="900" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="400" math="0" shadow="0">
