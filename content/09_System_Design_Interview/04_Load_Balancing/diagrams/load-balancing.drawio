<mxCell id="l87" value="web-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="104" width="110" height="30" as="geometry"/></mxCell>
<mxCell id="l88" value="web-b (session)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="140" height="30" as="geometry"/></mxCell>
<mxCell id="l89" value="web-c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="176" width="110" height="30" as="geometry"/></mxCell>
<mxCell id="l810" value="pinned" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l85" target="l88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l811" value="web-b down → ignore the cookie, pick a live server; the session that lived only on web-b is gone" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="124" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="l812" value="Client IP hash" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="l813" value="office user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="110" height="26" as="geometry"/></mxCell>
<mxCell id="l814" value="office user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="286" width="110" height="26" as="geometry"/></mxCell>
