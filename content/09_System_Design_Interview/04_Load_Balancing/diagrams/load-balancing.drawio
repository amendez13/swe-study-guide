<mxCell id="l321" value="DNS → balancers; the balancer chooses the web server, with health checks" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="660" y="240" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="l322" value="Which site a name should resolve to is Multi-DC and Geo Routing (High Availability)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="820" height="18" as="geometry"/></mxCell>
