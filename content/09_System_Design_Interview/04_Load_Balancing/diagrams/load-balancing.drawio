<mxCell id="l91" value="Load Balancer as a Single Point of Failure" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="l92" value="One balancer is one failure domain: the web pool can be up and unreachable. Run a pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="l93" value="Active-passive" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="265" height="18" as="geometry"/></mxCell>
<mxCell id="l94" value="VIP 203.0.113.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="124" width="145" height="30" as="geometry"/></mxCell>
<mxCell id="l95" value="LB-1 active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="115" height="34" as="geometry"/></mxCell>
<mxCell id="l96" value="LB-2 standby" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="180" y="180" width="115" height="34" as="geometry"/></mxCell>
<mxCell id="l97" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l94" target="l95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l98" value="moves on failure" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="l94" target="l96"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l99" value="one public address; a floating IP moves to the standby" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="l910" value="short blip; the standby must already know the pool" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="l911" value="Active-active" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="98" width="265" height="18" as="geometry"/></mxCell>
<mxCell id="l912" value="DNS / anycast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="387" y="124" width="125" height="30" as="geometry"/></mxCell>
<mxCell id="l913" value="LB-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="327" y="180" width="115" height="34" as="geometry"/></mxCell>
<mxCell id="l914" value="LB-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="457" y="180" width="115" height="34" as="geometry"/></mxCell>
<mxCell id="l915" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l912" target="l913"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l916" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l912" target="l914"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l917" value="both serve; DNS or anycast advertises both" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="317" y="226" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="l918" value="each needs headroom for the other&#x27;s share; stop advertising the dead one" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="317" y="262" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="l919" value="Managed" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="98" width="265" height="18" as="geometry"/></mxCell>
<mxCell id="l920" value="one name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="664" y="124" width="125" height="30" as="geometry"/></mxCell>
<mxCell id="l921" value="managed LB&lt;br&gt;(a pair inside)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="654" y="176" width="145" height="42" as="geometry"/></mxCell>
<mxCell id="l922" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l920" target="l921"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l923" value="the cloud balancer is redundant behind one name" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="594" y="226" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="l924" value="draw one box and say the provider runs the pair" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="594" y="262" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="l925" value="In-flight requests on the balancer that died do not finish; new requests succeed once the address points at a live one. When you draw one balancer, say which pattern it stands for." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="40" as="geometry"/></mxCell>
