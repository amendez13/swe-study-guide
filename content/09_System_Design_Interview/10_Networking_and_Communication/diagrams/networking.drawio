<mxCell id="k8" value="yes — same body replaces again" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="150" y="152" width="330" height="26" as="geometry"/></mxCell>
