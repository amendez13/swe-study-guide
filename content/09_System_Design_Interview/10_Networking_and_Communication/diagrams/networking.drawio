<mxCell id="k10" value="yes — absent stays absent" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="150" y="178" width="330" height="26" as="geometry"/></mxCell>
