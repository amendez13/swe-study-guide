<mxCell id="k727" value="oldest last access" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="248" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k728" value="a long scan of one-time keys walks the hot set out; samplers approximate it" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="248" width="540" height="26" as="geometry"/></mxCell>
<mxCell id="k729" value="LFU" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="100" height="26" as="geometry"/></mxCell>
<mxCell id="k730" value="lowest access count" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="274" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k731" value="protects stable popularity; a decaying count lets yesterday&#x27;s spike go" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="274" width="540" height="26" as="geometry"/></mxCell>
