<mxCell id="k733" value="oldest insertion" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k734" value="a recent access does not save the key (would evict A here)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="540" height="26" as="geometry"/></mxCell>
<mxCell id="k735" value="Random" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="100" height="26" as="geometry"/></mxCell>
<mxCell id="k736" value="any key" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="326" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k737" value="cheap; a hot key is as likely to go as a cold one" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="326" width="540" height="26" as="geometry"/></mxCell>
