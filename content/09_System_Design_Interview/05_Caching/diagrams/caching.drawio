<mxCell id="k31" value="Hit Ratio Math" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="k32" value="Hit ratio = hits / (hits + misses). It is measured for this workload and feeds latency and database load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="k33" value="400 hits × 1 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="608.0" height="40" as="geometry"/></mxCell>
<mxCell id="k34" value="100 misses × 21 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="668.0" y="110" width="152.0" height="40" as="geometry"/></mxCell>
<mxCell id="k35" value="hit ratio 0.8 · mean = (400 × 1 + 100 × 21) / 500 = 5 ms · database reads ≈ misses = 100" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="156" width="760" height="20" as="geometry"/></mxCell>
<mxCell id="k36" value="database&amp;nbsp;reads&amp;nbsp;≈&amp;nbsp;misses&lt;br&gt;required&amp;nbsp;hit&amp;nbsp;ratio&amp;nbsp;≈&amp;nbsp;1&amp;nbsp;−&amp;nbsp;database&amp;nbsp;budget&amp;nbsp;/&amp;nbsp;eligible&amp;nbsp;reads" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="520" height="44" as="geometry"/></mxCell>
<mxCell id="k37" value="both lines assume one database read per miss" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="196" width="280" height="36" as="geometry"/></mxCell>
<mxCell id="k38" value="what happens" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="380" height="26" as="geometry"/></mxCell>
<mxCell id="k39" value="database reads vs misses" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="440" height="26" as="geometry"/></mxCell>
<mxCell id="k310" value="stampede, retry, fan-out to many rows" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="380" height="26" as="geometry"/></mxCell>
<mxCell id="k311" value="more reads than misses" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="276" width="440" height="26" as="geometry"/></mxCell>
<mxCell id="k312" value="negative cache marker stored" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="380" height="26" as="geometry"/></mxCell>
<mxCell id="k313" value="fewer: later lookups of the missing key hit" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="302" width="440" height="26" as="geometry"/></mxCell>
<mxCell id="k314" value="fail-closed timeout" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="380" height="26" as="geometry"/></mxCell>
<mxCell id="k315" value="no database read; keep it out of the miss total" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="328" width="440" height="26" as="geometry"/></mxCell>
<mxCell id="k316" value="every retry that reaches the database" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="380" height="26" as="geometry"/></mxCell>
<mxCell id="k317" value="count it, or the load is understated" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="354" width="440" height="26" as="geometry"/></mxCell>
<mxCell id="k318" value="The ratio is an average: one key can always miss inside a high average, and each miss still waits the full miss time." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="820" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
