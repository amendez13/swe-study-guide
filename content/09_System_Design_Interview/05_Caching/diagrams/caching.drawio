<mxCell id="k1314" value="callers fail closed" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="k1315" value="database stays at steady; readers see errors" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="k1316" value="warm replica per node" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="k1317" value="the steady rate stands, apart from the failover blip" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="326" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="k1318" value="warm a replacement before traffic" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="k1319" value="an empty node that passes a port check still has hit ratio 0" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="352" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="k1320" value="single-flight on misses" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="k1321" value="each distinct key costs one read while waiters share it" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="378" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="k1322" value="Memory headroom: at the eviction ceiling a burst of new keys evicts the hot set. The working set plus the burst must fit; there is no universal spare fraction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="820" height="40" as="geometry"/></mxCell>
