<mxCell id="k533" value="ack: this cache entry and the row match" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="184" y="478" width="222" height="15" as="geometry"/></mxCell>
<mxCell id="k534" value="trade-off" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="532" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k535" value="detail" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="532" width="640" height="26" as="geometry"/></mxCell>
<mxCell id="k536" value="slower writes" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k537" value="the write waits for both hops; values are stored even if never read again" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="558" width="640" height="26" as="geometry"/></mxCell>
<mxCell id="k538" value="failure" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="584" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k539" value="database write fails → cache drops the new value; cache down → the write fails unless the app bypasses" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="584" width="640" height="26" as="geometry"/></mxCell>
<mxCell id="k540" value="still stale elsewhere" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k541" value="a process cache in front, a lagging replica, another key that embeds the row" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="610" width="640" height="26" as="geometry"/></mxCell>
<mxCell id="k542" value="stampede" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="180" height="26" as="geometry"/></mxCell>
<mxCell id="k543" value="concurrent misses meet inside the loader, so protection must live there" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="636" width="640" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="behind" name="Write-Behind (Write-Back)">
    <mxGraphModel dx="900" dy="382" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="382" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="k61" value="Write-Behind (Write-Back)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="k62" value="Acknowledge after the cache write; flush to the database later in batches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="k63" value="app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="90" height="40" as="geometry"/></mxCell>
<mxCell id="k64" value="cache&lt;br&gt;dirty keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="k65" value="database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="130" height="80" as="geometry"/></mxCell>
<mxCell id="k66" value="write" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="k63" target="k64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="k67" value="ack (cache hop only)" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;exitX=0;exitY=0.85;entryX=1;entryY=0.85;" edge="1" parent="1" source="k64" target="k63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="k68" value="flush later, batched" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="k64" target="k65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="k69" value="Until the flush, the cache holds the only copy of an acknowledged write" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="k610" value="&lt;b&gt;evict a dirty key without flushing&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the write is gone&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="265" height="56" as="geometry"/></mxCell>
<mxCell id="k611" value="&lt;b&gt;crash&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;every dirty key not in the database or a waited-for replica is gone&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="236" width="265" height="56" as="geometry"/></mxCell>
<mxCell id="k612" value="&lt;b&gt;miss loads the database row&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;an older row can cover the newer dirty value&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="236" width="265" height="56" as="geometry"/></mxCell>
<mxCell id="k613" value="Acknowledge&amp;nbsp;after&amp;nbsp;the&amp;nbsp;cache&amp;nbsp;write.&lt;br&gt;Flush&amp;nbsp;before&amp;nbsp;eviction.&lt;br&gt;A&amp;nbsp;miss&amp;nbsp;must&amp;nbsp;not&amp;nbsp;cover&amp;nbsp;a&amp;nbsp;dirty&amp;nbsp;key&amp;nbsp;with&amp;nbsp;the&amp;nbsp;older&amp;nbsp;database&amp;nbsp;row." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="520" height="62" as="geometry"/></mxCell>
<mxCell id="k614" value="Fits samples, counters, streams that can lose a short unflushed window. A price, balance, or seat count stays on cache-aside or write-through." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="306" width="280" height="62" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
