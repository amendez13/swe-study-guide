<mxCell id="k134" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="55.999999999999986" height="34" as="geometry"/></mxCell>
<mxCell id="k135" value="R(1 − h) = 200/s" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="334.0" y="110" width="260" height="34" as="geometry"/></mxCell>
<mxCell id="k136" value="1 of 4 nodes cold, no replica" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="154" width="220" height="34" as="geometry"/></mxCell>
<mxCell id="k137" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="154" width="182.0" height="34" as="geometry"/></mxCell>
<mxCell id="k138" value="R(1 − h) + hR/N = 650/s" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460.0" y="154" width="260" height="34" as="geometry"/></mxCell>
<mxCell id="k139" value="whole cache down, fall through" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="220" height="34" as="geometry"/></mxCell>
<mxCell id="k1310" value="R = 2,000/s (10× = 1/(1 − h))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="198" width="560.0" height="34" as="geometry"/></mxCell>
<mxCell id="k1311" value="example: R = 2,000 eligible reads/s, h = 0.9, N = 4 (the drill&#x27;s numbers)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="820" height="16" as="geometry"/></mxCell>
<mxCell id="k1312" value="lever" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="300" height="26" as="geometry"/></mxCell>
