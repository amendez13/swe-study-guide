<mxCell id="k146" value="&lt;b&gt;database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;the durable row&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="120" width="190" height="60" as="geometry"/></mxCell>
