<mxCell id="q51" value="Pick the Write Pattern" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="q52" value="Three catalog writes, three requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="q53" value="price column; cached as {title, price, cover}; stale until TTL is fine; must survive a crash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="q54" value="&lt;b&gt;cache-aside&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;commit, then delete book:7; the next miss rebuilds&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="340" height="56" as="geometry"/></mxCell>
<mxCell id="q55" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q53" target="q54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="q56" value="seat row cached in the same shape; the next cache read must already show it; must survive a crash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="q57" value="&lt;b&gt;write-through&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;ack waits for the commit; the entry is already the new row&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="340" height="56" as="geometry"/></mxCell>
<mxCell id="q58" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q56" target="q57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="q59" value="20,000 entrance samples/s; display may lag ~1 s; losing the unflushed second is acceptable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="q510" value="&lt;b&gt;write-behind&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;ack on the memory update; batches to the database&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="340" height="56" as="geometry"/></mxCell>
<mxCell id="q511" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q59" target="q510"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="q512" value="&lt;b&gt;Answer:&lt;/b&gt; Price → cache-aside. Seat count → write-through. Entrance counter → write-behind (flush dirty counters before eviction)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
