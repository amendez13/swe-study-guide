<mxCell id="q713" value="2,000 × 1/10 = 200/s" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="432.61538461538464" y="190" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="q714" value="after the death" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="190" height="34" as="geometry"/></mxCell>
