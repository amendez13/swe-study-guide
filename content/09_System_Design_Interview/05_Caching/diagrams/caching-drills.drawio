<mxCell id="q72" value="4 nodes, no replica, 2,000 reads/s, warm hit ratio 9/10, callers fall through. One node dies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
