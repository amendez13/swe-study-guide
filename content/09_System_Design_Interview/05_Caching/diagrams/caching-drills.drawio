<mxCell id="q74" value="500 reads → 50 miss" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="190" height="18" as="geometry"/></mxCell>
