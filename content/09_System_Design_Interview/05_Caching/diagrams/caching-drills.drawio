<mxCell id="q711" value="steady" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="190" height="34" as="geometry"/></mxCell>
