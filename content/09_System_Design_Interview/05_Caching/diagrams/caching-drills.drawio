<mxCell id="q716" value="= 650/s" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="848" y="234" width="80" height="34" as="geometry"/></mxCell>
<mxCell id="q717" value="The extra 450 = the hits the dead node absorbed (h × R / N). A warm replica keeps the steady 200; an empty replacement that passes a port check is still 650." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="q718" value="&lt;b&gt;Answer:&lt;/b&gt; 200 reads/s steady, 650 after one node dies. A warm replica holds it at 200 (apart from the failover)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="820" height="40" as="geometry"/></mxCell>
