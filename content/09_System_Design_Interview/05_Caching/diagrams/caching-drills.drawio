<mxCell id="q676" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;" edge="1" parent="1" source="q675" target="q674"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="q677" value="Give the loader and the waiters timeouts. Serving the slightly older value while one request refreshes keeps the 29 from blocking. Jitter does nothing for a just-deleted key." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="q678" value="&lt;b&gt;Answer:&lt;/b&gt; 30 database reads without protection; 1 with a single loader (the other 29 share the result)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
