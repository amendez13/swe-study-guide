<mxCell id="i6" value="accept: gift_wrap optional, default false → id 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="104" width="340" height="40" as="geometry"/></mxCell>
<mxCell id="i7" value="refuse: cents int → string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="156" width="340" height="34" as="geometry"/></mxCell>
<mxCell id="i8" value="refuse: drop sku (old readers require it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="198" width="340" height="34" as="geometry"/></mxCell>
<mxCell id="i9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="i4" target="i6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
