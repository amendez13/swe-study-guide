<mxCell id="i12" value="Kafka record: magic byte + 4-byte id 7 + Avro bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="270" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="i13" value="consumer&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;caches schema 7&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="264" width="150" height="52" as="geometry"/></mxCell>
<mxCell id="i14" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i12" target="i13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="i15" value="fetch schema 7" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="i13" target="i4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="635" y="246"/><mxPoint x="340" y="246"/></Array></mxGeometry></mxCell>
<mxCell id="i16" value="Confluent&#x27;s default rule is backward, non-transitive (latest only). Transitive checks every registered version — what a 7-day log holding several generations needs. The log keeps bytes and offsets (Log or Queue)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="820" height="40" as="geometry"/></mxCell>
