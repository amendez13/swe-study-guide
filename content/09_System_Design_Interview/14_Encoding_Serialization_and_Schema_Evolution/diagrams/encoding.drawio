<mxCell id="i4" value="registry&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;subject: orders-value · rule: full&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="140" width="240" height="64" as="geometry"/></mxCell>
