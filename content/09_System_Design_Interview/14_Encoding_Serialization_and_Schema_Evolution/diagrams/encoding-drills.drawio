<mxCell id="a1" value="Serialization Format" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a2" value="Four readers of the shop order: JSON, Protocol Buffers, Avro, or Parquet?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="a3" value="1. mobile-api: hand-written phone app, no generated client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="360" height="44" as="geometry"/></mxCell>
