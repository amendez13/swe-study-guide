<mxCell id="a10" value="field numbers; internal RPC" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="610" y="162" width="290" height="44" as="geometry"/></mxCell>
