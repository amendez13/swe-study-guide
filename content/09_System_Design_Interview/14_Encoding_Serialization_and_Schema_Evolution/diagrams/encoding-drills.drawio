<mxCell id="b11" value="One board sample can spend 44 bytes unnoticed; the night spends them 21,600 times. The 16-byte line is a floor on values — real protobuf encodes numbers and tags differently." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="820" height="40" as="geometry"/></mxCell>
