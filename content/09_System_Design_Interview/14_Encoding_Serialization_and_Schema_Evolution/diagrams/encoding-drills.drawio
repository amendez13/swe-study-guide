<mxCell id="a5" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a6" value="names stay in the text" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="610" y="104" width="290" height="44" as="geometry"/></mxCell>
<mxCell id="a7" value="2. inventory-rpc: checkout calls inventory, both compiled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="360" height="44" as="geometry"/></mxCell>
