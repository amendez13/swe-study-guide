<mxCell id="j26" value="another process to keep up; new step = change it" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="378" width="320" height="26" as="geometry"/></mxCell>
<mxCell id="j27" value="rides the bus; first event may need the outbox" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="378" width="320" height="26" as="geometry"/></mxCell>
<mxCell id="j28" value="Not 2PC: a saga commits each step, then undoes it later with a compensating write if a later step fails." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="820" height="32" as="geometry"/></mxCell>
