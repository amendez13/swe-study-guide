<mxCell id="f251" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f248" target="f249"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f252" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f249" target="f250"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f253" value="Keep a visible clock. Say the cut out loud: “Search waits, so we can finish the write path and the failure story.”" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="820" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fnf" name="Functional vs. Non-Functional Requirements">
    <mxGraphModel dx="900" dy="396" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="396" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="f31" value="Functional vs. Non-Functional Requirements" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="f32" value="Functional = what the system does. Non-functional = how well. Gather both before designing anything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="f33" value="&lt;b&gt;Functional (what)&lt;/b&gt;&lt;br&gt;• send messages to other users&lt;br&gt;• create group chats&lt;br&gt;• messages persisted and retrievable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="400" height="96" as="geometry"/></mxCell>
<mxCell id="f34" value="&lt;b&gt;Non-functional (how well)&lt;/b&gt;&lt;br&gt;• delivery latency &amp;lt; 200 ms&lt;br&gt;• 99.99% availability&lt;br&gt;• 50M daily active users&lt;br&gt;• messages kept 5 years" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="400" height="96" as="geometry"/></mxCell>
<mxCell id="f35" value="Same functional list, different non-functional numbers → different architecture" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="820" height="20" as="geometry"/></mxCell>
