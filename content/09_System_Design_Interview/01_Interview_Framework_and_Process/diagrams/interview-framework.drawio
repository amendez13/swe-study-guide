<mxCell id="f58" value="2^30 ≈ ~1 GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="150" height="28" as="geometry"/></mxCell>
