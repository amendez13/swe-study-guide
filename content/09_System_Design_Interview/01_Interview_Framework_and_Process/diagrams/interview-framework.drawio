<mxCell id="f41" value="Scope Management During the Interview" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="f42" value="Scoping includes a cut list. Name what you defer and why; spend the time on one or two hard problems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="f43" value="In scope: core messaging flow&lt;br&gt;(write path first, it is the harder scaling problem)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="f44" value="&lt;b&gt;Deferred: Authentication&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;an existing service handles it&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="220" height="52" as="geometry"/></mxCell>
<mxCell id="f45" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f43" target="f44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f46" value="&lt;b&gt;Deferred: Read path details&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;after the write path is solid&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="220" height="52" as="geometry"/></mxCell>
<mxCell id="f47" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="f43" target="f46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f48" value="&lt;b&gt;Deferred: Encryption at rest&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;later; focus on delivery guarantees&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="220" height="52" as="geometry"/></mxCell>
