<mxCell id="f715" value="messages keyed by (chat_id, timestamp)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="544" y="160" width="148" height="50" as="geometry"/></mxCell>
<mxCell id="f716" value="store that is good at range reads by key" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="712" y="160" width="148" height="50" as="geometry"/></mxCell>
<mxCell id="f717" value="✗ Database first: “we&#x27;ll use X” then bend the problem to fit it" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="f718" value="Technology choices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="f719" value="Data model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="250" y="262" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="f720" value="…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="460" y="262" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="f721" value="API contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="670" y="262" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="f722" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="f718" target="f719"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f723" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="f719" target="f720"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f724" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="f720" target="f721"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f725" value="Like writing the press release before the code: define the API, get buy-in on the chain, then deep-dive. If the interviewer disagrees with the API, fix it while the drawing is still small." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="api" name="Defining the API Contract">
    <mxGraphModel dx="900" dy="370" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="370" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="f81" value="Defining the API Contract" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="f82" value="Sketch the endpoints before the boxes. The contract surfaces hidden requirements for the interviewer to react to" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="f83" value="POST&amp;nbsp;/messages&lt;br&gt;&amp;nbsp;&amp;nbsp;Body:&amp;nbsp;{&amp;nbsp;to,&amp;nbsp;text&amp;nbsp;}&lt;br&gt;&amp;nbsp;&amp;nbsp;201&amp;nbsp;{&amp;nbsp;message_id,&amp;nbsp;timestamp&amp;nbsp;}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="330" height="64" as="geometry"/></mxCell>
<mxCell id="f84" value="GET&amp;nbsp;/messages?chat_id=xyz&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;amp;before=timestamp&amp;amp;limit=50&lt;br&gt;&amp;nbsp;&amp;nbsp;200&amp;nbsp;{&amp;nbsp;messages:&amp;nbsp;[...],&amp;nbsp;has_more&amp;nbsp;}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="330" height="64" as="geometry"/></mxCell>
<mxCell id="f85" value="GET&amp;nbsp;/chats&lt;br&gt;&amp;nbsp;&amp;nbsp;200&amp;nbsp;{&amp;nbsp;chats:&amp;nbsp;[{&amp;nbsp;id,&amp;nbsp;last_message&amp;nbsp;}]&amp;nbsp;}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="330" height="50" as="geometry"/></mxCell>
<mxCell id="f86" value="server assigns id + timestamp → it owns ordering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="420" height="34" as="geometry"/></mxCell>
<mxCell id="f87" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="136" as="sourcePoint"/><mxPoint x="440" y="136" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f88" value="pagination: cursor by timestamp, page size, has_more&lt;br&gt;sort order: newest first, older pages on demand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="440" y="196" width="420" height="44" as="geometry"/></mxCell>
<mxCell id="f89" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="212" as="sourcePoint"/><mxPoint x="440" y="212" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f810" value="list view needs last_message → store or derive a per-chat summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="440" y="264" width="420" height="34" as="geometry"/></mxCell>
<mxCell id="f811" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="280" as="sourcePoint"/><mxPoint x="440" y="280" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f812" value="Also decided here: REST or event-driven? What metadata comes back? Pause for agreement: that pause is the buy-in in step 2." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="820" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
