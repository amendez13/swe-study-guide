<mxCell id="f54" value="2^10 ≈ ~1 KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="28" as="geometry"/></mxCell>
