<mxCell id="f94" value="Availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f95" value="" style="endArrow=block;startArrow=block;endSize=5;startSize=5;html=1;strokeColor=#888888;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="192" y="115" as="sourcePoint"/><mxPoint x="398" y="115" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f96" value="CAP" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="98" width="190" height="16" as="geometry"/></mxCell>
<mxCell id="f97" value="Latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="138" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f98" value="Throughput" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="138" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f99" value="" style="endArrow=block;startArrow=block;endSize=5;startSize=5;html=1;strokeColor=#888888;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="192" y="153" as="sourcePoint"/><mxPoint x="398" y="153" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f910" value="batch vs. stream" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="136" width="190" height="16" as="geometry"/></mxCell>
<mxCell id="f911" value="Cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f912" value="Durability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="176" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f913" value="" style="endArrow=block;startArrow=block;endSize=5;startSize=5;html=1;strokeColor=#888888;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="192" y="191" as="sourcePoint"/><mxPoint x="398" y="191" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f914" value="replication factor" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="174" width="190" height="16" as="geometry"/></mxCell>
<mxCell id="f915" value="Read latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f916" value="Write latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="214" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f917" value="" style="endArrow=block;startArrow=block;endSize=5;startSize=5;html=1;strokeColor=#888888;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="192" y="229" as="sourcePoint"/><mxPoint x="398" y="229" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f918" value="fan-out on write vs. read" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="212" width="190" height="16" as="geometry"/></mxCell>
<mxCell id="f919" value="Simplicity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f920" value="Scalability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="252" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f921" value="" style="endArrow=block;startArrow=block;endSize=5;startSize=5;html=1;strokeColor=#888888;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="192" y="267" as="sourcePoint"/><mxPoint x="398" y="267" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f922" value="monolith vs. microservices" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="250" width="190" height="16" as="geometry"/></mxCell>
<mxCell id="f923" value="Accuracy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f924" value="Freshness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="f925" value="" style="endArrow=block;startArrow=block;endSize=5;startSize=5;html=1;strokeColor=#888888;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="192" y="305" as="sourcePoint"/><mxPoint x="398" y="305" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="f926" value="cache TTL, eventual consistency" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="288" width="190" height="16" as="geometry"/></mxCell>
<mxCell id="f927" value="Example: say the trade out loud for the news feed" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="f928" value="normal user posts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="f929" value="fan-out on write: push into each follower&#x27;s feed → fast reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="366" width="540" height="34" as="geometry"/></mxCell>
<mxCell id="f930" value="few followers" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f928" target="f929"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f931" value="celebrity posts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="f932" value="fan-out on read: store once, followers merge it at read time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="414" width="540" height="34" as="geometry"/></mxCell>
<mxCell id="f933" value="millions of followers" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f931" target="f932"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="deepdive" name="Choosing the Deep-Dive Focus">
    <mxGraphModel dx="900" dy="392" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="392" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="f101" value="Choosing the Deep-Dive Focus" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="f102" value="Pick one hard area from the requirements and the estimate, say the choice, and say what stays high-level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="f103" value="&lt;b&gt;Data model&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;when the product is the schema&lt;br&gt;&lt;i&gt;e.g. permissions, bookings, a feed&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="197" height="90" as="geometry"/></mxCell>
<mxCell id="f104" value="&lt;b&gt;Hot path&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;when one key, region, or fan-out dominates&lt;br&gt;&lt;i&gt;e.g. an on-sale show id&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="247" y="100" width="197" height="90" as="geometry"/></mxCell>
<mxCell id="f105" value="&lt;b&gt;Consistency &amp; replication&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;when a stale or lost write is the failure&lt;br&gt;&lt;i&gt;e.g. inventory, payments, a ledger&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="454" y="100" width="197" height="90" as="geometry"/></mxCell>
<mxCell id="f106" value="&lt;b&gt;The algorithm&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;when ranking, matching, or ids are what users notice&lt;br&gt;&lt;i&gt;e.g. search ranking, id generation&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="661" y="100" width="197" height="90" as="geometry"/></mxCell>
<mxCell id="f107" value="If this part stays naive,&lt;br&gt;does the design miss an&lt;br&gt;agreed requirement?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="204" width="320" height="96" as="geometry"/></mxCell>
<mxCell id="f108" value="Deep-dive it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="232" width="180" height="40" as="geometry"/></mxCell>
<mxCell id="f109" value="Leave it on the high-level sketch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="200" height="40" as="geometry"/></mxCell>
<mxCell id="f1010" value="yes" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="f107" target="f108"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f1011" value="no" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="f107" target="f109"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="f1012" value="Also follow the interviewer: asked twice about the same box → go there." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="f1013" value="“Steady reads are fine. The on-sale show id is the hotspot, so I will deep-dive the waiting room and leave profile edits on the ordinary path.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="wrapup" name="The Wrap-Up Checklist">
    <mxGraphModel dx="900" dy="334" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="334" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="f111" value="The Wrap-Up Checklist" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="f112" value="Reserve the last 3–5 minutes. Find your own design&#x27;s weaknesses before the interviewer does" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="f113" value="&lt;b&gt;☐ Single points of failure&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;what happens if this component goes down?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="265" height="70" as="geometry"/></mxCell>
<mxCell id="f114" value="&lt;b&gt;☐ Bottlenecks&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;where does it break first under 10× load?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="104" width="265" height="70" as="geometry"/></mxCell>
<mxCell id="f115" value="&lt;b&gt;☐ Monitoring&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;which metrics would you alert on?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="104" width="265" height="70" as="geometry"/></mxCell>
<mxCell id="f116" value="&lt;b&gt;☐ Security&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;authentication, authorization, encryption?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="265" height="70" as="geometry"/></mxCell>
<mxCell id="f117" value="&lt;b&gt;☐ Cost&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;is anything needlessly expensive at scale?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="190" width="265" height="70" as="geometry"/></mxCell>
<mxCell id="f118" value="&lt;b&gt;☐ Extensions&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;how would feature X fit without a redesign?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="190" width="265" height="70" as="geometry"/></mxCell>
<mxCell id="f119" value="Naming a weakness yourself is stronger than having the interviewer find it. Finish this list even when the deep dive is still interesting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="820" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
