<mxCell id="f128" value="&lt;b&gt;Step 1 · 3–5 min&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;restate the product, in / out, agree scale and guarantees before any boxes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;fontStyle=1;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="197" height="92" as="geometry"/></mxCell>
<mxCell id="f129" value="&lt;b&gt;Step 2 · 10–15 min&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;main components, data flow, API shape; pause until the picture is agreed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;fontStyle=1;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="247" y="196" width="197" height="92" as="geometry"/></mxCell>
<mxCell id="f130" value="&lt;b&gt;Step 3 · 15–20 min&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the one or two parts that are actually hard&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;fontStyle=1;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="454" y="196" width="197" height="92" as="geometry"/></mxCell>
<mxCell id="f131" value="&lt;b&gt;Step 4 · 3–5 min&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;bottlenecks, failures, what you would measure, one extension&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;fontStyle=1;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="661" y="196" width="197" height="92" as="geometry"/></mxCell>
<mxCell id="f132" value="✗ Drawing boxes before step 1 is the usual miss. The grade is: can you bound the problem, then go deep on the part that matters?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="820" height="36" as="geometry"/></mxCell>
