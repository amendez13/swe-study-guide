<mxCell id="s716" value="keys r–z" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="300" width="70" height="40" as="geometry"/></mxCell>
<mxCell id="s717" value="Z: split by data" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=13;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="400" width="190" height="18" as="geometry"/></mxCell>
<mxCell id="s718" value="&lt;b&gt;X-axis: clone&lt;/b&gt;&lt;br&gt;identical instances behind a load balancer&lt;br&gt;&lt;i&gt;use when one service&#x27;s CPU or connections are the ceiling&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="280" height="74" as="geometry"/></mxCell>
<mxCell id="s719" value="&lt;b&gt;Y-axis: split by function&lt;/b&gt;&lt;br&gt;separate services for separate jobs&lt;br&gt;&lt;i&gt;use when unrelated features must scale or deploy apart&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="196" width="280" height="74" as="geometry"/></mxCell>
<mxCell id="s720" value="&lt;b&gt;Z-axis: split by data&lt;/b&gt;&lt;br&gt;same code, different keyspace subsets&lt;br&gt;&lt;i&gt;use when one dataset or write stream outgrows one node&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="282" width="280" height="74" as="geometry"/></mxCell>
<mxCell id="s721" value="Jumping to Y and Z while one cloned service would do is scaling a diagram, not the bottleneck." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="zero" name="Scaling from Zero to Millions">
    <mxGraphModel dx="900" dy="580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="s81" value="Scaling from Zero to Millions" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="s82" value="A teaching order, not a recipe: insert the stage the numbers justify, leave later boxes out on purpose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="s83" value="&lt;b&gt;1. Single server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;app + DB on one box&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s84" value="&lt;b&gt;2. Separate the database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;stop competing for one host&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ engine: database topics&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="100" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s85" value="&lt;b&gt;3. Vertical, then horizontal&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;bigger box first, then more boxes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="592" y="100" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s86" value="&lt;b&gt;4. Load balancer&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;one address, many web servers&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ Load Balancing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="592" y="186" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s87" value="&lt;b&gt;5. Database replication&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;leader writes, followers read&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ Consistency &amp; Replication&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="186" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s88" value="&lt;b&gt;6. Cache&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;repeated reads skip the DB&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ Caching&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s89" value="&lt;b&gt;7. CDN&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;static bytes near users&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ Caching / Content Distribution&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s810" value="&lt;b&gt;8. Stateless web tier&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;sessions in a shared store&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ this topic&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="272" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s811" value="&lt;b&gt;9. Multiple data centers&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;distant users, region as failure domain&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ High Availability&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="592" y="272" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s812" value="&lt;b&gt;10. Message queue&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;slow or bursty work off the request path&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ Message Queues&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="592" y="358" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s813" value="&lt;b&gt;11. Logs, metrics, automation&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;operability for all of the above&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ no topic yet: name it&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="358" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s814" value="&lt;b&gt;12. Database scaling&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;bigger primary, then partition&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px;color:#666666&#x27;&gt;→ Data Partitioning&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s815" value="&lt;b&gt;13. Millions and beyond&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;same levers at the next bottleneck&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="268" height="62" as="geometry"/></mxCell>
<mxCell id="s816" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s83" target="s84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s817" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s84" target="s85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s818" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s85" target="s86"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s819" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s86" target="s87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s820" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s87" target="s88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s821" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s88" target="s89"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s822" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s89" target="s810"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s823" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s810" target="s811"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s824" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s811" target="s812"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s825" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s812" target="s813"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s826" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s813" target="s814"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s827" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s814" target="s815"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s828" value="In an interview, say which stage the numbers justify and which boxes you are leaving out on purpose. Grey arrows show the usual order; real systems skip and reorder." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="820" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
