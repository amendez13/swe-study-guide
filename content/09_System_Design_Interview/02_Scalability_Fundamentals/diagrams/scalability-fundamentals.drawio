<mxCell id="s11" value="Vertical Scaling" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="s12" value="Make one machine bigger. Same code, higher ceiling, still one failure domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="s13" value="app host&lt;br&gt;4 cores · 8 GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="s14" value="app host&lt;br&gt;32 cores · 64 GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="s15" value="scale up" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s13" target="s14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s16" value="" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=2.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="104" as="sourcePoint"/><mxPoint x="500" y="104" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="s17" value="ceiling: the largest machine you can buy" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="s18" value="one box = one failure domain: when it stops, the product stops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="260" y="280" width="200" height="44" as="geometry"/></mxCell>
<mxCell id="s19" value="DB primary&lt;br&gt;(bigger instance)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="s110" value="replica" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="s111" value="replica" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="176" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="s112" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="s19" target="s110"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s113" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="s19" target="s111"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s114" value="replicas take reads; they do not make the primary bigger or absorb writes" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="560" y="232" width="280" height="36" as="geometry"/></mxCell>
<mxCell id="s115" value="Stop scaling up when…" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="276" width="280" height="18" as="geometry"/></mxCell>
<mxCell id="s116" value="• the next size class does not exist" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="298" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="s117" value="• cost is out of line with the load" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="318" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="s118" value="• the host may not be a single point of failure" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="338" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="s119" value="Then: more machines (horizontal), not a taller single primary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
