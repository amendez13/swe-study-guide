<mxCell id="s52" value="“We need to scale” is not a design. Name the workload numbers, then pick the stage they justify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="s53" value="&lt;b&gt;QPS&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;average and peak (human traffic ~2–5×)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="265" height="58" as="geometry"/></mxCell>
<mxCell id="s54" value="&lt;b&gt;Read/write ratio&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;100:1 and 1:1 are different systems&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="100" width="265" height="58" as="geometry"/></mxCell>
<mxCell id="s55" value="&lt;b&gt;Data volume&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;stored bytes and growth rate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="100" width="265" height="58" as="geometry"/></mxCell>
<mxCell id="s56" value="&lt;b&gt;Working set&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;the hot subset that could fit in a cache&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="265" height="58" as="geometry"/></mxCell>
<mxCell id="s57" value="&lt;b&gt;Concurrent sessions&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;anything that holds a connection open&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="170" width="265" height="58" as="geometry"/></mxCell>
<mxCell id="s58" value="&lt;b&gt;Payload size&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;1 KB API vs 2 MB upload&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="170" width="265" height="58" as="geometry"/></mxCell>
<mxCell id="s59" value="scaling_bias(read QPS, write QPS, peak factor): where the ratio points" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="820" height="18" as="geometry"/></mxCell>
