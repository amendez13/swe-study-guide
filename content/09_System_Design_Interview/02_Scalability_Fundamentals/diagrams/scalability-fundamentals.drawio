<mxCell id="s212" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s24" target="s27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s213" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s27" target="s29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s214" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s24" target="s28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s215" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s28" target="s29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s216" value="stateless web tier: any server handles any request → clone freely" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="s217" value="stateful on purpose: scale with replication and partitioning, never by cloning" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="s218" value="makes the extra servers reachable (algorithms, health checks: Load Balancing topic)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="150" y="250" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s219" value="Sticky sessions are a bridge while session bytes live in one process; the durable fix is a shared session store." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="stateless" name="Stateless vs. Stateful Services">
    <mxGraphModel dx="900" dy="398" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="398" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="s31" value="Stateless vs. Stateful Services" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="s32" value="Stateless: the request carries what the handler needs, and it forgets after. Stateful: the process is part of the record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="s33" value="request&lt;br&gt;session id · auth token · payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="s34" value="stateless handler&lt;br&gt;(any instance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="s35" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s33" target="s34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s36" value="database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="92" width="100" height="46" as="geometry"/></mxCell>
<mxCell id="s37" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="s34" target="s36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s38" value="cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="146" width="100" height="46" as="geometry"/></mxCell>
<mxCell id="s39" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="s34" target="s38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s310" value="queue" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="100" height="46" as="geometry"/></mxCell>
<mxCell id="s311" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="s34" target="s310"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s312" value="load durable state, answer,&lt;br&gt;keep nothing in the process" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="180" height="40" as="geometry"/></mxCell>
<mxCell id="s313" value="&lt;b&gt;Stateless web tier: clone it&lt;/b&gt;&lt;br&gt;HTTP APIs · render workers · upload front doors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="s314" value="&lt;b&gt;Stateful on purpose: replicate or partition it&lt;/b&gt;&lt;br&gt;databases · shared caches · WebSocket rooms · workers with a local checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="270" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="s315" value="✗ “The system is stateless” is the wrong summary. The web tier is stateless; the data tier is stateful, and built for it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
