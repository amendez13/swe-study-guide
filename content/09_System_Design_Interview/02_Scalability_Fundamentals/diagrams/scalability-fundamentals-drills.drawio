<mxCell id="t112" value="&lt;b&gt;✗ More replicas&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;replicas take reads; this load barely has any&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="104" width="380" height="54" as="geometry"/></mxCell>
<mxCell id="t113" value="&lt;b&gt;✗ Bigger primary&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;no larger instance exists&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="170" width="380" height="54" as="geometry"/></mxCell>
<mxCell id="t114" value="&lt;b&gt;✓ Partition the write keyspace&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;shard key and rebalancing: Data Partitioning topic&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="236" width="380" height="54" as="geometry"/></mxCell>
<mxCell id="t115" value="&lt;b&gt;Answer:&lt;/b&gt; No: replicas do not add write capacity, and vertical scale is used up. Partition the writes (Data Partitioning)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="820" height="40" as="geometry"/></mxCell>
