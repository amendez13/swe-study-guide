<mxCell id="t24" value="worker 1&lt;br&gt;{ }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="200" height="56" as="geometry"/></mxCell>
