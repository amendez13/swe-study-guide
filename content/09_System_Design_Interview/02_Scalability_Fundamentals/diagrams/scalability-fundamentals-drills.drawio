<mxCell id="t27" value="returns None → user looks logged out" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="282" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="t28" value="returns {user: ada}, but only for requests pinned here" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="140" width="300" height="40" as="geometry"/></mxCell>
