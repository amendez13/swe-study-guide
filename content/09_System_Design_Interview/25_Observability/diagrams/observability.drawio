<mxCell id="o512" value="unlock tier: 93 / 3,000 = 3.1% → over 1%, page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="200" width="390" height="36" as="geometry"/></mxCell>
