<mxCell id="o712" value="def&amp;nbsp;may_deploy(tests_passed,&amp;nbsp;artifact_id):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return&amp;nbsp;tests_passed&amp;nbsp;and&amp;nbsp;bool(artifact_id)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="340" height="48" as="geometry"/></mxCell>
<mxCell id="o713" value="✗ Tests only on a laptop: production is whatever someone remembered to run, and two regions can run two different memories." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="o714" value="✗ Re-running tests by hand during an incident does not replace the gate that should have failed on yesterday&#x27;s commit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="820" height="34" as="geometry"/></mxCell>
