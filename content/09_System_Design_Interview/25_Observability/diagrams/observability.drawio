<mxCell id="o514" value="def&amp;nbsp;tier_error_rate(hosts):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;requests&amp;nbsp;=&amp;nbsp;sum(h[&amp;quot;requests&amp;quot;]&amp;nbsp;for&amp;nbsp;h&amp;nbsp;in&amp;nbsp;hosts)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;errors&amp;nbsp;=&amp;nbsp;sum(h[&amp;quot;errors&amp;quot;]&amp;nbsp;for&amp;nbsp;h&amp;nbsp;in&amp;nbsp;hosts)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return&amp;nbsp;errors&amp;nbsp;/&amp;nbsp;requests&amp;nbsp;if&amp;nbsp;requests&amp;nbsp;else&amp;nbsp;0.0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="420" height="80" as="geometry"/></mxCell>
