<mxCell id="a17" value="S3 Standard: designed for eleven nines (99.999999999%) durability per year and 99.99% availability. Strong read-after-write since Dec 2020. Replacing an object rewrites the whole blob — patching 8 KB in place is block storage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="48" as="geometry"/></mxCell>
<mxCell id="a18" value="Upload product → Video Uploading and Transcoding · public photo reads in many cities → Why a CDN · bytes per year → QPS and Storage Estimate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="820" height="32" as="geometry"/></mxCell>
