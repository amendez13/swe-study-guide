<mxCell id="c26" value="New landing zones often use object storage and let Spark scan the objects. Keep HDFS when the job already has a path and the file is huge, written once, read straight through." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="820" height="40" as="geometry"/></mxCell>
