<mxCell id="c64" value="PoP São Paulo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="150" height="40" as="geometry"/></mxCell>
<mxCell id="c65" value="origin&lt;br&gt;Virginia" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="130" height="80" as="geometry"/></mxCell>
<mxCell id="c66" value="short hop" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="c63" target="c64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c67" value="every cold object: the long haul" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="c64" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c68" value="hits are local; misses still cross the continent" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="260" y="176" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c69" value="Coverage questions" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c610" value="• Where are the users, and is there a PoP in that region?" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="c611" value="• Where does a miss go, and how far is it?" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="c612" value="• Does one provider cover the region badly enough to need a second?" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="294" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="c613" value="• Is the real problem writes or private data? That is a multi-data-center design, not a CDN." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="820" height="20" as="geometry"/></mxCell>
