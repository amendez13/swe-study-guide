<mxfile host="drawio">
  <diagram id="why" name="Why a CDN">
    <mxGraphModel dx="900" dy="460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c11" value="Why a CDN" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c12" value="Caches near users that serve the same bytes again and again, so the origin does not" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c13" value="Are the bytes shared&lt;br&gt;across users?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="c14" value="Are those users spread&lt;br&gt;across regions?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="c15" value="yes" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c16" value="Is origin latency or&lt;br&gt;bandwidth the limit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="c17" value="yes" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c18" value="CDN for those bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="130" width="170" height="40" as="geometry"/></mxCell>
<mxCell id="c19" value="yes" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c110" value="no CDN yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="300" y="232" width="200" height="36" as="geometry"/></mxCell>
<mxCell id="c111" value="no" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;dashed=1;" edge="1" parent="1" source="c13" target="c110"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c112" value="no" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;dashed=1;" edge="1" parent="1" source="c14" target="c110"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c113" value="no" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;dashed=1;" edge="1" parent="1" source="c16" target="c110"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c114" value="example" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="c115" value="why it stays off the CDN" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="290" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="c116" value="where it goes" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="290" width="270" height="26" as="geometry"/></mxCell>
<mxCell id="c117" value="per-user feed, checkout total" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="c118" value="every response is unique" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="316" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="c119" value="application / origin" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="590" y="316" width="270" height="26" as="geometry"/></mxCell>
<mxCell id="c120" value="authenticated account page" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="c121" value="private to one caller" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="342" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="c122" value="application cache (Caching)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="590" y="342" width="270" height="26" as="geometry"/></mxCell>
<mxCell id="c123" value="single-region product" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="c124" value="users already sit next to the origin" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="368" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="c125" value="Redis in front of the origin" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="590" y="368" width="270" height="26" as="geometry"/></mxCell>
<mxCell id="c126" value="In an interview, “static assets on a CDN” comes after the application cache, not instead of it. Say what is shared, who is far away, and which requests the origin stops seeing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="edge" name="Edge and Origin">
    <mxGraphModel dx="900" dy="420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c21" value="Edge and Origin" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c22" value="The user talks to the edge; the edge calls the origin only when it lacks a fresh copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c23" value="Pull (the default)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c24" value="user 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="90" height="34" as="geometry"/></mxCell>
<mxCell id="c25" value="edge PoP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="130" width="130" height="34" as="geometry"/></mxCell>
<mxCell id="c26" value="origin&lt;br&gt;object storage / app" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="170" height="74" as="geometry"/></mxCell>
<mxCell id="c27" value="1 request" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c28" value="2 miss: fetch" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c29" value="users 2…n" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="90" height="34" as="geometry"/></mxCell>
<mxCell id="c210" value="hit until TTL ends" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="c29" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c211" value="3 the edge stores the copy and answers user 1. Cold objects cost nothing until someone asks: the default for a long catalog." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="c212" value="Push (a scheduled bet)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c213" value="origin" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="110" height="64" as="geometry"/></mxCell>
<mxCell id="c214" value="edge Tokyo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="268" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c215" value="edge Paris" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="304" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c216" value="edge Lima" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="340" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c217" value="edge Cairo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="376" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c218" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c213" target="c214"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c219" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c213" target="c215"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c220" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c213" target="c216"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c221" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c213" target="c217"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c222" value="uploaded before anyone asks: a premiere, a client release, a file known to be hot everywhere. You pay to fill edges that may never see a viewer." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="282" width="390" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cacheable" name="Cacheable and Dynamic">
    <mxGraphModel dx="900" dy="392" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="392" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c31" value="Cacheable and Dynamic" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c32" value="An edge may store a response only when a second user can safely receive the same bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;Store at the edge&lt;/b&gt;&lt;br&gt;images · CSS · JS · fonts · video segments · public thumbnails&lt;br&gt;GET with Cache-Control: public, or s-maxage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="400" height="74" as="geometry"/></mxCell>
<mxCell id="c34" value="&lt;b&gt;Do not store at the edge&lt;/b&gt;&lt;br&gt;depends on a cookie, Authorization, or the caller&lt;br&gt;Cache-Control: private or no-store · feed JSON · cart · balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="400" height="74" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;b&gt;Headers that pin the wrong copy&lt;/b&gt;&lt;br&gt;Vary: Cookie → almost every user is a distinct object · a cache-buster query on a static file does the same" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="820" height="46" as="geometry"/></mxCell>
<mxCell id="c36" value="A personalized page still links to shared images" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="c37" value="browser renders /account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="180" height="40" as="geometry"/></mxCell>
<mxCell id="c38" value="application&lt;br&gt;personalized HTML (private)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="220" height="44" as="geometry"/></mxCell>
<mxCell id="c39" value="edge&lt;br&gt;/img/logo.png, /img/p123.webp (public)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="220" height="44" as="geometry"/></mxCell>
<mxCell id="c310" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c311" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c312" value="Mixing the two in one cached response is how a private page gets served to the next visitor." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="580" y="280" width="280" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ttl" name="CDN TTL">
    <mxGraphModel dx="900" dy="436" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="436" math="0" shadow="0">
