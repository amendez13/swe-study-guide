<mxCell id="v62" value="1,000,000 viewers × 10 minutes, edge price $0.02/GB: 5 Mbps vs 1 Mbps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
