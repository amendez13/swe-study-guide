<mxCell id="v22" value="100,000 hot objects on 40 edges; each edge refreshes once per TTL. Edges see 80,000 requests/s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="v23" value="origin fetches per second (log scale)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="16" as="geometry"/></mxCell>
<mxCell id="v24" value="1 h TTL, no shield" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="170" height="32" as="geometry"/></mxCell>
<mxCell id="v25" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="118" width="208.35790505563241" height="32" as="geometry"/></mxCell>
<mxCell id="v26" value="≈ 1,111 /s  (100,000 × 40 / 3,600)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="436.3579050556324" y="118" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="v27" value="1 min TTL, no shield" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="170" height="32" as="geometry"/></mxCell>
<mxCell id="v28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="160" width="329.9998514516298" height="32" as="geometry"/></mxCell>
<mxCell id="v29" value="≈ 66,667 /s  (60× more)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="557.9998514516299" y="160" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="v210" value="1 h TTL + shield" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="170" height="32" as="geometry"/></mxCell>
<mxCell id="v211" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="202" width="98.76222496585243" height="32" as="geometry"/></mxCell>
<mxCell id="v212" value="≈ 28 /s  (40 copies → 1)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="326.7622249658524" y="202" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="v213" value="hit ratio at 1 h, no shield: 1 − 1,111 / 80,000 = 0.986" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="v214" value="Cutting TTL 60× multiplies origin load 60×. The shield is the other lever, and it does not change the TTL users see." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="v215" value="&lt;b&gt;Answer:&lt;/b&gt; ≈ 1,111/s at 1 h, ≈ 66,667/s at 1 min, ≈ 28/s at 1 h with a shield. Hit ratio ≈ 0.986." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
