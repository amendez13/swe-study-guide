<mxCell id="v52" value="200M requests × 80 KB = 16,000 GB. 92% from the edge at $0.01/GB, 8% from the origin at $0.05/GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="v53" value="with the CDN" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="40" as="geometry"/></mxCell>
<mxCell id="v54" value="edge $147.20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="110.40000000000002" height="40" as="geometry"/></mxCell>
<mxCell id="v55" value="origin $64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310.40000000000003" y="120" width="48.0" height="40" as="geometry"/></mxCell>
<mxCell id="v56" value="= $211.20" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="366.4" y="120" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="v57" value="all from origin" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="150" height="40" as="geometry"/></mxCell>
<mxCell id="v58" value="16,000 GB × $0.05 = $800" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="176" width="600" height="40" as="geometry"/></mxCell>
<mxCell id="v59" value="The 92% hit ratio is doing the saving. Raising it further is a TTL and hot-set choice, not a copy of the cold images on every PoP." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="v510" value="&lt;b&gt;Answer:&lt;/b&gt; $211.20 for the day ($147.20 edge + $64.00 origin), against $800 if every byte came from the origin." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rendition" name="A smaller rendition">
