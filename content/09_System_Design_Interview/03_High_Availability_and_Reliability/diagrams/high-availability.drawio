<mxCell id="h415" value="cost: moderate: idle but running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="248" width="265" height="30" as="geometry"/></mxCell>
<mxCell id="h416" value="usual interview sweet spot (with automated failover)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="284" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="h417" value="Hot standby" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="98" width="265" height="18" as="geometry"/></mxCell>
