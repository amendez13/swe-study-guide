<mxCell id="h71" value="SLA, SLO, and SLI" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h72" value="Reliability turned into numbers: what you measure, what you aim for, and what you promise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h73" value="SLI: the measurement&lt;br&gt;p99 latency over 5 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="64" as="geometry"/></mxCell>
<mxCell id="h74" value="SLO: the internal target&lt;br&gt;p99 &lt; 200 ms in 99.9% of windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="110" width="250" height="64" as="geometry"/></mxCell>
<mxCell id="h75" value="SLA: the contract&lt;br&gt;&lt; 99.95% in a month → 10% credit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="110" width="250" height="64" as="geometry"/></mxCell>
