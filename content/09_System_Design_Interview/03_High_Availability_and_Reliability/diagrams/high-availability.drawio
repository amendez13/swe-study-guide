<mxCell id="h91" value="Circuit Breaker Pattern" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h92" value="When failures cross a threshold, stop calling the sick dependency and answer fast instead of waiting for timeouts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h93" value="CLOSED&lt;br&gt;requests flow;&lt;br&gt;failures counted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="h94" value="OPEN&lt;br&gt;reject immediately&lt;br&gt;(or return fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="h95" value="HALF-OPEN&lt;br&gt;a few test requests&lt;br&gt;go through" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="h96" value="failure threshold exceeded" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="h93" target="h94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h97" value="timeout expires" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="h94" target="h95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
