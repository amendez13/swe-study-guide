<mxCell id="h42" value="How the backup takes over: a trade-off between recovery speed, cost, and data-loss risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h43" value="Cold standby" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="265" height="18" as="geometry"/></mxCell>
<mxCell id="h44" value="primary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="122" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="h45" value="backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="185" y="122" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="h46" value="off: spun up on failure" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="h47" value="recovery: minutes to hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="265" height="30" as="geometry"/></mxCell>
<mxCell id="h48" value="cost: low: nothing idle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="265" height="30" as="geometry"/></mxCell>
<mxCell id="h49" value="slow; possible data loss" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="h410" value="Warm standby" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="98" width="265" height="18" as="geometry"/></mxCell>
<mxCell id="h411" value="primary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="337" y="122" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="h412" value="backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="462" y="122" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="h413" value="running, receives replicated data, not serving" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="317" y="170" width="265" height="34" as="geometry"/></mxCell>
