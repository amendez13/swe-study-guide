<mxCell id="h715" value="“Given 99.99% and a region-level failure, we need two sites, automated traffic shift, and a written rule for which calls fail closed during the shift.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="820" height="40" as="geometry"/></mxCell>
