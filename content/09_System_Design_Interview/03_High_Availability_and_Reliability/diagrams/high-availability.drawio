<mxCell id="h78" value="measured → targeted internally → promised to customers with consequences" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="h79" value="The SLO drives the architecture" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="400" height="18" as="geometry"/></mxCell>
