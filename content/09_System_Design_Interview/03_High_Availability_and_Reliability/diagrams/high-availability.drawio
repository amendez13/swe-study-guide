<mxCell id="h910" value="Without a breaker" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="400" height="18" as="geometry"/></mxCell>
