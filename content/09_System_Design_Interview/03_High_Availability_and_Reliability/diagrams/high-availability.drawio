<mxCell id="h419" value="backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="739" y="122" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="h420" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="714" y="142" as="sourcePoint"/><mxPoint x="739" y="142" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="h421" value="running and serving, identical state" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="594" y="170" width="265" height="34" as="geometry"/></mxCell>
<mxCell id="h422" value="recovery: near-instant: already active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="212" width="265" height="30" as="geometry"/></mxCell>
