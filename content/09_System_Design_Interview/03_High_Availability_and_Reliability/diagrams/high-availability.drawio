  <diagram id="aavsap" name="Active-Active vs. Active-Passive">
    <mxGraphModel dx="900" dy="408" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="408" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h51" value="Active-Active vs. Active-Passive" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h52" value="Two ways to run redundant copies. Databases default to active-passive; stateless app servers to active-active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h53" value="Active-passive" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="390" height="18" as="geometry"/></mxCell>
<mxCell id="h54" value="traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="124" width="110" height="32" as="geometry"/></mxCell>
<mxCell id="h55" value="instance A&lt;br&gt;serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="196" width="140" height="44" as="geometry"/></mxCell>
<mxCell id="h56" value="instance B&lt;br&gt;waiting (standby)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="260" y="196" width="140" height="44" as="geometry"/></mxCell>
<mxCell id="h57" value="100%" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h54" target="h55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h58" value="0%" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="h54" target="h56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h59" value="+ simpler: no split brain, no conflict resolution" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="390" height="20" as="geometry"/></mxCell>
<mxCell id="h510" value="− standby capacity sits idle" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="390" height="20" as="geometry"/></mxCell>
<mxCell id="h511" value="− failover takes nonzero time" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="390" height="20" as="geometry"/></mxCell>
<mxCell id="h512" value="Active-active" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="98" width="390" height="18" as="geometry"/></mxCell>
<mxCell id="h513" value="traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="124" width="110" height="32" as="geometry"/></mxCell>
<mxCell id="h514" value="instance A&lt;br&gt;serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="196" width="140" height="44" as="geometry"/></mxCell>
<mxCell id="h515" value="instance B&lt;br&gt;serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="196" width="140" height="44" as="geometry"/></mxCell>
<mxCell id="h516" value="50%" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h513" target="h514"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h517" value="50%" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h513" target="h515"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h518" value="+ better use of every instance" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="470" y="256" width="390" height="20" as="geometry"/></mxCell>
<mxCell id="h519" value="+ no failover delay: traffic is already spread" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="470" y="278" width="390" height="20" as="geometry"/></mxCell>
<mxCell id="h520" value="− concurrent writes need conflict resolution" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="390" height="20" as="geometry"/></mxCell>
<mxCell id="h521" value="− more complex to operate" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="470" y="322" width="390" height="20" as="geometry"/></mxCell>
<mxCell id="h522" value="Across data centers it is the same choice (Multi-DC and Geo Routing). Reconciling two writers stays in Consistency and Replication." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="multidc" name="Multi-DC and Geo Routing">
    <mxGraphModel dx="900" dy="506" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="506" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h61" value="Multi-DC and Geo Routing" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h62" value="A second site is another failure domain in another place. Add it for latency, disaster, or residency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h63" value="&lt;b&gt;Latency&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;users far from the only site&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="265" height="48" as="geometry"/></mxCell>
<mxCell id="h64" value="&lt;b&gt;Disaster&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the whole site can go dark&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="317" y="98" width="265" height="48" as="geometry"/></mxCell>
<mxCell id="h65" value="&lt;b&gt;Residency&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;some rows must stay in a country&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="594" y="98" width="265" height="48" as="geometry"/></mxCell>
<mxCell id="h66" value="users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="90" height="36" as="geometry"/></mxCell>
<mxCell id="h67" value="geo DNS / traffic manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="190" width="190" height="36" as="geometry"/></mxCell>
<mxCell id="h68" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h66" target="h67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h69" value="site east" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="166" width="130" height="40" as="geometry"/></mxCell>
<mxCell id="h610" value="site west" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="226" width="130" height="40" as="geometry"/></mxCell>
<mxCell id="h611" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h67" target="h69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h612" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h67" target="h610"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h613" value="a cached DNS answer keeps the old site until its TTL ends; a traffic manager health-checks sites for new lookups" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="590" y="170" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="h614" value="What a write costs across sites" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="h615" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="312" width="20" height="28" as="geometry"/></mxCell>
<mxCell id="h616" value="async: returns after the local disk (5 ms); promoting the other site can lose the lag window" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="312" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="h617" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="20" height="28" as="geometry"/></mxCell>
<mxCell id="h618" value="wait for the other site: 80 ms round trip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="320" height="28" as="geometry"/></mxCell>
<mxCell id="h619" value="sync: 85 ms" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="350" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="h620" value="When the other site cannot be reached" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="h621" value="&lt;b&gt;fail closed&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;refuse: charge, reserve, transfer&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="400" height="44" as="geometry"/></mxCell>
<mxCell id="h622" value="&lt;b&gt;degraded&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;serve the local copy: catalog, recommendations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="420" width="400" height="44" as="geometry"/></mxCell>
<mxCell id="h623" value="Name which site takes the write, whether it waits for the other site, and which calls return an error instead of a stale answer." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="820" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
