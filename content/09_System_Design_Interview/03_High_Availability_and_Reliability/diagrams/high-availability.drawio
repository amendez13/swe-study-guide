<mxCell id="h427" value="Which site is serving, and what a whole site going dark does, is Multi-DC and Geo Routing." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="820" height="18" as="geometry"/></mxCell>
