<mxCell id="h711" value="99.9%, users in one region&lt;br&gt;→ a warm spare in that region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="246" width="280" height="44" as="geometry"/></mxCell>
<mxCell id="h712" value="99.99%, or must survive a region going dark&lt;br&gt;→ two sites (Multi-DC and Geo Routing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="350" height="44" as="geometry"/></mxCell>
