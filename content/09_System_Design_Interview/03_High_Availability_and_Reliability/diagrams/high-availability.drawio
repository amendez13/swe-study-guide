<mxCell id="h425" value="cheaper, slower recovery" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="346" width="300" height="16" as="geometry"/></mxCell>
