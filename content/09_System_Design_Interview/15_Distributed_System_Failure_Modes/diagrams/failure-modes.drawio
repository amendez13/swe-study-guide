<mxCell id="h12" value="bulkhead&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;status page has its own pool&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="190" width="260" height="54" as="geometry"/></mxCell>
<mxCell id="h13" value="shed&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;past the queue cap, immediate reject&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="260" height="54" as="geometry"/></mxCell>
<mxCell id="h14" value="circuit breaker&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;stop calling a failing API (HA)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="260" width="260" height="54" as="geometry"/></mxCell>
<mxCell id="h15" value="graceful degradation&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;“bookings paused” (HA)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="260" width="260" height="54" as="geometry"/></mxCell>
