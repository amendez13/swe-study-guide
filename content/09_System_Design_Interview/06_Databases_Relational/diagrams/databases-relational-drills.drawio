<mxCell id="s7103" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="824" y="142" width="14" height="14" as="geometry"/></mxCell>
<mxCell id="s7104" value="modulo 4 → 5" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="s7105" value="800 of 1,000 ids move" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="180" width="400.0" height="30" as="geometry"/></mxCell>
<mxCell id="s7106" value="move one fixed bucket" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="s7107" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="220" width="25.0" height="30" as="geometry"/></mxCell>
<mxCell id="s7108" value="50 of 1,000" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="273.0" y="220" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="s7109" value="Both are copies plus a cutover while writes continue: a read must know which side owns the id, and writing both sides forks it." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="s7110" value="&lt;b&gt;Answer:&lt;/b&gt; Modulo moves 800 of 1,000 ids; one fixed bucket moves 50." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="index" name="Index Choice">
    <mxGraphModel dx="900" dy="416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="416" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="s81" value="Index Choice" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="s82" value="The only index is (member_id, created_at). Which queries use it as the access path?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="s83" value="WHERE member_id = 42 ORDER BY created_at DESC LIMIT 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="s84" value="✓ uses it: equality, then the sort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="104" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="s85" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s83" target="s84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s86" value="WHERE created_at &gt; DATE &#x27;2024-06-01&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="s87" value="✗ created_at is not leading; an index on created_at serves it and slows every insert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="s88" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s86" target="s87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s89" value="WHERE member_id = 42 AND tool_id = 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="s810" value="~ walks member 42, filters tool_id; (member_id, tool_id) is better if that query is hot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="216" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="s811" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s89" target="s810"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s812" value="WHERE member_id &gt; 40 AND created_at = DATE &#x27;2024-06-01&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="s813" value="~ walks the member range, then filters the date (not one contiguous step)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="272" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="s814" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s812" target="s813"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s815" value="SELECT * still fetches each row, so none of these is a covering index." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="s816" value="&lt;b&gt;Answer:&lt;/b&gt; Only the member page uses it fully. The date report needs its own index; the tool and range queries walk it and filter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
