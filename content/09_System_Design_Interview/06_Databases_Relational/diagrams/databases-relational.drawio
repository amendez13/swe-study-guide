<mxCell id="r819" value="sees it after lag closes; a later read on another replica can move backward (B → C)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="352" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="r820" value="any replica, stale is fine" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="r821" value="OK for a catalog count, not for a balance they just changed" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="378" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="r822" value="Read-your-writes and never-moving-backward are different requirements: both need the primary or a per-member log position." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="820" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="failover" name="Failover and Promotion">
    <mxGraphModel dx="900" dy="528" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="528" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="r91" value="Failover and Promotion" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="r92" value="Promote a replica so writes continue. With async replication, acknowledged commits can be lost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r93" value="old primary (acked)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="r94" value="80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="640" height="30" as="geometry"/></mxCell>
<mxCell id="r95" value="replica A" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="r96" value="74" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="592" height="30" as="geometry"/></mxCell>
<mxCell id="r97" value="missing 75–80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="792" y="150" width="48" height="30" as="geometry"/></mxCell>
<mxCell id="r98" value="replica B" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="r99" value="71" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="190" width="568" height="30" as="geometry"/></mxCell>
<mxCell id="r910" value="missing 72–80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="768" y="190" width="72" height="30" as="geometry"/></mxCell>
<mxCell id="r911" value="1. fence the old primary (lease, storage token, power off)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="520" height="34" as="geometry"/></mxCell>
<mxCell id="r912" value="2. promote the replica with the most log applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="520" height="34" as="geometry"/></mxCell>
<mxCell id="r913" value="3. point the other replicas at its log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="520" height="34" as="geometry"/></mxCell>
<mxCell id="r914" value="4. clients move via proxy / VIP / DNS (old answers live out the TTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="520" height="34" as="geometry"/></mxCell>
<mxCell id="r915" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r911" target="r912"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r916" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r912" target="r913"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r917" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r913" target="r914"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r918" value="✗ moving DNS or a virtual address does not fence anyone: the old node must be unable to commit" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="r919" value="if it returns, discard commits only it has; replaying them forks the log" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="320" width="280" height="40" as="geometry"/></mxCell>
<mxCell id="r920" value="to keep acknowledged commits" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="360" height="26" as="geometry"/></mxCell>
<mxCell id="r921" value="why" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="430" width="460" height="26" as="geometry"/></mxCell>
<mxCell id="r922" value="the candidate you will promote flushes before the ack" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="360" height="26" as="geometry"/></mxCell>
<mxCell id="r923" value="waiting on replica A then promoting B still loses B&#x27;s gap" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="456" width="460" height="26" as="geometry"/></mxCell>
<mxCell id="r924" value="idempotency key on retried writes" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="360" height="26" as="geometry"/></mxCell>
<mxCell id="r925" value="a retry can repeat a write the new primary already has" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="482" width="460" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
