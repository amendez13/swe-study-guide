<mxCell id="r610" value="hot set 100 GB fits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="170" width="234.375" height="34" as="geometry"/></mxCell>
<mxCell id="r611" value="256 GB RAM" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="808.0" y="170" width="100" height="34" as="geometry"/></mxCell>
<mxCell id="r612" value="reads that miss RAM wait on disk; confirm the miss rate on the new size instead of assuming it falls in proportion" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="r613" value="limit" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="r614" value="what a bigger box does" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="266" width="540" height="26" as="geometry"/></mxCell>
<mxCell id="r615" value="working set &gt; RAM" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="r616" value="fixes it while the hot set fits the largest machine" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="292" width="540" height="26" as="geometry"/></mxCell>
<mxCell id="r617" value="one hot row, a lock, the log flush" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="r618" value="nothing: more cores still wait on the same thing" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="318" width="540" height="26" as="geometry"/></mxCell>
<mxCell id="r619" value="the largest machine" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="r620" value="a ceiling; the move often drops connections across a restart or cutover" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="344" width="540" height="26" as="geometry"/></mxCell>
<mxCell id="r621" value="read replica" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="r622" value="adds read capacity; does not speed writes; same small RAM misses the same set" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="370" width="540" height="26" as="geometry"/></mxCell>
<mxCell id="r623" value="Resize while the data and the measured write rate fit one primary; sharding is how writes and storage pass it." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="820" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
