  <diagram id="choose" name="Choosing Relational or NoSQL">
    <mxGraphModel dx="900" dy="404" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="404" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="r21" value="Choosing Relational or NoSQL" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="r22" value="Choose from the access path, not the brand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r23" value="the access path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="140" height="40" as="geometry"/></mxCell>
<mxCell id="r24" value="rows share a schema; queries join or aggregate; writes keep FKs, uniqueness, balances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="104" width="360" height="64" as="geometry"/></mxCell>
<mxCell id="r25" value="relational primary (+ replicas for reads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="114" width="220" height="44" as="geometry"/></mxCell>
<mxCell id="r26" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r23" target="r24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r27" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r24" target="r25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r28" value="shape varies per key, or the read is always one whole document, or writes outgrow one primary and cross-row transactions can go" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="184" width="360" height="64" as="geometry"/></mxCell>
<mxCell id="r29" value="NoSQL / specialized store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="194" width="220" height="44" as="geometry"/></mxCell>
<mxCell id="r210" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r23" target="r28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r211" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r28" target="r29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r212" value="the same hot row read again and again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="264" width="360" height="64" as="geometry"/></mxCell>
<mxCell id="r213" value="a cache (Caching), not a second database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="274" width="220" height="44" as="geometry"/></mxCell>
<mxCell id="r214" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r23" target="r212"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r215" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r212" target="r213"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r216" value="Sharding a relational primary is still relational, and gives up the cheap join across shards. A key-value store does not remove that trade; it starts from a path that was already one key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="acid" name="ACID Properties">
    <mxGraphModel dx="900" dy="578" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="578" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="r31" value="ACID Properties" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="r32" value="ACID describes one transaction on the node that runs it, not a promise about replicas (and not CAP&#x27;s C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r33" value="&lt;b&gt;Atomicity&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;all statements commit or none: a transfer cannot leave only the debit; the WAL undoes the rest&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="197" height="84" as="geometry"/></mxCell>
<mxCell id="r34" value="&lt;b&gt;Consistency&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;commit leaves declared constraints intact: FKs, unique keys, checks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="247" y="100" width="197" height="84" as="geometry"/></mxCell>
<mxCell id="r35" value="&lt;b&gt;Isolation&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;a level: what a transaction may see of others&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="454" y="100" width="197" height="84" as="geometry"/></mxCell>
<mxCell id="r36" value="&lt;b&gt;Durability&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;commit returns after this node&#x27;s log is on durable storage&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="661" y="100" width="197" height="84" as="geometry"/></mxCell>
<mxCell id="r37" value="level" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="r38" value="what it allows / does" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="r39" value="read committed (PostgreSQL default)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="r310" value="no uncommitted rows; a later statement can see new commits and phantoms" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="226" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="r311" value="repeatable read (SQL standard)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="r312" value="still allows phantoms" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="252" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="r313" value="PostgreSQL repeatable read" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="r314" value="snapshot isolation; a conflicting update fails → retry" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="278" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="r315" value="InnoDB repeatable read" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="304" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="r316" value="next-key locks block the usual phantom on locking reads" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="304" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="r317" value="serializable" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="r318" value="matches some serial order; may abort one side → retry" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="r319" value="Lost update under read committed" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="400" height="18" as="geometry"/></mxCell>
