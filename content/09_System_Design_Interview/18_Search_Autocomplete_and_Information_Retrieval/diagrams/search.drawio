<mxCell id="f12" value="Hashing the whole string can split “ni” from “night sky”. Generic placement, moving shards, salting → Data Partitioning." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="820" height="32" as="geometry"/></mxCell>
