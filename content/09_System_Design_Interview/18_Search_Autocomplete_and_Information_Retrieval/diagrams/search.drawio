<mxCell id="e6" value="“night mode” 12 → 50: re-sort top 5 on n, ni, … (morning can wait; evening patches now)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="166" width="680" height="44" as="geometry"/></mxCell>
<mxCell id="e7" value="delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="120" height="44" as="geometry"/></mxCell>
<mxCell id="e8" value="banned: unlink terminal, prune empty nodes, strip from every ancestor list" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="222" width="680" height="44" as="geometry"/></mxCell>
<mxCell id="e9" value="count set to 0, lists left in place" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=13;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="400" height="20" as="geometry"/></mxCell>
<mxCell id="e10" value="“n”: night sky · nintendo" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="280" height="32" as="geometry"/></mxCell>
<mxCell id="e11" value="“ni”: night sky · nintendo" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="318" width="280" height="32" as="geometry"/></mxCell>
<mxCell id="e12" value="still suggests “nintendo”" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="318" width="220" height="32" as="geometry"/></mxCell>
<mxCell id="e13" value="The nightly rebuild is the consistent picture: every list comes from the same counts. A patch must rewrite every list that stored the string." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
