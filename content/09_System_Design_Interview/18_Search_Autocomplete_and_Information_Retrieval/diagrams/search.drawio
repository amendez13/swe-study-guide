<mxCell id="f3" value="host a–m&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;“maps”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="f4" value="host n–z&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;“ni”, “night sky”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="f5" value="30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="240" height="30" as="geometry"/></mxCell>
