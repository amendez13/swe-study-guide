<mxCell id="f7" value="host n–z is the hot spot: CPU and trie memory" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="500" height="18" as="geometry"/></mxCell>
<mxCell id="f8" value="next cut: lengthen the prefix, keep descendants together" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="600" height="20" as="geometry"/></mxCell>
<mxCell id="f9" value="na – nh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="150" height="40" as="geometry"/></mxCell>
