  <diagram id="cr1" name="CAP Theorem">
    <mxGraphModel dx="900" dy="505" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="505" math="0" shadow="0">
