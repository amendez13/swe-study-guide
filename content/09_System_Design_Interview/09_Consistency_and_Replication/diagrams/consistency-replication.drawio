<mxCell id="a1" value="CAP Theorem" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a2" value="During a partition a request can keep copies from diverging, or answer from the reachable copy — not both" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="a3" value="replica (side 1)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;shelf label = pot 12&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="a4" value="replica (side 2)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;shelf label = pot 9 (acked there)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a5" value="" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="100" as="sourcePoint"/><mxPoint x="450" y="230" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="a6" value="partition: messages lost" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="232" width="160" height="18" as="geometry"/></mxCell>
<mxCell id="a7" value="request on side 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="260" width="180" height="40" as="geometry"/></mxCell>
<mxCell id="a8" value="&lt;b&gt;CP&lt;/b&gt;: refuse, so the sides keep a single value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="390" height="50" as="geometry"/></mxCell>
<mxCell id="a9" value="&lt;b&gt;AP&lt;/b&gt;: answer from the reachable copy — can be older than a write the other side acked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="390" height="50" as="geometry"/></mxCell>
<mxCell id="a10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a11" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a7" target="a9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a12" value="Partition tolerance is assumed: the split belongs to the network. &lt;b&gt;CA&lt;/b&gt; = a deployment offered only while the network stays whole." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="a13" value="Per operation, not per product: refuse a second claim on a shelf label, still answer the lobby board. The no-split day is PACELC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
