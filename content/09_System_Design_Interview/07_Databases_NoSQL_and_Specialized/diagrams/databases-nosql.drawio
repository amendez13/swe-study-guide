  <diagram id="nc2" name="SQL vs NoSQL Trade-Offs">
    <mxGraphModel dx="900" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="b1" value="SQL vs NoSQL Trade-Offs" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="b2" value="A relational primary keeps cross-row truth on one node; NoSQL spreads one-key paths across machines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b3" value="Relational primary" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="b4" value="declared schema · joins&lt;br&gt;one transaction keeps constraints intact&lt;br&gt;writes land on that one primary&lt;br&gt;outgrows one machine → indexes, replicas, shards (Databases Relational)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="b5" value="node A" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="95" height="60" as="geometry"/></mxCell>
<mxCell id="b6" value="node B" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="95" height="60" as="geometry"/></mxCell>
<mxCell id="b7" value="node C" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="95" height="60" as="geometry"/></mxCell>
<mxCell id="b8" value="one key · one document · one append&lt;br&gt;record holds whatever the writer stored&lt;br&gt;spread writes across machines&lt;br&gt;a query not in the key → scan or a second store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="b9" value="Polyglot persistence: each store earns one access path" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=14;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="700" height="22" as="geometry"/></mxCell>
<mxCell id="b10" value="Tool library app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="325" width="220" height="44" as="geometry"/></mxCell>
<mxCell id="b11" value="relational&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;members, payments&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="220" height="64" as="geometry"/></mxCell>
