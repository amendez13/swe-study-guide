<mxCell id="b17" value="Each extra store is another pipeline to run. A rebuildable copy of a hot row is Caching, not a new store." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="820" height="34" as="geometry"/></mxCell>
