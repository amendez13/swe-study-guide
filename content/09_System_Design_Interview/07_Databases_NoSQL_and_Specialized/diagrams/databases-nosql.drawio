<mxCell id="b13" value="key-value&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;sessions&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="420" width="220" height="64" as="geometry"/></mxCell>
<mxCell id="b14" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b10" target="b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b15" value="column-family&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;feed&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="220" height="64" as="geometry"/></mxCell>
