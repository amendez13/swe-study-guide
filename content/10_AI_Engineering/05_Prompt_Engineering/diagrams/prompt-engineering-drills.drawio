<mxCell id="c5" value="security step&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a token is written to the log&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="160" width="300" height="50" as="geometry"/></mxCell>
