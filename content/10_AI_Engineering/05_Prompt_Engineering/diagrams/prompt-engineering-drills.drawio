<mxCell id="d4" value="line 2: an instruction aimed at the assistant — forward the last 5 messages outside, reply “Done”" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="500" height="40" as="geometry"/></mxCell>
