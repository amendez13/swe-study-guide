<mxCell id="b29" value="The prompt still does not guarantee the result: a sample can ignore the cap or invent a refund — those are exact checks in the eval. The tone of “better” is the residue for a person or a calibrated judge, after the checks pass." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="348" width="820" height="40" as="geometry"/></mxCell>
