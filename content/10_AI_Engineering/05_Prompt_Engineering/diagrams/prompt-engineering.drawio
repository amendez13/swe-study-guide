<mxCell id="g2" value="Input-output pairs that show the behavior — including the abstention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="g3" value="cover the decisions you grade" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="g4" value="refund → refund label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="380" height="30" as="geometry"/></mxCell>
<mxCell id="g5" value="shipping delay → shipping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="380" height="30" as="geometry"/></mxCell>
<mxCell id="g6" value="missing order id → ask for it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="380" height="30" as="geometry"/></mxCell>
<mxCell id="g7" value="not five paraphrases of one decision" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="g8" value="refund paraphrase 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=9;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="460" y="120" width="76" height="102" as="geometry"/></mxCell>
<mxCell id="g9" value="refund paraphrase 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=9;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="76" height="102" as="geometry"/></mxCell>
<mxCell id="g10" value="refund paraphrase 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=9;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="76" height="102" as="geometry"/></mxCell>
<mxCell id="g11" value="refund paraphrase 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=9;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="76" height="102" as="geometry"/></mxCell>
<mxCell id="g12" value="refund paraphrase 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=9;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="76" height="102" as="geometry"/></mxCell>
<mxCell id="g13" value="bias (Zhao et al., “Calibrate Before Use,” 2021)" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="g14" value="so" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="244" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="g15" value="majority label in the example set" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="g16" value="eight of one class sets the prior" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="274" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="g17" value="label of the most recent example" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="304" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="g18" value="the last example should not be the behavior you least want copied" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="304" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="g19" value="an unlabeled bad reply" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="g20" value="another demonstration of crossing the boundary" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="334" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="g21" value="return window moves 30 → 14 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="250" height="48" as="geometry"/></mxCell>
<mxCell id="g22" value="every “30” example is a bug on every call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="378" width="250" height="48" as="geometry"/></mxCell>
<mxCell id="g23" value="regenerate examples from the policy; review them with it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="378" width="250" height="48" as="geometry"/></mxCell>
<mxCell id="g24" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g21" target="g22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g25" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g22" target="g23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g26" value="Keep inputs messy like production (typos, pasted threads). A schema mask still beats an example when the failure is syntax." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="820" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pe8" name="Specifying the Output Format">
    <mxGraphModel dx="900" dy="448" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="448" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h1" value="Specifying the Output Format" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h2" value="Name a shape the consumer can parse — and prefer fields an exact check can reject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h3" value="prompt + one example ask for the shape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="52" as="geometry"/></mxCell>
<mxCell id="h4" value="JSON mode: a JSON string, not your schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="190" height="52" as="geometry"/></mxCell>
<mxCell id="h5" value="schema mask: refuses illegal tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="190" height="52" as="geometry"/></mxCell>
<mxCell id="h6" value="parser: checks the values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="100" width="190" height="52" as="geometry"/></mxCell>
<mxCell id="h7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h5" target="h6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h10" value="article: “Returns are accepted within 30 days of delivery.”" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="h11" value="returned quote field" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="h12" value="substring of the article?" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="196" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="h13" value="action" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="196" width="280" height="30" as="geometry"/></mxCell>
<mxCell id="h14" value="“within 30 days of delivery”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="h15" value="True" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="226" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="h16" value="accept" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="226" width="280" height="30" as="geometry"/></mxCell>
<mxCell id="h17" value="“all sales are final”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="h18" value="False" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="256" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="h19" value="reject the object" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="256" width="280" height="30" as="geometry"/></mxCell>
<mxCell id="h20" value="“” + “the article does not say”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="286" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="h21" value="legal empty result" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="286" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="h22" value="abstain" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="286" width="280" height="30" as="geometry"/></mxCell>
<mxCell id="h23" value="prose for a person&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;three bullets and a citation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="h24" value="fields for code&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;JSON with fixed keys, types, no preamble&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="h25" value="two formats in one call&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;email + hidden JSON can disagree → split into two calls&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="h26" value="Until you have a mask: “return only the object,” an example that is only the object, a parser that strips a fence but never accepts a second object or a wrong value. A valid object can still hold a false window." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="394" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pe9" name="Sufficient Context">
    <mxGraphModel dx="900" dy="388" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="388" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="i1" value="Sufficient Context" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="i2" value="The facts the answer may depend on — in the prompt, because the model will not fetch them" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="i3" value="a return-window answer needs" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="i4" value="the policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="158" height="34" as="geometry"/></mxCell>
<mxCell id="i5" value="the purchase date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="206" y="120" width="158" height="34" as="geometry"/></mxCell>
<mxCell id="i6" value="the product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="372" y="120" width="158" height="34" as="geometry"/></mxCell>
<mxCell id="i7" value="today&#x27;s date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="538" y="120" width="158" height="34" as="geometry"/></mxCell>
<mxCell id="i8" value="the question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="704" y="120" width="158" height="34" as="geometry"/></mxCell>
<mxCell id="i9" value="situation" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="i10" value="rule in the prompt" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="172" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="i11" value="a field is missing" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="i12" value="abstain or ask — the graded behavior, not a fluent guess" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="202" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="i13" value="two articles disagree" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="i14" value="say the precedence (newer, higher policy) or hand to a person" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="232" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="i15" value="the whole help center pasted" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="i16" value="sufficient but inefficient — the relevant paragraph sinks to the middle" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="262" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="i17" value="a stale memory of the window" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="i18" value="“Today is 2026-11-12; the policy below was updated Monday”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="292" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="i19" value="“Answer only from the context; if it is not there, say you do not know” is still an instruction — measure it with a faithfulness or exact quote check. A hard abstention raises false refusals too; that is a product cost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pe10" name="Decomposing Tasks and Prompt Chains">
    <mxGraphModel dx="900" dy="408" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="408" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="j1" value="Decomposing Tasks and Prompt Chains" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="j2" value="Separate calls with a program check between them — the stop is the product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="j3" value="1 · extract order id + ask&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;abstain if id missing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="58" as="geometry"/></mxCell>
<mxCell id="j4" value="2 · decide eligibility&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;ask + policy, quote the sentence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="220" height="58" as="geometry"/></mxCell>
<mxCell id="j5" value="3 · draft the reply&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;from the decision only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="220" height="58" as="geometry"/></mxCell>
<mxCell id="j6" value="object" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j3" target="j4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="j7" value="object" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j4" target="j5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="j8" value="code stops the chain — the draft never runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="220" height="40" as="geometry"/></mxCell>
