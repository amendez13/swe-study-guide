<mxCell id="m1" value="Prompt Engineering Tools" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="m2" value="Search instructions and examples against your metric — then freeze the winner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="m3" value="APE (Zhou et al., 2022)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a model proposes and scores instructions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="196" height="74" as="geometry"/></mxCell>
<mxCell id="m4" value="OPRO (Yang et al., 2023)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the instruction is what an optimizer proposes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="96" width="196" height="74" as="geometry"/></mxCell>
<mxCell id="m5" value="DSPy (Khattab et al.)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;signatures composed into a program; BootstrapFewShot / MIPRO compile prompts + examples&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="96" width="196" height="74" as="geometry"/></mxCell>
<mxCell id="m6" value="TextGrad (2024)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a critique model writes a text “gradient”; another call rewrites — more calls, no derivative&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="664" y="96" width="196" height="74" as="geometry"/></mxCell>
<mxCell id="m7" value="two bills (exercise counts)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="m8" value="hidden search&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;200 dev rows × 50 candidates × 2 calls = 20,000 calls → $50&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="m9" value="longer compiled prompt&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;+900 input tokens on 2,000 weekly calls → $0.90 a week&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="210" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="m10" value="small feature: the search dominates · million-call feature: the longer prompt dominates" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="m11" value="search on the dev slice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="152" height="48" as="geometry"/></mxCell>
<mxCell id="m12" value="read the winning prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="207" y="298" width="152" height="48" as="geometry"/></mxCell>
<mxCell id="m13" value="score a holdout the optimizer never saw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="374" y="298" width="152" height="48" as="geometry"/></mxCell>
<mxCell id="m14" value="freeze + version the artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="541" y="298" width="152" height="48" as="geometry"/></mxCell>
<mxCell id="m15" value="serve the frozen prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708" y="298" width="152" height="48" as="geometry"/></mxCell>
<mxCell id="m16" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m11" target="m12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m17" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m12" target="m13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m18" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m13" target="m14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m19" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m14" target="m15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m20" value="A judge metric with a verbosity bias becomes a verbosity-biased optimizer. A compiler that runs on every user request is a different, far more expensive product." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="820" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pe14" name="Organizing and Versioning Prompts">
    <mxGraphModel dx="900" dy="488" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="488" math="0" shadow="0">
      <root>
