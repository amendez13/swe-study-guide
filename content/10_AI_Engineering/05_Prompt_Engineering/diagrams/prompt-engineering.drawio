<mxCell id="v21" value="escaped&amp;nbsp;=&amp;nbsp;article.replace(&amp;#x27;&amp;amp;&amp;#x27;,&amp;#x27;&amp;amp;amp;&amp;#x27;).replace(&amp;#x27;&amp;lt;&amp;#x27;,&amp;#x27;&amp;amp;lt;&amp;#x27;).replace(&amp;#x27;&amp;gt;&amp;#x27;,&amp;#x27;&amp;amp;gt;&amp;#x27;)&lt;br&gt;&amp;#x27;&amp;lt;/article&amp;gt;&amp;#x27;&amp;nbsp;in&amp;nbsp;body&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;False" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="560" height="46" as="geometry"/></mxCell>
