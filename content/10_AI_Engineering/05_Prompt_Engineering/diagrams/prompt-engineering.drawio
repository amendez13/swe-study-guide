<mxCell id="k4" value="what it is" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="96" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="k5" value="chain-of-thought (Wei et al., 2022)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="220" height="32" as="geometry"/></mxCell>
<mxCell id="k6" value="few-shot examples that show reasoning, then the answer" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="128" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="k7" value="“Let&#x27;s think step by step” (Kojima et al., 2022)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="220" height="32" as="geometry"/></mxCell>
<mxCell id="k8" value="zero-shot scratchpad — a prompt, not a spell" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="k9" value="self-consistency (Wang et al., 2022)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="220" height="32" as="geometry"/></mxCell>
<mxCell id="k10" value="several chains, majority vote on a short answer — the math is on the test-time compute card" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="192" width="600" height="32" as="geometry"/></mxCell>
