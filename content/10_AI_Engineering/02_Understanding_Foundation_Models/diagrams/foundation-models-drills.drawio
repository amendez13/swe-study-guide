<mxCell id="h11" value="cache 40 GiB → 3 GPUs" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470.84147491455076" y="164" width="200" height="32" as="geometry"/></mxCell>
