<mxCell id="j15" value="3.8 × 10²⁵ FLOPs ≈ 65× the 5.88 × 10²³ Chinchilla sketch" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="344" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="j16" value="synthetic data: Llama 3 filters generated code dialogs with a parser and unit tests. Unfiltered teacher copies import its mistakes and narrow the distribution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="260" height="110" as="geometry"/></mxCell>
