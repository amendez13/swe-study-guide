<mxCell id="l21" value="use 1: preference finetuning&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the policy is updated to earn a higher score&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="l22" value="use 2: best-of-N at serving&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;draw several replies, return the top score — no weight change&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="370" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="l23" value="Reward hacking: if longer answers win more comparisons, the policy learns to pad (flattery, confident tone too). Fix the pairs: hold length fixed, normalize by length, read the winners." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="434" width="820" height="40" as="geometry"/></mxCell>
