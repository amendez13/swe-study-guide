  </diagram>
  <diagram id="fm10" name="Scaling Bottlenecks">
    <mxGraphModel dx="900" dy="434" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="434" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="j1" value="Scaling Bottlenecks" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="j2" value="Three limits the loss curve does not contain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="j3" value="1 · Data&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;public human-written text is a finite stock (Epoch); filters shrink it; more compute = more epochs over the same pages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="260" height="96" as="geometry"/></mxCell>
<mxCell id="j4" value="2 · Power and chips&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a facilities number, not a term in 6ND&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="260" height="96" as="geometry"/></mxCell>
<mxCell id="j5" value="3 · The product metric&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a help-desk error rate sits still while the next base model&#x27;s loss falls&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="96" width="260" height="96" as="geometry"/></mxCell>
<mxCell id="j6" value="Llama 3 405B" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="206" width="160" height="26" as="geometry"/></mxCell>
