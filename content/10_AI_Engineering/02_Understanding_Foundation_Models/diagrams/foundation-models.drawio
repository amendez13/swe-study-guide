<mxCell id="e13" value="131,072 (Llama 3.1 128k)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="200" height="28" as="geometry"/></mxCell>
