<mxCell id="d54" value="Gemini 1.5 Pro is a sparse mixture-of-experts transformer. GPT-4 and Claude: rely on the left-to-right loop and documented sampling, not on an unpublished layer count. Score cost grows with the square of the sequence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="820" height="40" as="geometry"/></mxCell>
