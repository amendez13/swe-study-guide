<mxCell id="h28" value="past the training optimum — do the inference savings pay for it?" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="412" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="h29" value="Hyperparameters (width, depth, batch, learning rate, data mix) are set before learning. μP (Yang et al.): tune the learning rate on a cheap narrow model and carry it to the wide one — still measure the big run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
