<mxCell id="h24" value="under 1 token/param — a smaller model with more data buys lower loss" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="356" width="520" height="28" as="geometry"/></mxCell>
