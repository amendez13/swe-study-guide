<mxCell id="h15" value="~11× the rule — cheaper to serve" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="542.4092540945567" y="228" width="317.5907459054433" height="28" as="geometry"/></mxCell>
