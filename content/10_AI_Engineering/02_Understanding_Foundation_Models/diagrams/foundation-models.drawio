  <diagram id="fm5" name="Attention, the KV Cache, and Context">
    <mxGraphModel dx="900" dy="532" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="532" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="e1" value="Attention, the KV Cache, and Context" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="e2" value="Each new token reuses stored keys and values — the cache grows with prompt + generated tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="e3" value="scores&amp;nbsp;&amp;nbsp;=&amp;nbsp;query&amp;nbsp;·&amp;nbsp;keys&amp;nbsp;/&amp;nbsp;sqrt(head&amp;nbsp;dimension)&lt;br&gt;weights&amp;nbsp;=&amp;nbsp;softmax(scores)&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;future&amp;nbsp;positions&amp;nbsp;masked&amp;nbsp;out&lt;br&gt;output&amp;nbsp;&amp;nbsp;=&amp;nbsp;weights&amp;nbsp;·&amp;nbsp;values" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="500" height="62" as="geometry"/></mxCell>
<mxCell id="e4" value="Prefill&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;reads the prompt, writes the cache — the expensive parallel pass&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="96" width="145" height="62" as="geometry"/></mxCell>
<mxCell id="e5" value="Decode&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;one token at a time; reads the whole cache&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="715" y="96" width="145" height="62" as="geometry"/></mxCell>
<mxCell id="e6" value="Llama 2 / Llama 3 70B shape: 2 (K,V) × 80 layers × 8 KV heads × 128 head dim × 2 bytes (BF16) = 327,680 bytes = 320 KiB per token" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="174" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="e7" value="4,096 (Llama 2 context)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="28" as="geometry"/></mxCell>
