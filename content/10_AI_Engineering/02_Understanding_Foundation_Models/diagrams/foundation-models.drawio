<mxCell id="q28" value="{&quot;total&quot;: 999.0}" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="402" width="180" height="32" as="geometry"/></mxCell>
<mxCell id="q29" value="valid JSON, wrong value" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="706" y="402" width="154" height="32" as="geometry"/></mxCell>
<mxCell id="q30" value="Constrained decoding removes the illegal comma and fence. Only a parser that checks the value against the receipt stops 999.0. Finetuning is for valid JSON with systematically wrong fields — not a trailing comma." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="446" width="820" height="40" as="geometry"/></mxCell>
