<mxCell id="ab23" value="keeps the prompt-cache prefix; can unbalance the queue" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="520" height="28" as="geometry"/></mxCell>
