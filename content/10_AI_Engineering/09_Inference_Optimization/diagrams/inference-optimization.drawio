<mxCell id="z8" value="every in-flight decode sees a ~33 ms gap — a 20 ms ITL cap fails" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="619.5227704286958" y="120" width="240.47722957130418" height="32" as="geometry"/></mxCell>
