<mxCell id="e13" value="average 0.052 — the 0.090 is the stall a stream hit (ITL tail)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="248" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="e14" value="set the TPOT budget from the interaction" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="e15" value="streamed reading&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;≈ 10 tokens/s reading speed — 25 already ahead&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="e16" value="voice / captions&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;each gap is perceived — watch the tail&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="312" width="260" height="50" as="geometry"/></mxCell>
