<mxCell id="m18" value="3.76×" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="186" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="m19" value="MFU moves 0.339% → 1.31% — still a bandwidth-bound decode" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="m20" value="FP8 (Hopper)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;1-byte weights and FP8 tensor cores — bytes and the arithmetic ceiling change together&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="m21" value="weight-only INT4&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;bytes shrink; matmul runs wider after a dequant — a kernel that materializes BF16 moves the wide bytes anyway&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="254" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="m22" value="Prefill (compute-bound) may not speed up. Quantizing weights does not quantize the KV cache. The A100 has no FP8. GPTQ, AWQ, and the accuracy slice live in Finetuning — change one thing, then score the slice that failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
