<mxCell id="z4" value="4.79" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="57.53022983641792" height="32" as="geometry"/></mxCell>
