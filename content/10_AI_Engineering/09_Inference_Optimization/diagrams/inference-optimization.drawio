<mxCell id="m9" value="14.96 GiB" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="500" y="126" width="160" height="30" as="geometry"/></mxCell>
