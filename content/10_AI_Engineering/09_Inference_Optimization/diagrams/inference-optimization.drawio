<mxCell id="x13" value="per-token mask work, next to a 4.79 ms weight roof on 8B / H100 SXM5" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="232" width="620" height="28" as="geometry"/></mxCell>
