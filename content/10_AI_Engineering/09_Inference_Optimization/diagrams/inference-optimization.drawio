<mxCell id="y18" value="launches when full or a timeout fires — timeout from the TTFT budget" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="294" width="620" height="28" as="geometry"/></mxCell>
<mxCell id="y19" value="continuous (Orca, OSDI 2022)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="y20" value="leaves at the next token boundary; vLLM, TensorRT-LLM in-flight batching" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="322" width="620" height="28" as="geometry"/></mxCell>
<mxCell id="y21" value="Continuous batching does not stop a new prefill from stalling every decode in the step — chunked prefill or disaggregation (next card). Choose the batch for the latency SLO, not MFU." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="820" height="32" as="geometry"/></mxCell>
