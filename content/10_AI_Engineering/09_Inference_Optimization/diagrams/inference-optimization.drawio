<mxCell id="t50" value="Shazeer (2019) MQA; Ainslie et al. (2023) GQA; PaLM used MQA; Llama 2 GQA only at 70B. Fewer KV heads cut distinct key-value patterns; a window drops direct lookup of an older token (the clause that fell out of the window)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
