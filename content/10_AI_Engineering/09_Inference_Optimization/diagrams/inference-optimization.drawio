<mxCell id="z10" value="how" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="172" width="580" height="30" as="geometry"/></mxCell>
<mxCell id="z11" value="DistServe (Zhong et al.)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="240" height="30" as="geometry"/></mxCell>
<mxCell id="z12" value="separate prefill and decode GPUs, sized for goodput under TTFT + TPOT caps" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="202" width="580" height="30" as="geometry"/></mxCell>
