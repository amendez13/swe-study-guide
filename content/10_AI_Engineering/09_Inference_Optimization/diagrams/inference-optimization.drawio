<mxfile host="drawio">
  <diagram id="io1" name="What Inference Optimization Is">
    <mxGraphModel dx="900" dy="388" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="388" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="a1" value="What Inference Optimization Is" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a2" value="Serve a trained model inside a latency, throughput, and cost budget — at the quality you measured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="a3" value="Training&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;pays forward + backward once per experiment&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="46" as="geometry"/></mxCell>
<mxCell id="a4" value="Serving&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;pays a forward pass on every ChatGPT turn, Claude reply, Copilot suggestion&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="46" as="geometry"/></mxCell>
<mxCell id="a5" value="model half" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="a6" value="service half" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="158" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="a7" value="compress weights (quantize, prune, distill)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="182" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a8" value="draft extra tokens (speculative)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a9" value="shrink attention state (GQA, KV quant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a10" value="fuse kernels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a11" value="batch requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="182" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a12" value="separate prefill from decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="218" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a13" value="reuse a repeated prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="254" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a14" value="spread one model across accelerators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="290" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a15" value="Name the phase (prompt or generated tokens) and the budget that moved (latency, throughput under a latency cap, or dollars) before naming a library. A faster wrong total is a regression — remeasure the task slice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="io2" name="Prefill and Decode">
    <mxGraphModel dx="900" dy="398" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="398" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="b1" value="Prefill and Decode" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="b2" value="Two phases of one reply: read the prompt in parallel, then write tokens one at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b3" value="PREFILL&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;all prompt tokens together → writes the KV cache · compute-bound&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="KV cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="104" width="110" height="62" as="geometry"/></mxCell>
<mxCell id="b5" value="DECODE&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;one token per step, reads the whole cache · bandwidth-bound&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="b6" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b8" value="clock / symptom" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="b9" value="phase" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="b10" value="TTFT (“thinking” after a long paste)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="b11" value="queue + prefill" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="218" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="b12" value="the gaps after the first word" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="b13" value="decode" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="246" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="b14" value="long prompt, short answer" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="b15" value="a prefill problem" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="274" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="b16" value="short prompt, long answer" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="b17" value="a decode problem" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="302" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="b18" value="Optimizing the wrong phase: quantizing weights to fix a stall that was a 20,000-token prefill. A new prefill on a shared GPU can pause every decode in flight — the disaggregation card." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
