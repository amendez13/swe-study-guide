<mxCell id="h14" value="rising" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="220" width="240" height="32" as="geometry"/></mxCell>
<mxCell id="h15" value="the batch made it compute-bound — not a memory bug" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="520" y="220" width="340" height="32" as="geometry"/></mxCell>
<mxCell id="h16" value="Long contexts: count the KV cache bytes too (195.5 tokens/s roof at 8,192 tokens of cache). Using the weight-only 208.6 as the denominator makes MBU look worse than the pipe is. MBU places the bottleneck; it does not say whether the SLO was met." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="820" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="io9" name="What an Accelerator Is">
    <mxGraphModel dx="900" dy="418" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="418" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="i1" value="What an Accelerator Is" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="i2" value="A chip that spends its area on the same numeric operation across a large grid of values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="i3" value="CPU&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;branchy programs — tokenizer, scheduler, web server, small models&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="i4" value="GPU (H100, A100)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;thousands of lanes + tensor cores; CUDA, TensorRT-LLM, vLLM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="i5" value="TPU (v4)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;systolic array; 275 TFLOPS BF16/INT8; XLA; ridge 229 FLOPs/byte&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="96" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="i6" value="inference-oriented parts" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="i7" value="note" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="176" width="600" height="28" as="geometry"/></mxCell>
<mxCell id="i8" value="AWS Inferentia (vs Trainium for training)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="i9" value="split on purpose" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="204" width="600" height="28" as="geometry"/></mxCell>
<mxCell id="i10" value="NVIDIA L4, L40S" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="220" height="28" as="geometry"/></mxCell>
