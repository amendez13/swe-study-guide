<mxCell id="e4" value="79 × TPOT 0.040 = 3.16 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="244.0" y="104" width="537.2" height="40" as="geometry"/></mxCell>
<mxCell id="e5" value="= 4.36 s" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="787.2" y="104" width="72.79999999999995" height="40" as="geometry"/></mxCell>
