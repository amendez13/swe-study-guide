<mxCell id="d1" value="Online and Batch Inference APIs" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="d2" value="Online answers inside an interactive wait; batch trades a loose deadline for half the price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="d3" value="Online&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;ChatGPT, Claude.ai, Copilot — TTFT, TPOT, timeout are the contract&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="52" as="geometry"/></mxCell>
