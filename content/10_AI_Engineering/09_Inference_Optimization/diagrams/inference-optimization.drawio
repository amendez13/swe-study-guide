<mxCell id="z15" value="chunked prefill (Sarathi-Serve, OSDI 2024)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="240" height="30" as="geometry"/></mxCell>
<mxCell id="z16" value="one pool; cut the prompt so decode gets the GPU back inside its gap" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="262" width="580" height="30" as="geometry"/></mxCell>
<mxCell id="z17" value="The handoff is the prompt&#x27;s KV cache: 0.25 GiB for 2,048 tokens on this shape — NVLink inside a node is comfortable, slow Ethernet can replace the stall you removed. Pools idle when the mix shifts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="820" height="40" as="geometry"/></mxCell>
