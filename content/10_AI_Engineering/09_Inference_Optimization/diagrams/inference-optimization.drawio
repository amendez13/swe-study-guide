<mxCell id="m16" value="0.53125" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="186" width="160" height="30" as="geometry"/></mxCell>
