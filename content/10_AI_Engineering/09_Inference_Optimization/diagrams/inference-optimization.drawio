<mxCell id="n22" value="A 50% sparse checkpoint in any other pattern gets neither the starred peak nor a smaller HBM read. Never put the sparse peak in the MFU denominator of a dense matmul. Quantization changes width; pruning changes which values exist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="820" height="40" as="geometry"/></mxCell>
