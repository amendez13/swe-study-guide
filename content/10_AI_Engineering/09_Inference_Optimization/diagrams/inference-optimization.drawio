<mxCell id="x15" value="a draft the grammar rejects is a rejection even if the target agreed" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="620" height="28" as="geometry"/></mxCell>
