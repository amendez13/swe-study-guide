<mxCell id="ab26" value="vs data-parallel training" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="ab27" value="replicas do not all-reduce" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="346" width="520" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="io29" name="Tensor Parallelism">
    <mxGraphModel dx="900" dy="346" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="346" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="ac1" value="Tensor Parallelism" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="ac2" value="Split every layer&#x27;s matrices across GPUs; each layer ends in a collective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="ac3" value="GPU 1: half of every layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="40" as="geometry"/></mxCell>
<mxCell id="ac4" value="GPU 2: half of every layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="200" height="40" as="geometry"/></mxCell>
<mxCell id="ac5" value="collective per layer: 16 KiB activation → 0.018 µs at 900 GB/s (0.036 at half) + the latency the division omits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="ac6" value="Llama 3 70B BF16 on two 80 GiB H100 SXM5" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="ac7" value="weights 131.4 GiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="182" width="525.6" height="32" as="geometry"/></mxCell>
<mxCell id="ac8" value="spare 28.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="565.6" y="182" width="114.4" height="32" as="geometry"/></mxCell>
<mxCell id="ac9" value="one 131,072-token cache = 40 GiB — does not fit the 28.6 GiB spare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="540" height="32" as="geometry"/></mxCell>
<mxCell id="ac10" value="28.6 GiB of pure cache would hold 93,716 tokens (it is not all cache) · INT8 on one GPU leaves only 14.3 GiB" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="ac11" value="Keep the group inside a node (NVLink). Replicas would need 131.4 GiB per GPU and do not help. Pipeline parallelism avoids a collective per layer and adds a bubble; context parallelism is how a 40 GiB cache gets a home." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
