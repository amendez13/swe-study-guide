<mxCell id="ad36" value="grey = bubble · with 32 microbatches the idle fraction falls to 0.086" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="236" width="500" height="16" as="geometry"/></mxCell>
<mxCell id="ad37" value="one chat request&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;cannot supply 32 microbatches — latency is the sum of the stages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="264" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="ad38" value="saturated overnight batch&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;fills the pipe; the bubble hides&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="264" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="ad39" value="Inline suggestions want tensor parallelism; a full batch can fill a pipeline. The stage-to-stage send is a small activation; the KV cache stays with the stage that owns the layer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="820" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="io31" name="Context Parallelism and Sequence Parallelism">
    <mxGraphModel dx="900" dy="348" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="348" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="ae1" value="Context Parallelism and Sequence Parallelism" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="ae2" value="Two ways to cut a sequence — they shard different tensors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="ae3" value="Context parallelism&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;shards the sequence so attention is split; ring attention (Liu, Zaharia, Abbeel, 2023) passes KV blocks around a ring&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="ae4" value="Megatron sequence parallelism&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;shards layer-norm / dropout activations that tensor parallelism would replicate (Korthikanti et al., 2022)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="64" as="geometry"/></mxCell>
