<mxCell id="e7" value="meaning" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="164" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="e8" value="25.0 tokens/s" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="e9" value="decode rate (1 / TPOT)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="192" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="e10" value="18.35 tokens/s" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="e11" value="end-to-end, 80 / 4.36 — TTFT produces only the first token" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="520" height="28" as="geometry"/></mxCell>
