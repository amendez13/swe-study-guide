<mxCell id="ad16" value="m3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="56" height="24" as="geometry"/></mxCell>
