<mxCell id="x17" value="output tokens as usual — no mask surcharge unless the rate card says so" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="288" width="620" height="28" as="geometry"/></mxCell>
<mxCell id="x18" value="JSON mode vs schema mask vs tool call: Understanding Foundation Models. A valid {&quot;total&quot;: 12.50} can still be the wrong total — the parser stays. Measure the same prompt with and without the schema before blaming the model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="820" height="40" as="geometry"/></mxCell>
