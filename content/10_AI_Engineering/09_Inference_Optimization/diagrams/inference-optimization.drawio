<mxCell id="i12" value="Groq LPU" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="i13" value="deterministic token latency" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="260" width="600" height="28" as="geometry"/></mxCell>
<mxCell id="i14" value="MIG on H100" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="i15" value="up to seven 10 GB slices — slices the HBM too" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="288" width="600" height="28" as="geometry"/></mxCell>
<mxCell id="i16" value="three questions before any chip" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="i17" value="can it run this model?&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;memory, dtype (FP8 is Hopper, not A100), software stack&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="i18" value="how fast?&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;TTFT, TPOT, tokens/s at your real batch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="354" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="i19" value="how much?&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;$ per million tokens and power&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="354" width="260" height="50" as="geometry"/></mxCell>
