<mxCell id="f4" value="Prompt&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;changes instructions and examples in the request&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="260" height="58" as="geometry"/></mxCell>
<mxCell id="f5" value="Gmail thread summary · ChatGPT “answer in five bullets”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="260" height="40" as="geometry"/></mxCell>
