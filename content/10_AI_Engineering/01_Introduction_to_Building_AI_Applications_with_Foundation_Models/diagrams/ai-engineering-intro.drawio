  <diagram id="ai11" name="Task-Level Use Case Fit">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="k1" value="Task-Level Use Case Fit" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="k2" value="Judge the task, not the job title" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="k3" value="mostly language or unstructured input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="196" height="44" as="geometry"/></mxCell>
<mxCell id="k4" value="an approximate draft is acceptable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="96" width="196" height="44" as="geometry"/></mxCell>
<mxCell id="k5" value="a person or a program can check it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="96" width="196" height="44" as="geometry"/></mxCell>
<mxCell id="k6" value="a mistake is reversible or cheap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="664" y="96" width="196" height="44" as="geometry"/></mxCell>
<mxCell id="k7" value="signal" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="k8" value="what you see" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="158" width="360" height="40" as="geometry"/></mxCell>
<mxCell id="k9" value="familiar case" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="158" width="300" height="40" as="geometry"/></mxCell>
<mxCell id="k10" value="strong fit" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="k11" value="messy input, a draft is enough, someone reviews, quick feedback" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="198" width="360" height="40" as="geometry"/></mxCell>
<mxCell id="k12" value="Copilot, Gmail summarize, help-center draft" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="198" width="300" height="40" as="geometry"/></mxCell>
<mxCell id="k13" value="weak fit" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="k14" value="exactness, an irreversible effect, or a solved algorithm" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="238" width="360" height="40" as="geometry"/></mxCell>
<mxCell id="k15" value="payroll totals (Gusto, ADP), a card charge, Google Maps routing" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="238" width="300" height="40" as="geometry"/></mxCell>
<mxCell id="k16" value="fit with a boundary" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="k17" value="the draft is useful; a person commits the side effect" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="278" width="360" height="40" as="geometry"/></mxCell>
<mxCell id="k18" value="invoice fields a clerk approves, a refund a person confirms" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="278" width="300" height="40" as="geometry"/></mxCell>
<mxCell id="k19" value="“GPTs are GPTs” (Eloundou, Manning, Mishkin, Rock, 2023): a task is exposed if a model cuts its time ≥ 50% at the same quality" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="k20" value="≥ 10% of tasks exposed" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="k21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="374" width="288.0" height="28" as="geometry"/></mxCell>
<mxCell id="k22" value="about 80% of U.S. workers" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="596.0" y="374" width="264.0" height="28" as="geometry"/></mxCell>
<mxCell id="k23" value="&gt; 50% of tasks exposed" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="k24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="408" width="68.4" height="28" as="geometry"/></mxCell>
<mxCell id="k25" value="about 19%" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.4" y="408" width="483.6" height="28" as="geometry"/></mxCell>
<mxCell id="k26" value="Exposure is a time claim about tasks — a screen for where to look. The occupation can remain, with a person on the parts a model does badly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="820" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
