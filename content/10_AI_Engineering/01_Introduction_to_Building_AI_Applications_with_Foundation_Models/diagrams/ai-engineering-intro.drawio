<mxCell id="j30" value="Log every call with its arguments so a bad day can be replayed. A validator catches format errors, not a legitimate-looking wrong vendor — the clerk stays." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="820" height="40" as="geometry"/></mxCell>
