<mxCell id="f7" value="+ Retrieval (RAG)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;inserts facts into the request at call time&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="134" width="260" height="58" as="geometry"/></mxCell>
