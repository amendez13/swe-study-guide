<mxCell id="n8" value="agents see the draft, customers do not — first honest edit rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="372" y="148" width="150" height="96" as="geometry"/></mxCell>
