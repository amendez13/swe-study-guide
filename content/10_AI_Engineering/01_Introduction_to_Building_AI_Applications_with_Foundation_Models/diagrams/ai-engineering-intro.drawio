  <diagram id="ai4" name="Foundation Models">
    <mxGraphModel dx="900" dy="492" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="492" math="0" shadow="0">
