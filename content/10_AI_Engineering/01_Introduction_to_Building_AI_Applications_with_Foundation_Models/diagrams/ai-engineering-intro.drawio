<mxCell id="c20" value="what the free label does not give you" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="c21" value="licensed, representative, or safe-to-repeat data (curation = model development)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c22" value="instruction following — post-training, next topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c23" value="your private facts and your quality bar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c24" value="An application team usually starts from a model that has had both steps, then supplies the task, the facts, and the check on the answer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="820" height="36" as="geometry"/></mxCell>
