<mxCell id="a10" value="Application (your leverage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="a11" value="context you assemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="276" height="36" as="geometry"/></mxCell>
<mxCell id="a12" value="interface the output lands in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="324" y="208" width="276" height="36" as="geometry"/></mxCell>
<mxCell id="a13" value="checks you run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="276" height="36" as="geometry"/></mxCell>
<mxCell id="a14" value="fallback when the model is wrong" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="324" y="252" width="276" height="36" as="geometry"/></mxCell>
<mxCell id="a15" value="Foundation model API&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;OpenAI · Anthropic · Google&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="306" width="180" height="64" as="geometry"/></mxCell>
<mxCell id="a16" value="Copilot-style suggestions · Gmail summary · support draft" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="560" height="20" as="geometry"/></mxCell>
<mxCell id="a17" value="Base-model training run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="640" y="170" width="220" height="30" as="geometry"/></mxCell>
<mxCell id="a18" value="a research and infrastructure project — most teams buy it as an API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="640" y="208" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="a19" value="on the table only when a hosted model misses privacy, quality, latency, or unit cost — and you have the data and budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="296" width="220" height="104" as="geometry"/></mxCell>
<mxCell id="a20" value="you trade" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="a21" value="for" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="414" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="a22" value="a long training project" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="a23" value="a permanent evaluation and operations project" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="a24" value="fast first ship" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="a25" value="fluent false summaries · a bill per token · a model the provider can change" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="466" width="520" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ai2" name="Language Models in Product Terms">
    <mxGraphModel dx="900" dy="538" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="538" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="b1" value="Language Models in Product Terms" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="b2" value="Send a prompt; the model appends one likely piece, then another, until it stops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b3" value="Instruction:&amp;nbsp;name&amp;nbsp;the&amp;nbsp;tone&amp;nbsp;in&amp;nbsp;a&amp;nbsp;few&amp;nbsp;words,&amp;nbsp;then&amp;nbsp;stop.&lt;br&gt;Email:&amp;nbsp;&amp;quot;The&amp;nbsp;package&amp;nbsp;never&amp;nbsp;arrived&amp;nbsp;and&amp;nbsp;I&amp;nbsp;need&amp;nbsp;it&amp;nbsp;today.&amp;quot;&lt;br&gt;Tone:" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="520" height="62" as="geometry"/></mxCell>
<mxCell id="b4" value="frustrated, time-sensitive." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="104" width="260" height="44" as="geometry"/></mxCell>
<mxCell id="b5" value="completion — no separate “classifier” inside the API" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="260" height="18" as="geometry"/></mxCell>
<mxCell id="b6" value="two shapes" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="b7" value="Masked (BERT family)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;hides a span, predicts it from both sides&lt;br&gt;→ classification, tagging, embedding search&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="b8" value="Autoregressive (GPT family, chat models)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;predicts the next piece from what came before&lt;br&gt;→ ChatGPT, Claude, Gemini; email, code, answers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="204" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="b9" value="tokens: the unit of context, latency, and price" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="286" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="b10" value="The" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="90" height="30" as="geometry"/></mxCell>
<mxCell id="b11" value=" package" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="136" y="312" width="90" height="30" as="geometry"/></mxCell>
<mxCell id="b12" value=" never" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="232" y="312" width="90" height="30" as="geometry"/></mxCell>
<mxCell id="b13" value=" arrived" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="328" y="312" width="90" height="30" as="geometry"/></mxCell>
<mxCell id="b14" value="English prose ≈ 4 characters per token" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="312" width="420" height="30" as="geometry"/></mxCell>
<mxCell id="b15" value="get" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="60" height="30" as="geometry"/></mxCell>
<mxCell id="b16" value="Order" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="350" width="60" height="30" as="geometry"/></mxCell>
<mxCell id="b17" value="Status" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="172" y="350" width="60" height="30" as="geometry"/></mxCell>
<mxCell id="b18" value="By" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="238" y="350" width="60" height="30" as="geometry"/></mxCell>
<mxCell id="b19" value="Id" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="304" y="350" width="60" height="30" as="geometry"/></mxCell>
<mxCell id="b20" value="a long code identifier, rare word, or thinly covered script → many pieces" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="350" width="480" height="30" as="geometry"/></mxCell>
<mxCell id="b21" value="Copilot Chat / Cursor context" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="b22" value="what you pay for" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="398" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="b23" value="whole repository" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="b24" value="mostly irrelevant code, more latency" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="424" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="b25" value="open file + compiler error" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="b26" value="smaller and usually more useful" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="450" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="b27" value="Output tokens usually cost more than input tokens, so a rambling answer costs more than a short one. A finished-sounding sample can still be wrong." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
