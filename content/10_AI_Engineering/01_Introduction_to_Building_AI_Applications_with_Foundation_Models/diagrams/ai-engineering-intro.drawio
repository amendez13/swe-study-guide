<mxCell id="l22" value="edits a draft or takes the hard cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="306" width="280" height="52" as="geometry"/></mxCell>
