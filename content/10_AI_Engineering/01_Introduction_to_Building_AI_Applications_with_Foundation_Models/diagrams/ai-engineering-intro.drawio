  <diagram id="ai13" name="Expectations, Thresholds, and Metrics">
    <mxGraphModel dx="900" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="m1" value="Expectations, Thresholds, and Metrics" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="m2" value="A feature has to clear three bars — write them down before the demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="m3" value="1 · Quality&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;beat the user&#x27;s current alternative&lt;br&gt;(blank page vs a query the analyst can write)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="m4" value="2 · Latency&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;fit the interaction&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="m5" value="3 · Cost&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;dollars per successful task — rejected suggestions and retries are billed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="96" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="m6" value="interaction" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="m7" value="latency budget" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="184" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m8" value="example target" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="184" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m9" value="Copilot-style suggestion" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="m10" value="before the user types the line" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="212" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m11" value="inside 300 ms" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="212" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m12" value="ChatGPT turn" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="m13" value="several seconds is fine" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="240" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m14" value="user waits on a conversation" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m15" value="invoice batch" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="m16" value="minutes" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="268" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m17" value="clerk reviews later" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="268" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m18" value="what “80 percent” can mean" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="m19" value="editable drafts: 80% usable with light edits → can be a win" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="m20" value="policy-bearing replies: the same 80% → a daily pile of wrong promises" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="336" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="m21" value="track a small set tied to the task" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="600" height="18" as="geometry"/></mxCell>
