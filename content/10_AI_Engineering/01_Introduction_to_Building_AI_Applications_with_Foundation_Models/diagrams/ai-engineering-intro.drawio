<mxCell id="a5" value="judge the output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="462" y="100" width="185" height="40" as="geometry"/></mxCell>
