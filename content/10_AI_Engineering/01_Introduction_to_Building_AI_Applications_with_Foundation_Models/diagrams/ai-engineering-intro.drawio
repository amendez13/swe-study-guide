<mxCell id="o1" value="Maintenance Under a Moving Model" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="o2" value="The feature changes on days you do not deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="o3" value="what moves" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="o4" value="provider replaces weights behind a name, deprecates ids, changes prices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="380" height="34" as="geometry"/></mxCell>
<mxCell id="o5" value="a prompt tuned on one snapshot regresses on the next" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="380" height="34" as="geometry"/></mxCell>
<mxCell id="o6" value="a finetune is tied to its base model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="380" height="34" as="geometry"/></mxCell>
<mxCell id="o7" value="users drift: billing questions → screenshots and legal threats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="380" height="34" as="geometry"/></mxCell>
<mxCell id="o8" value="bill rises despite cheaper input: longer answers, retries, stuffed context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="380" height="34" as="geometry"/></mxCell>
<mxCell id="o9" value="your controls" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="o10" value="pin a model id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="120" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="o11" value="run the regression set on every model + prompt change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="162" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="o12" value="watch faithfulness/acceptance, latency percentile, $ per success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="204" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="o13" value="miss the bar → roll back to the pinned previous id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="246" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="o14" value="recompute the bill from input + output tokens; rebuild finetunes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="288" width="400" height="34" as="geometry"/></mxCell>
