<mxCell id="m23" value="edit amount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="178" y="416" width="130" height="40" as="geometry"/></mxCell>
<mxCell id="m24" value="escalation rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="416" width="130" height="40" as="geometry"/></mxCell>
<mxCell id="m25" value="policy-violation rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="454" y="416" width="130" height="40" as="geometry"/></mxCell>
<mxCell id="m26" value="latency percentile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="592" y="416" width="130" height="40" as="geometry"/></mxCell>
<mxCell id="m27" value="$ per successful task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="416" width="130" height="40" as="geometry"/></mxCell>
<mxCell id="m28" value="Refuse to launch on the harmful tail, not the average. A cheap model run three times can lose to a pricier model trusted once." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="820" height="36" as="geometry"/></mxCell>
