<mxCell id="f15" value="fails when" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="258" width="620" height="30" as="geometry"/></mxCell>
