        <mxCell id="1" parent="0"/>
<mxCell id="p221" value="When to Collect Feedback" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="p222" value="When the person can judge the thing you will change — and you will use the answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="p223" value="moment" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="p224" value="what it measures" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="540" height="28" as="geometry"/></mxCell>
<mxCell id="p225" value="Copilot suggestion on screen" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="p226" value="acceptance — the only moment it is defined" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="124" width="540" height="28" as="geometry"/></mxCell>
<mxCell id="p227" value="finished chat answer" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="p228" value="a thumb (not on the first token)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="152" width="540" height="28" as="geometry"/></mxCell>
<mxCell id="p229" value="support draft vs resolved ticket" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="p2210" value="draft usability vs outcome — different series, never add them" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="180" width="540" height="28" as="geometry"/></mxCell>
<mxCell id="p2211" value="model unsure (two receipt totals)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="p2212" value="ask the person to pick — feedback that is the product" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="208" width="540" height="28" as="geometry"/></mxCell>
<mxCell id="p2213" value="onboarding" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="p2214" value="style / tone calibration — a prior that goes stale" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="236" width="540" height="28" as="geometry"/></mxCell>
<mxCell id="p2215" value="not a feedback question&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the confirmation before a refund is the write gate; a thumb after the money moved is an eval of a mistake&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="p2216" value="sampling is timing&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a small random fraction gets the question; asking only after regenerate oversamples angry turns&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="276" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="p2217" value="When the model fails, let the person finish: inpaint one region, keep the source email under the draft, leave missed form fields editable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="820" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ar23" name="How to Collect Feedback">
    <mxGraphModel dx="900" dy="398" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="398" math="0" shadow="0">
