<mxCell id="p1814" value="DSPy" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="220" height="26" as="geometry"/></mxCell>
<mxCell id="p1815" value="compiles a prompt program against a metric" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="328" width="600" height="26" as="geometry"/></mxCell>
<mxCell id="p1816" value="Start without an orchestrator. Take a loader without taking the agent runtime; keep the tool allow-list, idempotency key, and human gate in code you own." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="820" height="32" as="geometry"/></mxCell>
