<mxCell id="p2013" value="“this is useless”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="186" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="p2014" value="negative label, no target" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="186" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="p2015" value="next-turn sentiment" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="180" height="30" as="geometry"/></mxCell>
<mxCell id="p2016" value="“this is not bad” contains “bad”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="216" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="p2017" value="a feature, not a raw label" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="216" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="p2018" value="trust signals worth counting" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="p2019" value="“are you sure?”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="286" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="p2020" value="“show the sources”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="286" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="p2021" value="a rise on one intent = a grounding failure" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="460" y="286" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="p2022" value="Log both turns with the template version and redact them. Storing only “negative” throws away the 14 days. Treating every correction as truth teaches the user&#x27;s misconception — the sycophancy loop. Slice by intent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
