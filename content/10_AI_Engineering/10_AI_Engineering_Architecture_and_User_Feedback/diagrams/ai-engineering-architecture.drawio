<mxCell id="p249" value="randomness" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="180" height="32" as="geometry"/></mxCell>
