<mxCell id="p1914" value="answers that offered the button" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="286" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="p1915" value="Neither kind is a task score: a user can accept a wrong refund and thumbs-down a correct refusal. Voters and accepters are not the traffic (Dataset Engineering). Cite a published percentage with its post and date." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="820" height="40" as="geometry"/></mxCell>
