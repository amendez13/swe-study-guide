<mxCell id="p83" value="intent routing&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;refund draft / shipping / account edit / refusal — small model, encoder, or few-shot&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="p84" value="difficulty routing (RouteLLM, Ong et al. 2024)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;cheap vs strong per prompt, trained on preference data incl. Chatbot Arena&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="52" as="geometry"/></mxCell>
