<mxCell id="p181" value="Pipeline Orchestration" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="p182" value="A function for the request path; a workflow engine for work that retries, waits, and resumes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="p183" value="request path = a function&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;retrieve → generate → check → return, while the user waits&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="p184" value="offline path = a workflow&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;reindex, nightly eval, human approval, trace backfill — Airflow, Prefect (retries, schedule, run id)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="p185" value="answer(&amp;quot;quote:&amp;nbsp;30&amp;nbsp;days&amp;quot;,&amp;nbsp;[&amp;quot;Returns&amp;nbsp;within&amp;nbsp;30&amp;nbsp;days.&amp;quot;])&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;quote:&amp;nbsp;30&amp;nbsp;days&lt;br&gt;answer(&amp;quot;quote:&amp;nbsp;90&amp;nbsp;days&amp;quot;,&amp;nbsp;[&amp;quot;Returns&amp;nbsp;within&amp;nbsp;30&amp;nbsp;days.&amp;quot;])&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;refuse" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="820" height="44" as="geometry"/></mxCell>
<mxCell id="p186" value="framework" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="220" height="26" as="geometry"/></mxCell>
<mxCell id="p187" value="sits on" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="224" width="600" height="26" as="geometry"/></mxCell>
