<mxCell id="p189" value="chains, tools, agents" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="250" width="600" height="26" as="geometry"/></mxCell>
<mxCell id="p1810" value="LlamaIndex" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="220" height="26" as="geometry"/></mxCell>
<mxCell id="p1811" value="indexes and data connectors for RAG" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="276" width="600" height="26" as="geometry"/></mxCell>
