<mxCell id="p2418" value="under all four: the people who rate are not the traffic — read a slice of silent sessions on purpose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="p2419" value="Dropping “noisy” raters can remove the minority who dislike a fluent wrong answer. A bias you do not name becomes the objective." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="820" height="30" as="geometry"/></mxCell>
