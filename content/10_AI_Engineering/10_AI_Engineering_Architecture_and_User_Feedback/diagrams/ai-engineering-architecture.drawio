<mxCell id="p2415" value="preference" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="180" height="32" as="geometry"/></mxCell>
<mxCell id="p2416" value="longer, warmer, agreeable answers" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="224" width="320" height="32" as="geometry"/></mxCell>
