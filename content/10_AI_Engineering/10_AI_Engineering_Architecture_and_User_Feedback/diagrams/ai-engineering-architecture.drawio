<mxCell id="p204" value="example" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="96" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="p205" value="use" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="96" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="p206" value="early termination" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="126" width="180" height="30" as="geometry"/></mxCell>
<mxCell id="p207" value="the stop button" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="126" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="p208" value="ambiguous alone — read the next turn" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="126" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="p209" value="error correction" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="180" height="30" as="geometry"/></mxCell>
<mxCell id="p2010" value="“no, the window is 14 days”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="156" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="p2011" value="preference-pair candidate, once you believe it" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="156" width="300" height="30" as="geometry"/></mxCell>
