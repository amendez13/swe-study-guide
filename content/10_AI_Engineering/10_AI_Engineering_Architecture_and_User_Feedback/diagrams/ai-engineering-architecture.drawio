<mxCell id="p72" value="Three different second chances — cap them so they cannot stack into an unbounded wait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="p73" value="guardrail retry&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;same task, same model — after a format or citation fail&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="p74" value="router backup&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;different model — wrong tool for the intent, or an error&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="p75" value="gateway fallback&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;different provider — timeout or a server error&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="96" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="p76" value="capped policy" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=10;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="174" width="150" height="28" as="geometry"/></mxCell>
<mxCell id="p77" value="timeout 2.000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="174" width="164" height="28" as="geometry"/></mxCell>
<mxCell id="p78" value="+.45" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="364" y="174" width="36.9" height="28" as="geometry"/></mxCell>
<mxCell id="p79" value="+.45" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400.9" y="174" width="36.9" height="28" as="geometry"/></mxCell>
<mxCell id="p710" value="timeout + healthy fallback + healthy retry = 2.900 s ✓" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="454" y="174" width="406" height="28" as="geometry"/></mxCell>
<mxCell id="p711" value="four timeouts" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=10;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="150" height="28" as="geometry"/></mxCell>
<mxCell id="p712" value="4 × timeout 2.000 = 8.000 s ✗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="210" width="656" height="28" as="geometry"/></mxCell>
<mxCell id="p713" value="" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="166" as="sourcePoint"/><mxPoint x="446" y="246" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p714" value="3.000 cap" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="406" y="246" width="80" height="14" as="geometry"/></mxCell>
<mxCell id="p715" value="Short routed call only — the 60-token buffered draft (2.425 s) does not fit the 2.000 s timeout and needs its own budget. A retried refund needs the idempotency key, or it is a second refund. Counting retries as success inflates availability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
