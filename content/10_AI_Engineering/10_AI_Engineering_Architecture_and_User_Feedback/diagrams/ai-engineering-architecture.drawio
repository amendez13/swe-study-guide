<mxCell id="p191" value="Explicit and Implicit Feedback" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="p192" value="Was the person asked? That is the boundary — the value of the signal is a different question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="p193" value="explicit (sparse, self-selected)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;ChatGPT thumb · side-by-side pick · Arena vote · Midjourney&#x27;s pick of one of four grid images&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="p194" value="implicit (plentiful, ambiguous)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;Copilot inline suggestion accepted / dismissed / cycled — accepts per suggestion shown&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="60" as="geometry"/></mxCell>
