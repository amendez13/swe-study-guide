<mxCell id="p134" value="&lt;b&gt;repeated safe question&lt;/b&gt;&lt;br&gt;response cache; model only on a miss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="96" width="660" height="42" as="geometry"/></mxCell>
