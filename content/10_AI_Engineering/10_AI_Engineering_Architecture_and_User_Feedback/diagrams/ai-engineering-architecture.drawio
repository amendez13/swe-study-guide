        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="p231" value="How to Collect Feedback" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="p232" value="Easy to ignore, specific enough to learn from, ordered so the slot does not pick the winner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="p233" value="answer A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="p234" value="answer B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="p235" value="randomize left/right, or swap and keep the win only when the same answer wins both ways; hide model names" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="420" height="60" as="geometry"/></mxCell>
<mxCell id="p236" value="GPT-4 kept its verdict after a swap on 65.0% of the similar-answer probe — a judge measurement, not a human click rate" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="p237" value="control" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p238" value="rule" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p239" value="thumb + optional reason" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p2310" value="comment box opens only after a negative thumb" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="228" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p2311" value="pairwise pick" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p2312" value="log the order shown" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="256" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p2313" value="unit" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p2314" value="the turn or suggestion id, not the whole conversation" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="284" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p2315" value="visibility" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p2316" value="private thumb ≠ public heart (Midjourney gallery) — log the audience" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="312" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p2317" value="A widget that takes over the screen measures obedience; one nobody finds measures nothing. Log unit, order, and template version with every vote." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="820" height="30" as="geometry"/></mxCell>
