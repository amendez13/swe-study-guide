<mxCell id="p197" value="Copilot acceptance" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="p198" value="suggestions shown" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="202" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="p199" value="Copilot lines accepted" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="300" height="28" as="geometry"/></mxCell>
