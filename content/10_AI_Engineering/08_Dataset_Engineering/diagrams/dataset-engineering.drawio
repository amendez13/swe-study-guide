  <diagram id="ds16" name="Limits of AI-Generated Data">
    <mxGraphModel dx="900" dy="334" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="334" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="p1" value="Limits of AI-Generated Data" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="p2" value="Five ways a large synthetic set still makes the next model worse — or unshippable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="p3" value="quality control&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;unchecked wrong rows become demonstrations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="158" height="80" as="geometry"/></mxCell>
<mxCell id="p4" value="superficial imitation&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the student copies length, opening, tone — even where wrong&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="206" y="96" width="158" height="80" as="geometry"/></mxCell>
<mxCell id="p5" value="model collapse&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;recursive training on model output erases the tails&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="372" y="96" width="158" height="80" as="geometry"/></mxCell>
<mxCell id="p6" value="lineage&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the teacher&#x27;s corpus is unknown&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="538" y="96" width="158" height="80" as="geometry"/></mxCell>
<mxCell id="p7" value="licensing&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a correct row can still violate a contract&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="704" y="96" width="158" height="80" as="geometry"/></mxCell>
<mxCell id="p8" value="Shumailov et al. (Nature 2024): recursive replacement" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="p9" value="gen 0: human data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="196" height="36" as="geometry"/></mxCell>
<mxCell id="p10" value="gen 1: trained on gen 0 output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="216" width="196" height="36" as="geometry"/></mxCell>
<mxCell id="p11" value="gen 2: trained on gen 1 output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="216" width="196" height="36" as="geometry"/></mxCell>
<mxCell id="p12" value="tails gone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="664" y="216" width="196" height="36" as="geometry"/></mxCell>
<mxCell id="p13" value="One checked synthetic slice mixed into human data you still hold is a different regime — not collapse. Superficial imitation is not LIMA&#x27;s superficial alignment hypothesis: check the answer, not the style. Human data and real interactions gain value as the web fills with model text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="820" height="52" as="geometry"/></mxCell>
