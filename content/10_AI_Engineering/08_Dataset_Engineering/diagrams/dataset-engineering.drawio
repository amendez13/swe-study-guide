<mxCell id="n21" value="QA, summarization, repository reasoning written by earlier checkpoints" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="336" width="560" height="28" as="geometry"/></mxCell>
