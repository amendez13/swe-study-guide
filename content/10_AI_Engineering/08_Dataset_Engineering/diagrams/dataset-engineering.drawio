<mxCell id="b22" value="Ask what the product must do on Tuesday, then which field of the row contains it. Final-answer-only targets are cheaper and leave out the step you meant to serve." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="32" as="geometry"/></mxCell>
