<mxCell id="i3" value="def&amp;nbsp;row(reason,&amp;nbsp;window):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;label&amp;nbsp;=&amp;nbsp;&amp;quot;review&amp;quot;&amp;nbsp;if&amp;nbsp;window&amp;nbsp;&amp;gt;=&amp;nbsp;30&amp;nbsp;else&amp;nbsp;&amp;quot;refuse&amp;quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return&amp;nbsp;{&amp;quot;prompt&amp;quot;:&amp;nbsp;f&amp;quot;The&amp;nbsp;order&amp;nbsp;{reason}.&amp;nbsp;The&amp;nbsp;posted&amp;nbsp;window&amp;nbsp;is&amp;nbsp;{window}&amp;nbsp;days.&amp;quot;,&amp;nbsp;&amp;quot;label&amp;quot;:&amp;nbsp;label}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="820" height="56" as="geometry"/></mxCell>
