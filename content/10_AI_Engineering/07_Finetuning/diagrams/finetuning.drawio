<mxCell id="g8" value="FP32 moment 2 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="160" height="36" as="geometry"/></mxCell>
<mxCell id="g9" value="= 16 B (18 B with an FP32 gradient) · serving = 2 B" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="688" y="120" width="172" height="36" as="geometry"/></mxCell>
