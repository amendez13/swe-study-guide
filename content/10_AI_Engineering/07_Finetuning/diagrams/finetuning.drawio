<mxCell id="f2" value="Retrieval puts information in the request; finetuning changes how the model reads it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="f3" value="index: the current article (permissions before the prompt)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="f4" value="model finetuned to quote the passage, abstain when absent, fill the schema, keep the tone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="f5" value="answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="112" width="180" height="40" as="geometry"/></mxCell>
