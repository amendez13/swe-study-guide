<mxCell id="d12" value="gap" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="d13" value="better tool" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="184" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d14" value="why" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="184" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d15" value="a Notion wiki, a help center, this morning&#x27;s contract" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="d16" value="retrieval" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="214" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d17" value="weights serve yesterday and cannot forget a page" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="214" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d18" value="illegal JSON" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="d19" value="schema mask + parser" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="244" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d20" value="syntax is not a behavior" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="244" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d21" value="an unscored prompt" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="d22" value="an afternoon of prompting" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="274" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d23" value="the cheaper lever is untested" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="274" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d24" value="a few dozen noisy examples" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="304" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="d25" value="more data first" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="304" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d26" value="they will be memorized" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="304" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d27" value="a label set that changes weekly" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="300" height="30" as="geometry"/></mxCell>
