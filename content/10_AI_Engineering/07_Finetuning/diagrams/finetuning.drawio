<mxCell id="q20" value="KV cache per live request — the adapter being small does not shrink it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="108" width="280" height="56" as="geometry"/></mxCell>
<mxCell id="q21" value="system" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="q22" value="what it adds" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="250" width="620" height="30" as="geometry"/></mxCell>
<mxCell id="q23" value="Punica (Chen et al., 2023)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="q24" value="segmented gather kernel: several adapters&#x27; low-rank products in one batch" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="620" height="30" as="geometry"/></mxCell>
<mxCell id="q25" value="S-LoRA (Sheng et al., 2023)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="q26" value="pages adapter weights with the KV cache; batches the low-rank work" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="310" width="620" height="30" as="geometry"/></mxCell>
<mxCell id="q27" value="vLLM multi-LoRA" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="q28" value="the server you configure — read its rank, module, and loaded-adapter limits" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="340" width="620" height="30" as="geometry"/></mxCell>
<mxCell id="q29" value="Merge when the product has one behavior (a phone with one checkpoint). Do not merge fifty tenants into one W — that erases the difference you stored them to keep. A later single-tenant merge still includes alpha / r." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
