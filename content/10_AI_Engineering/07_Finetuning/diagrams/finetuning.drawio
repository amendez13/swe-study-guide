<mxCell id="d29" value="stale the day the job finishes" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="334" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="d30" value="A finetune you cannot score is a checkpoint you cannot promote. The expensive mistake: training loss fell, on data that was the eval set, for a policy that changed on Monday." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ft5" name="Catastrophic Forgetting and Task Interference">
    <mxGraphModel dx="900" dy="404" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="404" math="0" shadow="0">
