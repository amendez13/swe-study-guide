<mxCell id="r8" value="requirement" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="164" width="320" height="32" as="geometry"/></mxCell>
