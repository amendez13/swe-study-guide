<mxCell id="k7" value="how" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="168" width="440" height="30" as="geometry"/></mxCell>
<mxCell id="k8" value="GPTQ" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="160" height="30" as="geometry"/></mxCell>
<mxCell id="k9" value="weight-only" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="198" width="220" height="30" as="geometry"/></mxCell>
<mxCell id="k10" value="block-wise rounding with a Hessian approximation compensating the rest" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="198" width="440" height="30" as="geometry"/></mxCell>
<mxCell id="k11" value="AWQ" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="160" height="30" as="geometry"/></mxCell>
<mxCell id="k12" value="weight-only" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="228" width="220" height="30" as="geometry"/></mxCell>
<mxCell id="k13" value="scale salient channels (large activations) before rounding; inverse folded in" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="228" width="440" height="30" as="geometry"/></mxCell>
<mxCell id="k14" value="bitsandbytes 4-bit" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="258" width="160" height="30" as="geometry"/></mxCell>
<mxCell id="k15" value="weight-only" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="258" width="220" height="30" as="geometry"/></mxCell>
<mxCell id="k16" value="NF4 / FP4 stored, dequantized to 16-bit for the matmul" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="258" width="440" height="30" as="geometry"/></mxCell>
<mxCell id="k17" value="LLM.int8()" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="160" height="30" as="geometry"/></mxCell>
<mxCell id="k18" value="weight + activation" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="288" width="220" height="30" as="geometry"/></mxCell>
<mxCell id="k19" value="INT8 matmul; outlier dimensions (magnitude &gt; 6) kept in 16-bit" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="288" width="440" height="30" as="geometry"/></mxCell>
<mxCell id="k20" value="SmoothQuant" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="160" height="30" as="geometry"/></mxCell>
<mxCell id="k21" value="weight + activation" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="318" width="220" height="30" as="geometry"/></mxCell>
<mxCell id="k22" value="move per-channel activation scale into the weight so both sides fit INT8" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="318" width="440" height="30" as="geometry"/></mxCell>
<mxCell id="k23" value="Calibrate on traffic-like text (Wikipedia calibration for a code product is a different rounding). Groups of 128 are common. INT4 moves arithmetic, code, and exact tokens first — score a math slice beside chat; quantize the embedding and output projection last, measure them first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="820" height="52" as="geometry"/></mxCell>
