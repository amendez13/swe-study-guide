        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="l1" value="Training Quantization" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="l2" value="Low precision inside the training step: mixed precision, QAT, or a quantized base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="l3" value="Mixed precision&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;BF16/FP16 compute, FP32 master + moments = the 16-byte row; Hopper FP8 is a different count&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="l4" value="QAT&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;fake quantizer in the forward, straight-through estimator in the backward; when PTQ misses the bar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="l5" value="QLoRA (Dettmers et al.)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;frozen NF4 base, dequantized to BF16 for the matmul; gradients only for LoRA adapters&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="96" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="l6" value="double quantization: scale overhead per parameter at block 64 (second block 256)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="182" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="l7" value="one FP32 scale per 64" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="l8" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="206" width="400.0" height="26" as="geometry"/></mxCell>
<mxCell id="l9" value="0.5 bits" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708.0" y="206" width="152.0" height="26" as="geometry"/></mxCell>
<mxCell id="l10" value="8-bit scales + FP32 per 256" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="l11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="238" width="101.56240000000001" height="26" as="geometry"/></mxCell>
<mxCell id="l12" value="0.126953 bits — saves 0.373 (≈ 3.03 GB on 65B)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="409.5624" y="238" width="450.4376" height="26" as="geometry"/></mxCell>
<mxCell id="l13" value="QLoRA paper" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="l14" value="figure" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="282" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="l15" value="measured bars (batch 1, seq 512, checkpointed)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="l16" value="≈ 6.9 / 11.3 / 24.7 / 45.0 GB for 7B / 13B / 33B / 65B" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="310" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="l17" value="headline" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="l18" value="65B finetune from &gt; 780 GB to &lt; 48 GB" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="338" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="l19" value="780 GB" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="l20" value="= 65e9 × 12 B (16-bit weights + grads, two FP32 moments, no master) — not the 16-byte row" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="366" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="l21" value="paged optimizers" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="394" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="l22" value="unified memory pages optimizer spikes to CPU RAM" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="394" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="l23" value="The 3.30 / 3.66 GiB floors on the training-memory card are packed storage, not this 780 GB comparison and not the 6.9 GB measurement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="820" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ft13" name="Parameter-Efficient Finetuning">
    <mxGraphModel dx="900" dy="334" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="334" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="m1" value="Parameter-Efficient Finetuning" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="m2" value="Train a small added or selected set; leave the pretrained weights frozen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="m3" value="avoids the 100.4 GiB full-AdamW model state of Llama 2 7B" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="m4" value="Adapter-based (inside the block)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;Houlsby bottlenecks, LoRA low-rank matrices, IA3 rescaling vectors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="m5" value="Soft-prompt (on the input)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;prompt tuning (virtual tokens at the embedding), prefix tuning (keys and values per layer)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="124" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="m6" value="transformers model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="m7" value="PEFT: freeze base, add the piece the config names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="200" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="m8" value="TRL: SFT / reward / PPO / DPO trainer on top" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="200" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="m9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m6" target="m7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m7" target="m8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m11" value="Freezing removes the base&#x27;s gradient and optimizer state — not its forward pass, and not activations where the backward still flows. Trainable parameters in every layer pay every layer&#x27;s activations; a soft prompt at the input pays a shorter path. LoRA is the default to measure, not a law." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="820" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
