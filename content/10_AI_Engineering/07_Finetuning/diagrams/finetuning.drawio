<mxCell id="p8" value="consequence" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p9" value="so" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="198" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p10" value="rank matches the intrinsic update" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p11" value="cheap to train, milder forgetting" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="226" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p12" value="rank below it" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p13" value="underfits" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="254" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p14" value="full finetune" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p15" value="can represent a high-rank change; pays 16 B on every weight" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="282" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p16" value="pretraining is a different change" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p17" value="method" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="324" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p18" value="ReLoRA (ICLR 2024)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p19" value="merge a low-rank update, start a fresh one — steps add up to higher rank" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="352" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p20" value="GaLore (ICML 2024)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="p21" value="project gradients into a periodically changing low-rank subspace" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="p22" value="“LoRA works” does not mean “the model is low-rank.” Neither ReLoRA nor GaLore is a reason to pretrain as one rank-8 LoRA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="820" height="30" as="geometry"/></mxCell>
