  <diagram id="ft1" name="What Finetuning Is">
    <mxGraphModel dx="900" dy="374" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="374" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="a1" value="What Finetuning Is" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a2" value="Continued training from weights you already have — transfer learning on a foundation model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="a3" value="New head&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;frozen body (feature extraction); cheapest; only what a head can read off&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="260" height="66" as="geometry"/></mxCell>
<mxCell id="a4" value="Parameter-efficient&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a small added piece (LoRA, adapters); base frozen&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="260" height="66" as="geometry"/></mxCell>
<mxCell id="a5" value="Full finetune&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;every weight moves; gradient + moments + master for every parameter&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="96" width="260" height="66" as="geometry"/></mxCell>
<mxCell id="a6" value="cheaper ←                                                                                                  → more change, more bytes" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="820" height="16" as="geometry"/></mxCell>
<mxCell id="a7" value="example" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="194" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="a8" value="what moved" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="194" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="a9" value="ResNet on ImageNet → smaller labeled set" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="a10" value="transfer learning before transformers" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="222" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="a11" value="BERT on a GLUE task" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="a12" value="full update of an encoder" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="a13" value="base Llama → Llama 2-Chat / Instruct" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="a14" value="later training runs on a checkpoint" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="278" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="a15" value="The demonstrations are the ceiling — mistakes included. Finetuning is the third lever, after a prompt and after retrieval; it does not absorb a document that changes tomorrow. When the base is replaced, the finetune is redone and re-evaluated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ft2" name="Finetuning Objectives">
    <mxGraphModel dx="900" dy="422" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="422" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="b1" value="Finetuning Objectives" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="b2" value="Which loss you keep training — pick by the gap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b3" value="Continued pretraining" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="190" height="64" as="geometry"/></mxCell>
<mxCell id="b4" value="loss: next-token loss on new domain text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="96" width="220" height="64" as="geometry"/></mxCell>
<mxCell id="b5" value="Code Llama from Llama 2; “Don&#x27;t Stop Pretraining” (2020)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="96" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="b6" value="use when &lt;span style=&#x27;font-weight:normal&#x27;&gt;the domain language is missing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="96" width="180" height="64" as="geometry"/></mxCell>
<mxCell id="b7" value="Supervised finetuning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="190" height="64" as="geometry"/></mxCell>
<mxCell id="b8" value="loss: prompt + answer, loss on the answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="170" width="220" height="64" as="geometry"/></mxCell>
<mxCell id="b9" value="a JSON schema, a support tone, a label set; distillation targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="170" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="b10" value="use when &lt;span style=&#x27;font-weight:normal&#x27;&gt;the model does not reply in the shape you need&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="180" height="64" as="geometry"/></mxCell>
<mxCell id="b11" value="Preference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="190" height="64" as="geometry"/></mxCell>
<mxCell id="b12" value="loss: rank answers: reward model + PPO, or DPO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="244" width="220" height="64" as="geometry"/></mxCell>
<mxCell id="b13" value="InstructGPT, Llama 2-Chat (PPO); Llama 3 (DPO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="244" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="b14" value="use when &lt;span style=&#x27;font-weight:normal&#x27;&gt;it replies, and the worse reply ranks too high&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="244" width="180" height="64" as="geometry"/></mxCell>
<mxCell id="b15" value="a missing fact that should stay in a document → retrieval, not a loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b16" value="Preference data assumes a model that already answers: if the preferred reply is far from the reference, SFT first. Running all three because the stack diagram shows them hides which loss the eval needed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ft3" name="Reasons to Finetune">
    <mxGraphModel dx="900" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c1" value="Reasons to Finetune" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c2" value="A behavior with examples, that a serious prompt does not hold, wanted on every request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c3" value="behavior&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;house style, a Zendesk label set, a field the model fills wrong, a refusal policy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="196" height="80" as="geometry"/></mxCell>
<mxCell id="c4" value="volume&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;move few-shot examples out of every request; a small model can be cheaper to serve&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="96" width="196" height="80" as="geometry"/></mxCell>
<mxCell id="c5" value="teacher&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;distill: a strong model writes demonstrations, a small model learns them&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="96" width="196" height="80" as="geometry"/></mxCell>
<mxCell id="c6" value="measured bias&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a scored failure mode on a slice — with the before-and-after&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="664" y="96" width="196" height="80" as="geometry"/></mxCell>
<mxCell id="c7" value="check" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="194" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="c8" value="so" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="194" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="c9" value="prompt tried and scored?" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="c10" value="finetune when the measured prompt stalls" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="224" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="c11" value="schema stable for a quarter?" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="c12" value="a schema that changes every sprint is a reason to wait" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="254" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="c13" value="prompt cache hitting?" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="c14" value="recompute the bill: the token reason weakens, the behavior reason stays" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="284" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="c15" value="small specialist vs big general model" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="314" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="c16" value="score both — the specialist&#x27;s existence is not the result (BloombergGPT)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="314" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="c17" value="Keep the finetune only when a held-out eval beats the prompt by enough to pay for the run and the model version you now own." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="820" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ft4" name="Reasons Not to Finetune">
    <mxGraphModel dx="900" dy="424" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="424" math="0" shadow="0">
