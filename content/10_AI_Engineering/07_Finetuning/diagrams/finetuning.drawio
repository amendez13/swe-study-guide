        <mxCell id="1" parent="0"/>
<mxCell id="r1" value="Model Merging" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="r2" value="One checkpoint from several that share an architecture — no training data read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r3" value="multi-task&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;one model keeps code and support skills&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="r4" value="on-device&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a phone holds one set of weights&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="96" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="r5" value="federated&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;FedAvg (McMahan et al.): average client updates; data never moves&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="96" width="260" height="50" as="geometry"/></mxCell>
