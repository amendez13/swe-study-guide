<mxCell id="f8" value="the training examples must contain the passage — or the gradient teaches that context is decoration" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="174" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="f9" value="gap" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="300" height="32" as="geometry"/></mxCell>
<mxCell id="f10" value="lives in" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="202" width="260" height="32" as="geometry"/></mxCell>
<mxCell id="f11" value="change" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="202" width="260" height="32" as="geometry"/></mxCell>
