    </mxGraphModel>
  </diagram>
  <diagram id="ft12" name="Training Quantization">
    <mxGraphModel dx="900" dy="478" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="478" math="0" shadow="0">
