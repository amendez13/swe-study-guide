<mxCell id="w15" value="map the constraint to the tool" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="w16" value="one GPU, 7–13B, need the weights&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;QLoRA: PEFT + TRL, Axolotl, or Unsloth&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="w17" value="full update, many GPUs&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;torchtune / FSDP — ZeRO 1 often enough at 7B, stage 3 at 70B&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="326" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="w18" value="no GPUs, no file needed, data may leave&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;hosted API&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="326" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="w19" value="A wrong chat template makes every option look trained — the loss falls while predicting the wrong wrapping. Apply the template that shipped with the base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ft24" name="Choosing a Base Model">
    <mxGraphModel dx="900" dy="406" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="406" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="x1" value="Choosing a Base Model" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="x2" value="Which checkpoint the trainer may move, at which size — and whether to distill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="x3" value="prompt the strongest model you can call, score it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="152" height="70" as="geometry"/></mxCell>
<mxCell id="x4" value="fact missing → retrieval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="207" y="100" width="152" height="70" as="geometry"/></mxCell>
<mxCell id="x5" value="behavior + demos → PEFT on the smallest base you can serve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="374" y="100" width="152" height="70" as="geometry"/></mxCell>
<mxCell id="x6" value="teacher does it → distill to a student (DistilBERT pattern)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="541" y="100" width="152" height="70" as="geometry"/></mxCell>
<mxCell id="x7" value="PEFT plateau → full FT or continued pretraining" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708" y="100" width="152" height="70" as="geometry"/></mxCell>
<mxCell id="x8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="x3" target="x4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="x9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="x4" target="x5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="x10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="x5" target="x6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="x11" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="x6" target="x7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="x12" value="decision" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="x13" value="rule" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="x14" value="license and lineage" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="x15" value="read before the GPU; a finetune inherits the base&#x27;s terms (SOLAR is Apache 2.0)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="x16" value="instruct vs base" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="x17" value="instruct keeps chat; a raw base is cleaner for a narrow label or format" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="x18" value="domain checkpoint" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="x19" value="a code labeler starts from a code model — score the specialist against a strong general model" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="x20" value="size" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="x21" value="serving form meets latency (7B BF16 = 12.6 GiB) and training form fits (full = 100.4 GiB, so QLoRA)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="310" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="x22" value="A 13B you can train and cannot serve is the wrong base. Changing the base later invalidates the eval series — pin it. A student learns the teacher only on the questions you asked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ft25" name="Finetuning Hyperparameters">
    <mxGraphModel dx="900" dy="416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="416" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="y1" value="Finetuning Hyperparameters" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="y2" value="Learning rate, batch, passes, and how much of the prompt the loss sees" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="y3" value="learning rate (starting sweeps)" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="y4" value="note" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="96" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="y5" value="full update ≈ 1e-5" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="y6" value="QLoRA paper&#x27;s full-FT baseline swept 1e-6 to 5e-5" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="124" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="y7" value="LoRA ≈ 1e-4" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="y8" value="QLoRA: constant schedule; 2e-4 for 7B/13B, 1e-4 for 33B/65B" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="152" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="y9" value="too high / too low" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="y10" value="loss diverges or NaN (FP16) / flat while weights barely move" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="y11" value="effective batch = microbatch × accumulation × GPUs — memory follows the microbatch" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="y12" value="micro 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="120" height="32" as="geometry"/></mxCell>
<mxCell id="y13" value="× accum 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="242" width="120" height="32" as="geometry"/></mxCell>
<mxCell id="y14" value="× 4 GPUs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="242" width="120" height="32" as="geometry"/></mxCell>
<mxCell id="y15" value="= 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="242" width="120" height="32" as="geometry"/></mxCell>
<mxCell id="y16" value="prompt loss weight: 100-token prompt, 20-token answer" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="y17" value="prompt 100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="314" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="y18" value="answer 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="314" width="80" height="30" as="geometry"/></mxCell>
<mxCell id="y19" value="weight 1: answer = 20 / 120 ≈ 0.167 of the loss · weight 0: the answer is the whole loss" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="530" y="314" width="330" height="30" as="geometry"/></mxCell>
<mxCell id="y20" value="Stop on the held-out loss, often after a few epochs. A longer max_seq_len without a positional (RoPE) change is not long-context training. Move one knob at a time on a frozen eval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
