<mxCell id="t126" value="each block&#x27;s output is the next block&#x27;s input: 4,096 cannot stack on 5,120" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="350" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="t127" value="Stacking two finetunes you like does not make a coherent residual stream. If you stack: train further, then evaluate each donor&#x27;s task. The deeper model costs more to serve than either donor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="820" height="40" as="geometry"/></mxCell>
