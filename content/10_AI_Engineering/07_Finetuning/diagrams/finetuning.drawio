<mxCell id="f16" value="the weights + a short instruction" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="266" width="260" height="32" as="geometry"/></mxCell>
<mxCell id="f17" value="finetune — an index cannot store a style" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="266" width="260" height="32" as="geometry"/></mxCell>
<mxCell id="f18" value="answers without using the passage" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="300" height="32" as="geometry"/></mxCell>
<mxCell id="f19" value="demonstrations + prompt" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="298" width="260" height="32" as="geometry"/></mxCell>
<mxCell id="f20" value="train on passage → answer examples" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="298" width="260" height="32" as="geometry"/></mxCell>
<mxCell id="f21" value="Ovadia et al. (EMNLP 2024): retrieval beat unsupervised finetuning for knowledge, seen facts and current events; on current events, retrieval + finetune was worse than retrieval alone. Form in the weights, facts in the index." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
