<mxCell id="r10" value="add / average aligned parameters" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="196" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="r11" value="same shape (task arithmetic: same base)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="196" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="r12" value="layer stacking" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="180" height="32" as="geometry"/></mxCell>
<mxCell id="r13" value="blocks in a deeper sequence" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="228" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="r14" value="same hidden size" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="228" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="r15" value="concatenation" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="180" height="32" as="geometry"/></mxCell>
<mxCell id="r16" value="parameters side by side — wider, or experts" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="260" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="r17" value="a projection or router to restore the width" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="260" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="r18" value="mergekit: linear, SLERP, TIES, DARE, passthrough. Different hidden sizes or vocabularies give a shape error — the better failure. A merge that loses a skill is fixed by a different merge, short training on data you have, or serving specialists as adapters. Score every skill." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="820" height="52" as="geometry"/></mxCell>
