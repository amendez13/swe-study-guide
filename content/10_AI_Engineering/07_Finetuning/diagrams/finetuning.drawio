<mxCell id="h2" value="Weights + KV cache + forward activations — Llama 2 7B (untied, 32 layers, 32 KV heads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
