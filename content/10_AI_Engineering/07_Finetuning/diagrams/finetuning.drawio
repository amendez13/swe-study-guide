        <mxCell id="1" parent="0"/>
<mxCell id="e1" value="Catastrophic Forgetting and Task Interference" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="e2" value="The new task&#x27;s loss falls while a skill you still need leaves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="e3" value="sequential training (McCloskey &amp; Cohen, 1989)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="e4" value="train task A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="100" height="52" as="geometry"/></mxCell>
<mxCell id="e5" value="train task B on the same weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="120" width="100" height="52" as="geometry"/></mxCell>
<mxCell id="e6" value="B&#x27;s loss looks perfect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="100" height="52" as="geometry"/></mxCell>
<mxCell id="e7" value="A is gone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="100" height="52" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e4" target="e5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e5" target="e6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e6" target="e7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e11" value="detection" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="96" width="370" height="18" as="geometry"/></mxCell>
<mxCell id="e12" value="held-out general eval (instruction following, a coding slice), before and after, not in the training file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="370" height="52" as="geometry"/></mxCell>
<mxCell id="e13" value="mitigations, in the order you would try them" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="e14" value="LoRA / PEFT&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;base frozen — less room to leave (not zero)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="158" height="70" as="geometry"/></mxCell>
<mxCell id="e15" value="replay / data mixing&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;general rows stay in the gradient&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="206" y="216" width="158" height="70" as="geometry"/></mxCell>
<mxCell id="e16" value="lower learning rate&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;smaller steps from the base&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="372" y="216" width="158" height="70" as="geometry"/></mxCell>
<mxCell id="e17" value="merge back toward the base&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;model soup, small task-arithmetic coefficient&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="538" y="216" width="158" height="70" as="geometry"/></mxCell>
<mxCell id="e18" value="separate adapters&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;nothing overwritten; pay a router&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="704" y="216" width="158" height="70" as="geometry"/></mxCell>
<mxCell id="e19" value="simultaneous&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;every task in the same run&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="400" height="44" as="geometry"/></mxCell>
<mxCell id="e20" value="sequential&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;one task file then the next — the schedule that forgets&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="302" width="400" height="44" as="geometry"/></mxCell>
<mxCell id="e21" value="A rising refund accuracy beside an unmeasured general-instruction drop is not a launch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
