<mxCell id="g6" value="FP32 master 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="160" height="36" as="geometry"/></mxCell>
