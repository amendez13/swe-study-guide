<mxCell id="s3" value="model soup (Wortsman et al.)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;θ = a θ_a + (1 − a) θ_b — finetunes of one task from one init&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="52" as="geometry"/></mxCell>
