<mxCell id="k1" value="Inference Quantization" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="k2" value="Rewrite a trained checkpoint into fewer bits after training (PTQ, with a calibration set)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="k3" value="Weight-only&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;weights INT8 / INT4, activations BF16; memory and bandwidth fall — decode gets faster, prefill less so&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="k4" value="Weight-and-activation&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;integer matmul on both sides — activation outlier channels are the hard part&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="k5" value="method" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="160" height="30" as="geometry"/></mxCell>
