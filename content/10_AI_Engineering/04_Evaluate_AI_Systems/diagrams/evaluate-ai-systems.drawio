<mxCell id="m4" value="Chatbot Arena → LMArena → Arena&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;pairwise human preference, a rating — context, not an accuracy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="52" as="geometry"/></mxCell>
