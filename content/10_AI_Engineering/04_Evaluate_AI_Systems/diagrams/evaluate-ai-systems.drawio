<mxCell id="e16" value="short: “Yes, we can refund shipping today.”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="e17" value="6" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="248" width="90" height="30" as="geometry"/></mxCell>
