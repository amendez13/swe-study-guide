<mxCell id="e28" value="8 variants: raw, no asterisks, drop first / last / both lines, and those three without asterisks" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="380" width="620" height="28" as="geometry"/></mxCell>
<mxCell id="e29" value="If a schema mask enforces the JSON, the format metric belongs to the decoder; grade the model on the values. “Do not promise a refund the article refuses” is your own verifiable check — it is not in IFEval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="820" height="40" as="geometry"/></mxCell>
