<mxCell id="e22" value="meaning" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="296" width="620" height="28" as="geometry"/></mxCell>
<mxCell id="e23" value="prompt-level strict" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="e24" value="every instruction on the raw text — the gate when any miss breaks the message" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="324" width="620" height="28" as="geometry"/></mxCell>
