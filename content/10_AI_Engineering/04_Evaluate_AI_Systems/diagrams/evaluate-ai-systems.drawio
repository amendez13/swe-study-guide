<mxCell id="q4" value="every decision and date appears in the transcript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="268" height="40" as="geometry"/></mxCell>
