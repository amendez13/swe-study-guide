<mxCell id="g1" value="Latency" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="g2" value="latency = TTFT + TPOT × (N − 1) — and goodput, not throughput" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="g3" value="TTFT 0.400 s&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;queue + prefill&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="100" height="54" as="geometry"/></mxCell>
<mxCell id="g4" value="499 more tokens × TPOT 0.020 s = 9.98 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="104" width="628.74" height="54" as="geometry"/></mxCell>
<mxCell id="g5" value="= 10.38 s" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="774.74" y="104" width="85.25999999999999" height="54" as="geometry"/></mxCell>
<mxCell id="g6" value="number" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="g7" value="meaning" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="176" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="g8" value="50.0 tokens/s" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="g9" value="decode rate on that stream (1 / TPOT)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="204" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="g10" value="48.17 tokens/s" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="g11" value="end-to-end: 500 / 10.38 — TTFT produces no extra tokens" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="232" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="g12" value="the user&#x27;s first visible token" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="g13" value="later than the server TTFT (network, client buffer) — name the clock" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="560" height="28" as="geometry"/></mxCell>
<mxCell id="g14" value="one second of serving, TTFT and TPOT caps" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="500" height="18" as="geometry"/></mxCell>
<mxCell id="g15" value="small batch" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="120" height="28" as="geometry"/></mxCell>
<mxCell id="g16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="170" y="326" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="g17" value="6 met" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="326" width="180" height="28" as="geometry"/></mxCell>
<mxCell id="g18" value="throughput 10 · goodput 6 · attainment 0.60" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="478" y="326" width="382" height="28" as="geometry"/></mxCell>
<mxCell id="g19" value="large batch" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="120" height="28" as="geometry"/></mxCell>
<mxCell id="g20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="170" y="362" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="g21" value="4 met" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="362" width="120" height="28" as="geometry"/></mxCell>
<mxCell id="g22" value="throughput 16 · goodput 4 · attainment 0.25" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="658" y="362" width="202" height="28" as="geometry"/></mxCell>
<mxCell id="g23" value="Streaming chat shows the first token at 0.4 s; a tool call, voice utterance, or grading script waits 10.38 s. An average TPOT can hide one long stall — a voice reply needs the longest gap too." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="eas8" name="Cost">
    <mxGraphModel dx="900" dy="354" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="354" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h1" value="Cost" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h2" value="Rate card × tokens · per 1,000 calls of 3,000 input and 500 output tokens (exercise rates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h3" value="small model · $0.25 / $0.75 per M" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="240" height="40" as="geometry"/></mxCell>
<mxCell id="h4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="104" width="16.0" height="40" as="geometry"/></mxCell>
<mxCell id="h5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="306.0" y="104" width="8.0" height="40" as="geometry"/></mxCell>
<mxCell id="h6" value="$1.125  (input $0.75 + output $0.375)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="322.0" y="104" width="538.0" height="40" as="geometry"/></mxCell>
<mxCell id="h7" value="frontier model · $5 / $15 per M" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="240" height="40" as="geometry"/></mxCell>
<mxCell id="h8" value="input $15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="164" width="320.0" height="40" as="geometry"/></mxCell>
<mxCell id="h9" value="output $7.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="164" width="160.0" height="40" as="geometry"/></mxCell>
<mxCell id="h10" value="$22.5" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="778.0" y="164" width="82.0" height="40" as="geometry"/></mxCell>
<mxCell id="h11" value="Both cards price output at 3× input, and the prompt is 6× the completion — so the input line is twice the output line on both. A shorter prompt or a wider price gap flips it. A blended per-million price hides the split." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="h12" value="frontier at $22.50&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;worth it on the hard slice, waste on the easy slice a $1.125 model passes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="h13" value="self-hosted GPU&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;bills while idle — the crossover is the self-hosting card, on a load test&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="460" y="288" width="400" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="eas9" name="Model Selection Workflow">
    <mxGraphModel dx="900" dy="482" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="482" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="i1" value="Model Selection Workflow" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="i2" value="Filter on hard attributes, rank survivors on soft ones, check with a private eval, iterate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="i3" value="write hard attributes from the product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="152" height="58" as="geometry"/></mxCell>
<mxCell id="i4" value="drop every candidate that fails one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="207" y="100" width="152" height="58" as="geometry"/></mxCell>
<mxCell id="i5" value="narrow with a matching public number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="374" y="100" width="152" height="58" as="geometry"/></mxCell>
<mxCell id="i6" value="private eval on the handful" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="541" y="100" width="152" height="58" as="geometry"/></mxCell>
<mxCell id="i7" value="choose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708" y="100" width="152" height="58" as="geometry"/></mxCell>
<mxCell id="i8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="i9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="i10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i5" target="i6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="i11" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i6" target="i7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="i12" value="a measurement shows an attribute was mislabeled" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="i6" target="i3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="574" y="190"/><mxPoint x="116" y="190"/></Array></mxGeometry></mxCell>
<mxCell id="i13" value="Hard (pass / fail)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;context window · license · data handling · modality and tools · launch languages · latency for inline code&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="i14" value="Soft (rank)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;quality on your eval · dollar cost · operating effort · how often you ride vendor upgrades&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="214" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="i15" value="the workflow on an example — not a claim about which model GitHub serves" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="i16" value="attribute" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="314" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="i17" value="Copilot-style inline suggestions" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="314" width="620" height="26" as="geometry"/></mxCell>
<mxCell id="i18" value="hard" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="i19" value="the suggestion starts inside the developer&#x27;s pause; license allows the product; context holds file + cursor" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="340" width="620" height="26" as="geometry"/></mxCell>
<mxCell id="i20" value="soft" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="i21" value="acceptance rate on your snippets, cost per suggestion, hosting pain" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="366" width="620" height="26" as="geometry"/></mxCell>
<mxCell id="i22" value="out" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="i23" value="a code-leaderboard leader that misses the pause — before its score is discussed" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="392" width="620" height="26" as="geometry"/></mxCell>
<mxCell id="i24" value="Quality, latency, and cost form a Pareto front: state the trade you accept. Build first the use case whose outcome you can measure — and name the harm the easy proxy does not see (the lamppost)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="eas10" name="Build versus Buy">
    <mxGraphModel dx="900" dy="454" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="454" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="j1" value="Build versus Buy" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="j2" value="Who produces the checkpoint you call — a lab you run, or a provider you pay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="j3" value="buy an API&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;OpenAI · Anthropic · Google&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="64" as="geometry"/></mxCell>
<mxCell id="j4" value="buy a hosted open-weight model&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a serving company, Amazon Bedrock&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="190" height="64" as="geometry"/></mxCell>
<mxCell id="j5" value="finetune&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;build a behavior on a purchase&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="190" height="64" as="geometry"/></mxCell>
<mxCell id="j6" value="pretrain / continue pretraining&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;BloombergGPT; Med-PaLM adapts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="100" width="190" height="64" as="geometry"/></mxCell>
<mxCell id="j7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j3" target="j4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="j8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j4" target="j5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="j9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j5" target="j6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="j10" value="almost every application team" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="610" height="18" as="geometry"/></mxCell>
<mxCell id="j11" value="almost always no" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="200" height="18" as="geometry"/></mxCell>
<mxCell id="j12" value="what you do build around the bought checkpoint" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="j13" value="prompts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="196" height="36" as="geometry"/></mxCell>
<mxCell id="j14" value="retrieval for private or changing facts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="228" width="196" height="36" as="geometry"/></mxCell>
<mxCell id="j15" value="tool calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="228" width="196" height="36" as="geometry"/></mxCell>
<mxCell id="j16" value="the private eval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="664" y="228" width="196" height="36" as="geometry"/></mxCell>
<mxCell id="j17" value="option" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="j18" value="trade" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="282" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="j19" value="API" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="j20" value="fastest strong model; weakest control of data, lineage, price at volume" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="310" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="j21" value="hosted open checkpoint" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="j22" value="a name you can pin; text still leaves unless the contract says otherwise" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="338" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="j23" value="pretrain" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="j24" value="a permanent training and serving organization — not reversible on a product timescale" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="366" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="j25" value="Swapping an API or hosted checkpoint is a selection rerun. If a hard attribute says no prompt may leave the network, the buy is a checkpoint you can run — the next card. A finetune does not replace retrieval for this morning&#x27;s policy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="eas11" name="Open Weights and Licenses">
    <mxGraphModel dx="900" dy="464" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="464" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="k1" value="Open Weights and Licenses" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="k2" value="Open weights ≠ open source ≠ a license — the file next to the weights is the claim that counts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="k3" value="OSI Open Source AI Definition 1.0 (Oct 2024)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;data information (a description, not the token dump) + training and running code + parameters, with no field-of-use ban&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="820" height="50" as="geometry"/></mxCell>
<mxCell id="k4" value="what you downloaded" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="k5" value="honestly called" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="162" width="210" height="40" as="geometry"/></mxCell>
<mxCell id="k6" value="check before shipping" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="162" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="k7" value="Apache 2.0 / MIT weights, no data" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="k8" value="open-weight, permissive" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="202" width="210" height="40" as="geometry"/></mxCell>
<mxCell id="k9" value="attribution; Apache adds NOTICE + patent grant" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="202" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="k10" value="Llama 3 community license (Apr 18, 2024)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="k11" value="open-weight, custom" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="242" width="210" height="40" as="geometry"/></mxCell>
<mxCell id="k12" value="700M MAU snapshot on release date · “Built with Meta Llama 3” · “Llama 3” name prefix · no improving non-Llama models · AUP" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="242" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="k13" value="a Mistral checkpoint" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="k14" value="that file&#x27;s license" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="282" width="210" height="40" as="geometry"/></mxCell>
<mxCell id="k15" value="Apache 2.0 (Mistral 7B), non-production (original Codestral), or modified MIT revenue gate &gt; $20M/month" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="282" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="k16" value="Gemma weights" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="k17" value="open-weight, custom terms" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="322" width="210" height="40" as="geometry"/></mxCell>
<mxCell id="k18" value="prohibited-use policy travels with derivatives" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="322" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="k19" value="an API" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="k20" value="a service" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="362" width="210" height="40" as="geometry"/></mxCell>
<mxCell id="k21" value="retention, training on prompts, regions, a stable model id" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="362" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="k22" value="The license on the pinned checkpoint is a hard attribute, read before the benchmark score. A procurement rule requiring an OSI license cannot be cleared by Gemma terms, the Llama license, or a Mistral revenue gate. OLMo publishes data and code too." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
