<mxCell id="e20" value="True / 1.0" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="680" y="248" width="180" height="30" as="geometry"/></mxCell>
