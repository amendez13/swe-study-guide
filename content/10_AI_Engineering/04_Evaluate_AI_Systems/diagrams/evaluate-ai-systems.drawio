<mxCell id="e1" value="Instruction Following" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="e2" value="Obedience to stated constraints: format, length, a required phrase, a forbidden topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="e3" value="IFEval (Zhou et al., Google)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;541 prompts · 25 verifiable instruction types · a program decides — no judge&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="e4" value="InFoBench (Qin et al.)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;500 instructions → 2,250 yes/no requirements · a judged ratio (252 easy)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="e5" value="a support macro with two instructions: at most 12 words, contains “refund”" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="e6" value="reply" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="e7" value="words" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="188" width="90" height="30" as="geometry"/></mxCell>
<mxCell id="e8" value="≤ 12 words" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="188" width="110" height="30" as="geometry"/></mxCell>
<mxCell id="e9" value="has “refund”" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="188" width="140" height="30" as="geometry"/></mxCell>
<mxCell id="e10" value="prompt / instruction" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="188" width="180" height="30" as="geometry"/></mxCell>
<mxCell id="e11" value="long: “We can refund the shipping charge…”" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="300" height="30" as="geometry"/></mxCell>
