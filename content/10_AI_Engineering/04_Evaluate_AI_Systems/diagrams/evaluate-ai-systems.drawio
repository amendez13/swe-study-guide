<mxCell id="d4" value="license use policy&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;Llama acceptable-use, Gemma prohibited-use&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="96" width="180" height="56" as="geometry"/></mxCell>
<mxCell id="d5" value="product policy&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the document your reviewers hold&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="96" width="180" height="56" as="geometry"/></mxCell>
<mxCell id="d6" value="you are bound by the intersection — write it down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="96" width="250" height="56" as="geometry"/></mxCell>
<mxCell id="d7" value="label set" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="180" height="46" as="geometry"/></mxCell>
<mxCell id="d8" value="categories" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="168" width="640" height="46" as="geometry"/></mxCell>
<mxCell id="d9" value="Llama Guard 3 (MLCommons)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="180" height="46" as="geometry"/></mxCell>
<mxCell id="d10" value="violent / non-violent / sex-related crimes, child sexual exploitation, defamation, specialized advice, privacy, IP, indiscriminate weapons, hate, suicide &amp; self-harm, sexual content, elections, + code-interpreter abuse" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="214" width="640" height="46" as="geometry"/></mxCell>
<mxCell id="d11" value="OpenAI moderation" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="180" height="46" as="geometry"/></mxCell>
<mxCell id="d12" value="harassment, hate, illicit activity, self-harm, sexual content, sexual content involving minors, violence" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="260" width="640" height="46" as="geometry"/></mxCell>
<mxCell id="d13" value="harm set&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;ordinary + adversarial prompts (HarmBench) — cite, do not paste an attack&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="d14" value="over-refusal set&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;allowed prompts that look adjacent (XSTest) — “how do I cancel”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="318" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="d15" value="score both&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the raw model reply and the filter&#x27;s label&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="318" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="d16" value="TruthfulQA measures imitative falsehood — a factuality set, not a hazard taxonomy. A Llama Guard label is a generation from that checkpoint; a new checkpoint is a new labeler." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
