<mxCell id="t2" value="A metric earns its place as a gate on four tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t3" value="Signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="196" height="32" as="geometry"/></mxCell>
<mxCell id="t4" value="test: poison the retrieved page with a contradiction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="196" height="72" as="geometry"/></mxCell>
<mxCell id="t5" value="fails when: grounded accuracy does not fall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="196" height="60" as="geometry"/></mxCell>
<mxCell id="t6" value="Reliability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="96" width="196" height="32" as="geometry"/></mxCell>
<mxCell id="t7" value="test: second rater or second run: Cohen&#x27;s kappa (2), Fleiss&#x27; kappa (more)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="248" y="134" width="196" height="72" as="geometry"/></mxCell>
<mxCell id="t8" value="fails when: the judge flips on a swap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="248" y="212" width="196" height="60" as="geometry"/></mxCell>
<mxCell id="t9" value="Correlation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="96" width="196" height="32" as="geometry"/></mxCell>
<mxCell id="t10" value="test: slice reopens or edits by rubric level, on rows not used to write it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="456" y="134" width="196" height="72" as="geometry"/></mxCell>
<mxCell id="t11" value="fails when: raters agree on warmth; reopens track the policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="456" y="212" width="196" height="60" as="geometry"/></mxCell>
<mxCell id="t12" value="Cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="664" y="96" width="196" height="32" as="geometry"/></mxCell>
<mxCell id="t13" value="test: program + classifier every change, judge on a schedule, people on a slice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="664" y="134" width="196" height="72" as="geometry"/></mxCell>
<mxCell id="t14" value="fails when: the only honest eval runs once a quarter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="664" y="212" width="196" height="60" as="geometry"/></mxCell>
<mxCell id="t15" value="A metric that fails one test stays a diagnostic. Fix a flipping judge with the guideline — tighter levels, an example, a smaller question — not by lowering the bar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="820" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
