<mxCell id="f7" value="turn 3&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;in role&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="314" y="168" width="130" height="48" as="geometry"/></mxCell>
<mxCell id="f8" value="turn 4&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;in role&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="451" y="168" width="130" height="48" as="geometry"/></mxCell>
