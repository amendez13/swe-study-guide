<mxCell id="f14" value="tool" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="280" height="30" as="geometry"/></mxCell>
