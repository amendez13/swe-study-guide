<mxCell id="f16" value="exact substring match" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="280" height="30" as="geometry"/></mxCell>
