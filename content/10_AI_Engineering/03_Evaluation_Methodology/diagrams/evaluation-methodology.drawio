<mxCell id="p4" value="mitigation" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="96" width="620" height="32" as="geometry"/></mxCell>
<mxCell id="p5" value="inconsistency on close calls" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="200" height="32" as="geometry"/></mxCell>
<mxCell id="p6" value="pin the id, low temperature, a one-level tie band, a small majority near the boundary" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="128" width="620" height="32" as="geometry"/></mxCell>
