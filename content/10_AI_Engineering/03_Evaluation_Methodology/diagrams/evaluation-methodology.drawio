<mxCell id="q22" value="GPT-4" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="140" height="26" as="geometry"/></mxCell>
<mxCell id="q23" value="8.7%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="336" width="43.5" height="26" as="geometry"/></mxCell>
<mxCell id="q24" value="self-enhancement: not established&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;GPT-4 self win rate +10%, Claude-v1 +25% vs humans; GPT-3.5 did not favor itself — style and quality could not be separated&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="820" height="50" as="geometry"/></mxCell>
<mxCell id="q25" value="Mitigations: swap the order, hold length fixed when the pair is about a fact (Arena&#x27;s style control puts length + markdown into the regression), and a different family or people on the launch slice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ev17" name="Which Models Can Judge">
    <mxGraphModel dx="900" dy="436" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="436" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="r1" value="Which Models Can Judge" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="r2" value="The weakest judge that still sees the failures you care about — after you measure it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r3" value="judge" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="170" height="34" as="geometry"/></mxCell>
<mxCell id="r4" value="the job it can hold" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="96" width="330" height="34" as="geometry"/></mxCell>
<mxCell id="r5" value="the check you still owe" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="96" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="r6" value="a stronger model" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="170" height="34" as="geometry"/></mxCell>
<mxCell id="r7" value="open quality of a weaker generator; preference labels" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="210" y="130" width="330" height="34" as="geometry"/></mxCell>
<mxCell id="r8" value="a human slice; position and verbosity bias" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="r9" value="the same model" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="170" height="34" as="geometry"/></mxCell>
<mxCell id="r10" value="which of two prompts this model prefers" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="210" y="164" width="330" height="34" as="geometry"/></mxCell>
<mxCell id="r11" value="someone else before you call it correct" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="164" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="r12" value="a weaker model" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="170" height="34" as="geometry"/></mxCell>
<mxCell id="r13" value="a narrow criterion with measured agreement" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="210" y="198" width="330" height="34" as="geometry"/></mxCell>
<mxCell id="r14" value="the severe rows, not the easy passes" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="198" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="r15" value="specialized scorer" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="170" height="34" as="geometry"/></mxCell>
<mxCell id="r16" value="see the inputs below" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="210" y="232" width="330" height="34" as="geometry"/></mxCell>
<mxCell id="r17" value="the input it trained on and its shortcut" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="232" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="r18" value="specialized scorers differ by input" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="r19" value="reward model&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;one completion → a scalar (best-of-N)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="196" height="60" as="geometry"/></mxCell>
<mxCell id="r20" value="Prometheus&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;completion + rubric + reference → score&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="306" width="196" height="60" as="geometry"/></mxCell>
<mxCell id="r21" value="PandaLM, JudgeLM&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;question + two completions → preference&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="306" width="196" height="60" as="geometry"/></mxCell>
<mxCell id="r22" value="NLI / policy classifier&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;entailment, or one harm&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="664" y="306" width="196" height="60" as="geometry"/></mxCell>
<mxCell id="r23" value="A schema needs no judge — a parser is exact. When the verdict gates a launch, the judge and generator are not the same run: pin both ids. A new generator makes the old calibration a hypothesis; a new judge is a new metric." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
