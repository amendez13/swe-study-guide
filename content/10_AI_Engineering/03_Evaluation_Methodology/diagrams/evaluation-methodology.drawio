<mxCell id="h15" value="crossing the streams" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="260" height="28" as="geometry"/></mxCell>
