<mxCell id="h1" value="Exact and Subjective Evaluation" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h2" value="Split the feature into fields, then give each field the tool that matches it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h3" value="Exact: a program decides&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;unit test · multiple-choice key · normalized label · SQL result set · JSON schema (syntax only)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="h4" value="Subjective: a judgment decides&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;helpful · fair summary · sounds like our desk — needs a rubric and a rater&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="h5" value="Notion AI meeting summary (mixed)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="600" height="18" as="geometry"/></mxCell>
