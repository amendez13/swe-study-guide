<mxCell id="t5" value="20 models" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="120" height="28" as="geometry"/></mxCell>
