<mxCell id="h7" value="date + decision vs the note (exact)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="196" width="240" height="40" as="geometry"/></mxCell>
<mxCell id="h8" value="pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="90" height="52" as="geometry"/></mxCell>
<mxCell id="h9" value="judge the phrasing (subjective)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="196" width="250" height="40" as="geometry"/></mxCell>
