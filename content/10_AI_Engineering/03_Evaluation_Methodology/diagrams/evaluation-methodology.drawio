<mxCell id="p8" value="anchored checks; if two people cannot agree, the level is not ready" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="160" width="620" height="32" as="geometry"/></mxCell>
<mxCell id="p9" value="cost and latency" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="200" height="32" as="geometry"/></mxCell>
<mxCell id="p10" value="offline only for a frontier judge; a distilled reward model on the request path" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="192" width="620" height="32" as="geometry"/></mxCell>
