<mxCell id="s17" value="style control: length + markdown in the regression" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="346" width="620" height="28" as="geometry"/></mxCell>
