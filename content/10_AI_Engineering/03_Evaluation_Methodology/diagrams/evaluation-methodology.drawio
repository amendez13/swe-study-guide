<mxCell id="p13" value="math probe: LLaMA-13B vs Vicuna-13B, both orders, 10 questions = 20 judgments — GPT-4 calls a wrong answer correct" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="820" height="18" as="geometry"/></mxCell>
