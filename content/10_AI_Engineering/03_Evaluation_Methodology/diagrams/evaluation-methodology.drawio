  <diagram id="ev6" name="How to Read Perplexity">
    <mxGraphModel dx="900" dy="416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="416" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="g1" value="How to Read Perplexity" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="g2" value="Evidence about next-token fit on one corpus under one tokenizer — and nothing else" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="g3" value="Defend&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;checkpoints of one run · domains under one tokenizer (Zendesk exports vs Wikipedia) · a corpus filter with one scoring model · a contamination smell vs a matched control&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="g4" value="Refuse&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;ranking two tokenizers · low score on easy text as proof of leakage · reverting a chat model because Wikipedia perplexity rose&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="g5" value="what moves the number before any model gets better" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="g6" value="more predictable / templated text → lower" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="268" height="40" as="geometry"/></mxCell>
<mxCell id="g7" value="larger vocabulary → higher (uniform over V = V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="216" width="268" height="40" as="geometry"/></mxCell>
<mxCell id="g8" value="longer context (512 vs 8,192) → lower" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="592" y="216" width="268" height="40" as="geometry"/></mxCell>
<mxCell id="g9" value="after post-training" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="g10" value="SFT + preference training change the objective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="g11" value="Wikipedia perplexity can rise while win rate rises" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="296" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="g12" value="go measure the public tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="296" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="g13" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g10" target="g11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g14" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g11" target="g12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g15" value="InstructGPT&#x27;s alignment tax: regressions on SQuAD, DROP, HellaSwag, WMT 2015 fr→en. PPO-ptx (mixing pretraining updates back in) reduced them, did not erase them. A perplexity rise is a reason to measure — not itself the tax." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
