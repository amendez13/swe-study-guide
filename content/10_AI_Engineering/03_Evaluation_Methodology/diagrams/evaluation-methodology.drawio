<mxCell id="s1" value="Ranking from Pairwise Votes" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="s2" value="Turn head-to-head votes into a strength per model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="s3" value="Elo (online)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;E = 1 / (1 + 10^((R_B − R_A)/400)) · R ← R + K(score − E)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="s4" value="Bradley-Terry (whole matrix)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;P(i beats j) = logistic(s_i − s_j) · order-independent max likelihood&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="s5" value="A 1500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="100" height="34" as="geometry"/></mxCell>
<mxCell id="s6" value="B 1500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="100" height="34" as="geometry"/></mxCell>
<mxCell id="s7" value="A wins, K = 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="190" width="130" height="34" as="geometry"/></mxCell>
<mxCell id="s8" value="A 1516 · B 1484" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="140" height="34" as="geometry"/></mxCell>
<mxCell id="s9" value="400 points = 10-to-1: E = 1/1.1 ≈ 0.9091 · a BT gap of ln 10 is the same odds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="490" y="170" width="370" height="74" as="geometry"/></mxCell>
<mxCell id="s10" value="Chatbot Arena (LMSYS → LMArena → Arena)" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="200" height="28" as="geometry"/></mxCell>
