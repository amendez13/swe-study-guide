<mxCell id="f5" value="treated as nats: e^2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="96" width="300" height="36" as="geometry"/></mxCell>
