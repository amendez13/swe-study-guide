<mxCell id="s19" value="careful" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="420" width="100" height="30" as="geometry"/></mxCell>
