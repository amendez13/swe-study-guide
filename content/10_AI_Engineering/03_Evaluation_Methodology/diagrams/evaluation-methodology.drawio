<mxCell id="f8" value="nats → bits, then 2^(2.0/ln 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="300" height="36" as="geometry"/></mxCell>
