<mxCell id="t8" value="sampling the pairs" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="260" height="28" as="geometry"/></mxCell>
