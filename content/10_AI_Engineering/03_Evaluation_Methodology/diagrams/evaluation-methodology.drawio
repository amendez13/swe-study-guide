<mxCell id="s14" value="Dec 2023 / Jan 2024" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="s15" value="Bradley-Terry fit, displayed so 400 points = 10-to-1; bootstrap intervals" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="318" width="620" height="28" as="geometry"/></mxCell>
