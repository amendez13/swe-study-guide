<mxCell id="t13" value="votes on the decision you actually have" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="278" width="560" height="28" as="geometry"/></mxCell>
