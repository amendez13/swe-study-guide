<mxCell id="p15" value="14 / 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="298" width="364" height="28" as="geometry"/></mxCell>
<mxCell id="p16" value="reason in the same prompt" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="p17" value="6 / 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="332" width="156" height="28" as="geometry"/></mxCell>
<mxCell id="p18" value="its own separate reference shown" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="p19" value="3 / 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="366" width="78" height="28" as="geometry"/></mxCell>
<mxCell id="p20" value="Ten questions is a probe, not a rate. A judge call often carries more tokens than the draft — fine nightly, wrong for Copilot ghost text or Smart Compose. Low temperature makes it repeatable, not right." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="820" height="40" as="geometry"/></mxCell>
