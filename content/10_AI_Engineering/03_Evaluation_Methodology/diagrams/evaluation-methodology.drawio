<mxCell id="o34" value="run where you measured agreement" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="470" width="520" height="26" as="geometry"/></mxCell>
