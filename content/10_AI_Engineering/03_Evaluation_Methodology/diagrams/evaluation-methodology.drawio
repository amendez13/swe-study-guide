<mxCell id="o2" value="A prompt + a verdict schema + a calibration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="o3" value="setup" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="o4" value="you ask" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="96" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="o5" value="you can conclude" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="96" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="o6" value="pointwise score" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="o7" value="a number on one answer" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="130" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="o8" value="useful with anchored levels; drifts — one pinned judge, one rubric" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="o9" value="pairwise" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="o10" value="which of two is better, ties allowed" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="164" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="o11" value="stabler ranking; a win is not fit to ship" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="164" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="o12" value="reference-based" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="o13" value="faithful to the source / as good as gold" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="198" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="o14" value="faithfulness to that source (summary vs Gmail thread)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="198" width="320" height="34" as="geometry"/></mxCell>
