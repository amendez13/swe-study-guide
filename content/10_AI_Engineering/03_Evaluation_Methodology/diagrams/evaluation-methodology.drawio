<mxCell id="o17" value="keeps a pointwise score meaningful across weeks" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="232" width="320" height="34" as="geometry"/></mxCell>
<mxCell id="o18" value="calibration loop" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="400" height="18" as="geometry"/></mxCell>
