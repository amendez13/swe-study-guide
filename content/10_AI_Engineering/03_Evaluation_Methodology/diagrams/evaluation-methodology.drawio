<mxCell id="f13" value="perplexity 1 = probability 1 on every token · probability 1/k on every token = perplexity k" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="f14" value="same factor of two, same loss gap (ln 2 ≈ 0.693 nats), different-looking drops" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="820" height="18" as="geometry"/></mxCell>
