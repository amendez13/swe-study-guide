<mxCell id="f63" value="Raw totals pick prod (25 to 24: it played 40 games, the finetune 30). Win rate and a Bradley-Terry fit both put the finetune first. Rank it first — then run the exact date check and a calibrated read before it replaces prod. A win in the pool is not a pass line." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="820" height="52" as="geometry"/></mxCell>
<mxCell id="f64" value="&lt;b&gt;Answer:&lt;/b&gt; (25, 24, 20, 14, 7) [&#x27;prod&#x27;, &#x27;finetune&#x27;, &#x27;llama&#x27;, &#x27;mistral&#x27;, &#x27;small&#x27;]&lt;br&gt;0.800 0.625 0.500 0.467 0.175 [&#x27;finetune&#x27;, &#x27;prod&#x27;, &#x27;llama&#x27;, &#x27;mistral&#x27;, &#x27;small&#x27;]&lt;br&gt;0.502 0.227 0.141 0.093 0.037 [&#x27;finetune&#x27;, &#x27;prod&#x27;, &#x27;llama&#x27;, &#x27;mistral&#x27;, &#x27;small&#x27;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="820" height="64" as="geometry"/></mxCell>
