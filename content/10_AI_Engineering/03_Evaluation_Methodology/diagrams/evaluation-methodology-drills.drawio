<mxCell id="a2" value="Hex notebook → BigQuery SQL over a Shopify orders export: “which paid orders?”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="a3" value="gold: select order_id, cents from orders where status = &#x27;paid&#x27; order by order_id" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="820" height="28" as="geometry"/></mxCell>
