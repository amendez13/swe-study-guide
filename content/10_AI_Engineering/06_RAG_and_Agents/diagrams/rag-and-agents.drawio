<mxCell id="r12" value="a fluent decomposition of a messy request; new tools via a prompt" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="216" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="r13" value="invents tools, skips preconditions, states steps as done" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="216" width="320" height="40" as="geometry"/></mxCell>
