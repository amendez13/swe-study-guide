<mxCell id="l16" value="catch" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="l17" value="a column never in the schema" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="l18" value="known-column check before it runs" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="278" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="l19" value="order created date when the event is on the refund" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="l20" value="score the result (functional correctness)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="306" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="l21" value="counted refund rows, question asked orders" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="l22" value="compare against the rows you meant" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="334" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="l23" value="UPDATE / DELETE / DDL" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="l24" value="never runs, however helpful" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="362" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="l25" value="The warehouse is the source; the model&#x27;s sentence is not. An empty result is not “zero” until the statement is the one you meant. A semantic layer of approved metrics stops an invented definition of “refunded.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ra13" name="What an Agent Is">
    <mxGraphModel dx="900" dy="486" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="486" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="m1" value="What an Agent Is" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="m2" value="A planner in a loop over an environment it can affect only through tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="m3" value="planner (the model; sometimes a program that overrides it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="m4" value="tools — the only actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="m5" value="environment: a repository + tests, a browser, a travel API, a help center + ticket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="m6" value="host program: appends the observation, calls the model again, enforces step cap + allow-list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="m7" value="choose" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m8" value="act" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m9" value="observation" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="m5" target="m3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="235"/></Array></mxGeometry></mxCell>
<mxCell id="m10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m6" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="m11" value="system" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m12" value="agent?" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="m13" value="retrieve once, generate once" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m14" value="no — RAG" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="318" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="m15" value="model may search again, switch tools, or stop" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m16" value="yes — a multi-step RAG agent" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="346" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="m17" value="ChatGPT + browser · Copilot coding agent · support bot that looks up and drafts" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m18" value="agents, increasing side effect" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="374" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="m19" value="planner can charge a card" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="m20" value="moves money — System-level defenses is the boundary" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="402" width="520" height="28" as="geometry"/></mxCell>
<mxCell id="m21" value="The model can propose “stop.” The step cap and allow-list must stop it when it never does." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="820" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
