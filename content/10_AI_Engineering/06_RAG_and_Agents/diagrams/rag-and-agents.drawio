<mxCell id="h24" value="Reranking raises precision at the small k you prompt with — the window, the bill, and lost-in-the-middle are why five beats fifty. The score is an order, not a calibrated probability, and not the grounding check." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
