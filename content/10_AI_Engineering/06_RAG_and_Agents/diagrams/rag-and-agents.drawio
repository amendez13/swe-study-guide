<mxCell id="f2" value="Never add a BM25 score to a cosine — fuse ranks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="f3" value="scales do not match&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;cosine in [−1, 1]; Elasticsearch cosine score often 1 + cos in [0, 2]; BM25 unbounded — the larger scale wins the sum&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="820" height="44" as="geometry"/></mxCell>
<mxCell id="f4" value="reciprocal rank fusion (Cormack, Clarke, Buettcher, 2009): score = Σ 1 / (k + rank), k = 60" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="154" width="820" height="18" as="geometry"/></mxCell>
