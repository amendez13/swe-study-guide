<mxCell id="a1" value="Why Retrieve" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a2" value="Fetch a short set of passages at request time and answer from them" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="a3" value="Long context&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;the Gmail thread or contract the user just pasted — fits, costs prefill and input tokens, middle gets underused&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="a4" value="Retrieval (RAG)&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;a permissioned help center that changes every hour — keep it in an index, fetch a few passages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="64" as="geometry"/></mxCell>
