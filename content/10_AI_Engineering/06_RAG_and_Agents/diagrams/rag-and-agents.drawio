<mxCell id="q12" value="look up order → read policy → draft reply" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="400" height="28" as="geometry"/></mxCell>
