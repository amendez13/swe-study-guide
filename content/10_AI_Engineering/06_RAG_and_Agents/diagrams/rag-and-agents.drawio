<mxCell id="a20" value="Notion AI, NotebookLM, Perplexity, a Zendesk bot — an index you maintain + a prompted model (training stack not visible)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="336" width="560" height="30" as="geometry"/></mxCell>
