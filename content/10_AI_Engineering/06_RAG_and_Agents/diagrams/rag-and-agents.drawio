<mxCell id="a22" value="can be wrong (Factual consistency), stale, or hostile (indirect prompt injection — RAG does not close it)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="366" width="560" height="30" as="geometry"/></mxCell>
<mxCell id="a23" value="Levers: a finetune freezes yesterday&#x27;s wiki; a prompt cannot see a page you did not send; retrieval sees the page. Usual production shape: a short retrieved set inside a long window." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="820" height="40" as="geometry"/></mxCell>
