<mxCell id="t27" value="Append the error code and message you trust, not an unfiltered upstream body (it can be an injection). One retry with backoff is a policy; the fifth identical call is a stuck agent. Cap the attempts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="820" height="40" as="geometry"/></mxCell>
