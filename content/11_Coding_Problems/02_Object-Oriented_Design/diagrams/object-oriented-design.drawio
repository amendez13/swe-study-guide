<mxCell id="c31" value="Analyze relationships" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c32" value="Say how types know each other, with cardinality. Most are has-a or knows-a; is-a only when the child truly stands in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Member&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;open_loans&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;borrow(tool)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="160" height="75" as="geometry"/></mxCell>
<mxCell id="c34" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Loan&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;member&lt;br&gt;tool&lt;br&gt;due_date&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="160" height="84" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Tool&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;barcode&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;is_available()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="160" height="75" as="geometry"/></mxCell>
<mxCell id="c36" value="1 has *" style="endArrow=open;endSize=8;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c37" value="* knows 1" style="endArrow=open;endSize=8;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c38" value="invariant: a tool has at most one open loan" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="236" width="460" height="18" as="geometry"/></mxCell>
<mxCell id="c39" value="relationship" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="c310" value="meaning" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="276" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="c311" value="here" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="276" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="c312" value="has-a (composition / collection)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="c313" value="owns or holds others" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="302" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="c314" value="Member has zero or more Loans" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="302" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="c315" value="knows-a (association)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="c316" value="keeps a reference, does not own its lifetime" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="328" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="c317" value="Loan knows one Member and one Tool" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="328" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="c318" value="is-a (inheritance)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="c319" value="the child can stand in for the parent" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="354" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="c320" value="none: Loan is not a Member, Tool is not a Loan" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="354" width="280" height="26" as="geometry"/></mxCell>
<mxCell id="c321" value="Saying the two negatives out loud prevents a diagram that is only a pile of arrows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="actions" name="Investigate actions">
    <mxGraphModel dx="900" dy="398" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="398" math="0" shadow="0">
