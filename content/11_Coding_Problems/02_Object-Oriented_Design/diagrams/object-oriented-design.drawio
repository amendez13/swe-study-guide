<mxCell id="c26" value="→ Tool" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="140" width="170" height="28" as="geometry"/></mxCell>
<mxCell id="c27" value="loan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c28" value="→ Loan" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="176" width="170" height="28" as="geometry"/></mxCell>
<mxCell id="c29" value="barcode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c210" value="→ field on Tool" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="190" y="212" width="170" height="28" as="geometry"/></mxCell>
<mxCell id="c211" value="due date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c212" value="→ field on Loan" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="190" y="248" width="170" height="28" as="geometry"/></mxCell>
<mxCell id="c213" value="the number 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c214" value="→ constant in Member" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="190" y="284" width="170" height="28" as="geometry"/></mxCell>
<mxCell id="c215" value="week" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c216" value="→ a rule on Loan" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="190" y="320" width="170" height="28" as="geometry"/></mxCell>
<mxCell id="c217" value="neighbor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="140" height="28" as="geometry"/></mxCell>
<mxCell id="c218" value="→ same actor as Member" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="190" y="356" width="170" height="28" as="geometry"/></mxCell>
<mxCell id="c219" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Member&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;id&lt;br&gt;open_loans&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;borrow(tool)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="c220" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Tool&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;barcode&lt;br&gt;on_loan&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="170" height="69" as="geometry"/></mxCell>
<mxCell id="c221" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Loan&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;member&lt;br&gt;tool&lt;br&gt;due_date&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;is_overdue()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="530" y="260" width="170" height="105" as="geometry"/></mxCell>
<mxCell id="c222" value="" style="endArrow=open;endSize=8;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c219" target="c221"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c223" value="" style="endArrow=open;endSize=8;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c221" target="c220"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c224" value="Two types that always change together are one type; a type with no fields and one method is a function." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="820" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rel" name="Analyze relationships">
    <mxGraphModel dx="900" dy="440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="440" math="0" shadow="0">
      <root>
