<mxCell id="c24" value="→ Member" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="104" width="170" height="28" as="geometry"/></mxCell>
