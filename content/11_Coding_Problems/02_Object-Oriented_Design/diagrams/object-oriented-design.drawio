<mxCell id="c410" value="" style="endArrow=none;html=1;strokeColor=#bbbbbb;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="134" as="sourcePoint"/><mxPoint x="750" y="306" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c411" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="152" as="sourcePoint"/><mxPoint x="330" y="152" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c412" value="request(4)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="124" y="136" width="202" height="15" as="geometry"/></mxCell>
<mxCell id="c413" value="look at every cab; pick an idle one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="233.0" y="173" width="194" height="22" as="geometry"/></mxCell>
<mxCell id="c414" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="216" as="sourcePoint"/><mxPoint x="750" y="216" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c415" value="go(4)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="334" y="200" width="412" height="15" as="geometry"/></mxCell>
<mxCell id="c416" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="248" as="sourcePoint"/><mxPoint x="330" y="248" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c417" value="arrived → mark_idle(B)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="334" y="232" width="412" height="15" as="geometry"/></mxCell>
<mxCell id="c418" value="a full or broken cab is skipped, not crashed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="233.0" y="269" width="194" height="22" as="geometry"/></mxCell>
<mxCell id="c419" value="A destination button inside a cab is a different action and talks to that Cab directly." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="c420" value="✗ If a method on A needs private fields from B and C, the action is on the wrong object. Adding a third cab should change the Scheduler&#x27;s list, not the button." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="encap" name="Encapsulation">
    <mxGraphModel dx="900" dy="360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c51" value="Encapsulation" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c52" value="The owner of the data is the only code that changes it, and it refuses changes that break its rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c53" value="✗ public counter" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c54" value="Hopper&lt;br&gt;stock = 1 (public)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="c55" value="any caller: hopper.stock -= 1 twice → −1&lt;br&gt;hopper.stock = −5 → nothing can stop it" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="230" y="124" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="c56" value="✓ private counter, one operation" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="98" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c57" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Hopper&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;- _stock: int&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;+ vend() -&amp;gt; bool&lt;br&gt;+ stock (read-only)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="124" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c58" value="invariant: stock is never negative" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="140" width="170" height="36" as="geometry"/></mxCell>
<mxCell id="c59" value="Trace: Hopper(1)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c510" value="vend() → True&lt;br&gt;stock 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="170" height="46" as="geometry"/></mxCell>
<mxCell id="c511" value="vend() → False&lt;br&gt;stock 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="240" width="170" height="46" as="geometry"/></mxCell>
<mxCell id="c512" value="vend() → False&lt;br&gt;stock 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="240" width="170" height="46" as="geometry"/></mxCell>
<mxCell id="c513" value="the refusal lives in one place" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="240" height="46" as="geometry"/></mxCell>
<mxCell id="c514" value="Getters are not the point: returning a mutable internal list still lets callers break the rule. In Python the underscore is a convention; the discipline is not touching it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="inherit" name="Inheritance">
    <mxGraphModel dx="900" dy="488" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="488" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c61" value="Inheritance" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c62" value="A child must work everywhere the parent is accepted (Liskov). Overriding to refuse breaks that promise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c63" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;BikeCage&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;park(cargo) -&amp;gt; &amp;#x27;parked&amp;#x27;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="200" height="54" as="geometry"/></mxCell>
<mxCell id="c64" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;CompactCage&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;park(cargo): raise if cargo&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="120" y="240" width="200" height="54" as="geometry"/></mxCell>
<mxCell id="c65" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="c64" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c66" value="caller(cage: BikeCage)&lt;br&gt;cage.park(cargo=True)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="c67" value="handed a BikeCage → parked ✓" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="210" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="c68" value="handed a CompactCage → ValueError ✗" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="232" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="c69" value="Fix: the differing rule is a collaborator, not a subclass" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="c610" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Cage&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;accepts: Policy&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;park(cargo)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="350" width="200" height="75" as="geometry"/></mxCell>
<mxCell id="c611" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Policy&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;accepts(cargo) -&amp;gt; bool&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="470" y="350" width="200" height="69" as="geometry"/></mxCell>
<mxCell id="c612" value="" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=open;endSize=8;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c610" target="c611"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c613" value="Use inheritance only when the is-a sentence survives this test; needing three of the parent&#x27;s methods is not the test." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="820" height="34" as="geometry"/></mxCell>
