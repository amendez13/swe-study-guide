  <diagram id="compose" name="Composition over inheritance">
    <mxGraphModel dx="900" dy="404" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="404" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c81" value="Composition over inheritance" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c82" value="Vary a part, a policy, or a collaborator by holding it, not by subclassing for every combination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c83" value="✗ one subclass per combination" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c84" value="Cup+milk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="c85" value="Cup+syrup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="124" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="c86" value="Cup+shot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="c87" value="Cup+milk+syrup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="160" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="c88" value="Cup+milk+shot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="c89" value="Cup+syrup+shot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="196" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="c810" value="Cup+milk+syrup+shot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="c811" value="7 subclasses for 3 additions (2^3 − 1), and the next syrup doubles it" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="380" height="30" as="geometry"/></mxCell>
<mxCell id="c812" value="✓ the cup has additions" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="98" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c813" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Cup&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;additions: list&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;price() = 300 + Σ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="124" width="170" height="75" as="geometry"/></mxCell>
<mxCell id="c814" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Addition&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;cents&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;price()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="124" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="c815" value="*" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=open;endSize=8;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c813" target="c814"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c816" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Milk (50¢)&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="100" height="33" as="geometry"/></mxCell>
<mxCell id="c817" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="c816" target="c814"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c818" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Syrup (75¢)&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="665" y="250" width="100" height="33" as="geometry"/></mxCell>
<mxCell id="c819" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="c818" target="c814"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c820" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Shot (60¢)&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="100" height="33" as="geometry"/></mxCell>
<mxCell id="c821" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="c820" target="c814"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c822" value="one class per addition: Cup([Milk, Syrup]).price() = 300 + 50 + 75 = 425" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="380" height="36" as="geometry"/></mxCell>
<mxCell id="c823" value="“I am not subclassing the cage for each fee. The cage has a fee policy.” Inheritance still fits a true subtype that honors the parent&#x27;s contract." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="iface" name="Interfaces vs abstract classes">
    <mxGraphModel dx="900" dy="404" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="404" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c91" value="Interfaces vs abstract classes" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c92" value="An interface names a capability; an abstract class shares real state and code with hooks left open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c93" value="Interface: unrelated types, one capability" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c94" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Door&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;try_open(token)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="130" height="54" as="geometry"/></mxCell>
<mxCell id="c95" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Admitter&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;admit(token) -&amp;gt; bool&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="180" height="69" as="geometry"/></mxCell>
<mxCell id="c96" value="depends on" style="endArrow=open;endSize=8;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c94" target="c95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c97" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;FobReader&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;admit()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="120" height="54" as="geometry"/></mxCell>
<mxCell id="c98" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="c97" target="c95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c99" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;QrReader&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;admit()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="180" y="240" width="120" height="54" as="geometry"/></mxCell>
<mxCell id="c910" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="c99" target="c95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c911" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;Keypad&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;admit()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="120" height="54" as="geometry"/></mxCell>
<mxCell id="c912" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="c911" target="c95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c913" value="Abstract class: when there is shared state" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="98" width="390" height="18" as="geometry"/></mxCell>
<mxCell id="c914" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Reader&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;failures: int&lt;br&gt;lockout_until&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;admit(token)  # shared skeleton&lt;br&gt;check(token)  # abstract hook&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="530" y="130" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="c915" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;FobReader&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;check(token)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="270" width="150" height="54" as="geometry"/></mxCell>
<mxCell id="c916" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="c915" target="c914"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c917" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;b&gt;QrReader&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;check(token)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670" y="270" width="150" height="54" as="geometry"/></mxCell>
<mxCell id="c918" value="" style="endArrow=block;endFill=0;endSize=12;html=1;strokeWidth=1.5;strokeColor=#555555;" edge="1" parent="1" source="c917" target="c914"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c919" value="“No shared state, so this is an interface.” Do not add an interface with one implementation and no reason to grow a second." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="solid" name="SOLID">
    <mxGraphModel dx="900" dy="356" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="356" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="c101" value="SOLID" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c102" value="Five checks to run on a design you just drew, not a list to recite before you have types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c103" value="S" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c104" value="&lt;b&gt;Single responsibility&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;one type, one reason to change: split rule, store, notifier&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="90" y="100" width="420" height="40" as="geometry"/></mxCell>
<mxCell id="c105" value="O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c106" value="&lt;b&gt;Open/closed&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;add a behavior by adding a type: a new FeePolicy class&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="90" y="148" width="420" height="40" as="geometry"/></mxCell>
<mxCell id="c107" value="L" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=20;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c108" value="&lt;b&gt;Liskov substitution&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;a subtype works wherever the parent does: no refusing inputs the parent took&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="90" y="196" width="420" height="40" as="geometry"/></mxCell>
<mxCell id="c109" value="I" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=20;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c1010" value="&lt;b&gt;Interface segregation&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;keep the interface as small as the caller: a lantern needs no audit log&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="90" y="244" width="420" height="40" as="geometry"/></mxCell>
<mxCell id="c1011" value="D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=20;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c1012" value="&lt;b&gt;Dependency inversion&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;high-level code depends on Admitter / FeePolicy; the edge builds concretes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="90" y="292" width="420" height="40" as="geometry"/></mxCell>
