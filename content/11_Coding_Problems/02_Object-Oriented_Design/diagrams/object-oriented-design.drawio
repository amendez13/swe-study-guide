<mxCell id="c41" value="Investigate actions" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="c42" value="Verbs become methods on the object that already holds the data to decide. Walk one scenario as messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="c43" value="floor button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="104" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="c44" value="Scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270.0" y="104" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="c45" value="Cab A (busy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="480.0" y="104" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="c46" value="Cab B (idle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690.0" y="104" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="c47" value="" style="endArrow=none;html=1;strokeColor=#bbbbbb;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="134" as="sourcePoint"/><mxPoint x="120" y="306" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c48" value="" style="endArrow=none;html=1;strokeColor=#bbbbbb;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="134" as="sourcePoint"/><mxPoint x="330" y="306" as="targetPoint"/></mxGeometry></mxCell>
