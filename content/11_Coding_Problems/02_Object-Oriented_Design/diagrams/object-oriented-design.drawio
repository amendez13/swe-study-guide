<mxCell id="c154" value="&lt;div style=&quot;margin:2px 6px&quot;&gt;&lt;i&gt;«decorator»&lt;/i&gt;&lt;br&gt;&lt;b&gt;LoggingDoor&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;inner&lt;br&gt;log&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;margin:2px 6px&quot;&gt;open(credential) -&amp;gt; bool&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Courier New;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="180" height="105" as="geometry"/></mxCell>
