<mxfile host="drawio">
  <diagram id="ask" name="What you still have not pinned down">
    <mxGraphModel dx="900" dy="394" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="394" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="d11" value="What you still have not pinned down" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="d12" value="“Design a courtyard bike cage. Members tap a fob and the gate opens.” Then silence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="d13" value="? Who counts as a member? Can a guest enter?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="d14" value="? How many bikes fit, and what happens when it is full?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="d15" value="? May one person store two bikes?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="d16" value="? Is payment in this round, or only admission?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="d17" value="? What is out of scope?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="d18" value="&lt;b&gt;“Use your judgment” → say it and move&lt;/b&gt;&lt;br&gt;actors: members&lt;br&gt;bikes per member: 1&lt;br&gt;when full: refuse the tap&lt;br&gt;payments: no" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="360" height="140" as="geometry"/></mxCell>
<mxCell id="d19" value="✗ silently inventing payments and a mobile app is the design the interviewer cannot correct" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="282" width="360" height="36" as="geometry"/></mxCell>
<mxCell id="d110" value="&lt;b&gt;Answer:&lt;/b&gt; Ask about members vs guests, capacity and the full case, bikes per person, payment, and scope. Then proceed: members only, 1 bike, refuse when full, no billing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="820" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
