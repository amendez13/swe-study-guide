<mxCell id="d1216" value="adding a keypad: one class + one arm in the factory" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="286" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="d1217" value="If admit, lockout, and logging are a fixed skeleton, make open_session a hook a Reader subclass overrides (the factory method)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="d1218" value="&lt;b&gt;Answer:&lt;/b&gt; Move the branch into open_session(kind) and have callers ask valid() on whatever comes back. admit(&#x27;qr&#x27;) → True." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
