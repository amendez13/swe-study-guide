<mxCell id="ps1-39" value="run[i] = sum of nums[0..i] · range = run[j] − run[i − 1] · run[3] − run[0] = 12 − 4 = 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="ps1-40" value="i = 0 without a branch reads run[−1], the LAST value: run[2] − run[−1] = 6 − 10 = −4, no error raised" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="ps1-41" value="Build: one pass, O(n) time and O(n) memory · each range: two lookups, O(1) · accumulate(nums, initial=0) builds the same array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="820" height="50" as="geometry"/></mxCell>
