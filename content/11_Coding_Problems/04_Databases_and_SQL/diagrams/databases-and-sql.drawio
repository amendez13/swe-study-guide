<mxCell id="q72" value="A CTE names an inner result so the outer query can read it twice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="q73" value="WITH&amp;nbsp;rev&amp;nbsp;AS&amp;nbsp;(&lt;br&gt;&amp;nbsp;&amp;nbsp;SELECT&amp;nbsp;p.id,&amp;nbsp;COALESCE(SUM(s.qty&amp;nbsp;*&amp;nbsp;pi.price_cents),&amp;nbsp;0)&amp;nbsp;AS&amp;nbsp;cents&lt;br&gt;&amp;nbsp;&amp;nbsp;FROM&amp;nbsp;potters&amp;nbsp;p&amp;nbsp;LEFT&amp;nbsp;JOIN&amp;nbsp;pieces&amp;nbsp;pi&amp;nbsp;…&lt;br&gt;&amp;nbsp;&amp;nbsp;LEFT&amp;nbsp;JOIN&amp;nbsp;sales&amp;nbsp;s&amp;nbsp;…&amp;nbsp;GROUP&amp;nbsp;BY&amp;nbsp;p.id)&lt;br&gt;SELECT&amp;nbsp;…&amp;nbsp;FROM&amp;nbsp;rev&lt;br&gt;WHERE&amp;nbsp;cents&amp;nbsp;&amp;gt;&amp;nbsp;(SELECT&amp;nbsp;AVG(cents)&amp;nbsp;FROM&amp;nbsp;rev);" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="460" height="104" as="geometry"/></mxCell>
