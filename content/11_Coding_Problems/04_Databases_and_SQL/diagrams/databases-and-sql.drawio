<mxCell id="q41" value="SELECT, INSERT, UPDATE, DELETE" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="q42" value="Say which rows a statement will touch before you write it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="q43" value="&lt;b&gt;SELECT&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;reads the matching rows&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;fontStyle=1;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="q44" value="&lt;b&gt;INSERT&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;adds a row; fails if a constraint fails&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;fontStyle=1;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="q45" value="&lt;b&gt;UPDATE … WHERE&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;changes the matching rows; no WHERE = every row&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;fontStyle=1;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="q46" value="&lt;b&gt;DELETE … WHERE&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;removes the matching rows; no WHERE = empties the table&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;fontStyle=1;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="400" height="36" as="geometry"/></mxCell>
