<mxCell id="q32" value="Alias a table to itself; use NOT EXISTS for “no partner”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="q33" value="FROM&amp;nbsp;potters&amp;nbsp;AS&amp;nbsp;a&lt;br&gt;JOIN&amp;nbsp;potters&amp;nbsp;AS&amp;nbsp;b&lt;br&gt;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;a.bench&amp;nbsp;=&amp;nbsp;b.bench&amp;nbsp;AND&amp;nbsp;a.id&amp;nbsp;&amp;lt;&amp;nbsp;b.id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="370" height="62" as="geometry"/></mxCell>
<mxCell id="q34" value="each pair once; nobody pairs with themself" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="400" height="18" as="geometry"/></mxCell>
