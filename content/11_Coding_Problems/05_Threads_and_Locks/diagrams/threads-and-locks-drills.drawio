<mxCell id="t1415" value="print (no lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="204" width="250" height="36" as="geometry"/></mxCell>
<mxCell id="t1416" value="lock · recheck row · write · unlock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="204" width="250" height="36" as="geometry"/></mxCell>
<mxCell id="t1417" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t1414" target="t1415"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1418" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t1415" target="t1416"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1419" value="&lt;b&gt;Answer:&lt;/b&gt; Move the print outside the lock; hold it only to read and to write. After the call, re-acquire and recheck that the row did not change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pooldl" name="Waiting on your own pool">
    <mxGraphModel dx="900" dy="386" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="386" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="t151" value="Waiting on your own pool" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="t152" value="A one-worker pool runs a task that submits a second task to the same pool and waits for it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t153" value="the only worker&lt;br&gt;running task 1 → waits for task 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="240" height="56" as="geometry"/></mxCell>
<mxCell id="t154" value="queue: task 2&lt;br&gt;(needs a free worker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="200" height="56" as="geometry"/></mxCell>
<mxCell id="t155" value="waits for task 2" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;fontStyle=1;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="t153" target="t154"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t156" value="needs this worker" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="t154" target="t153"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t157" value="a larger pool makes it likely under load instead of certain" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="220" height="40" as="geometry"/></mxCell>
<mxCell id="t158" value="fix" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="220" height="26" as="geometry"/></mxCell>
<mxCell id="t159" value="how" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="214" width="600" height="26" as="geometry"/></mxCell>
<mxCell id="t1510" value="run inline" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="220" height="26" as="geometry"/></mxCell>
<mxCell id="t1511" value="do the second piece on the current thread" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="240" width="600" height="26" as="geometry"/></mxCell>
<mxCell id="t1512" value="another pool" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="220" height="26" as="geometry"/></mxCell>
<mxCell id="t1513" value="a separate executor for the sub-task" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="266" width="600" height="26" as="geometry"/></mxCell>
<mxCell id="t1514" value="return a future" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="220" height="26" as="geometry"/></mxCell>
<mxCell id="t1515" value="let the caller outside the pool wait" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="292" width="600" height="26" as="geometry"/></mxCell>
<mxCell id="t1516" value="&lt;b&gt;Answer:&lt;/b&gt; The only worker waits for work that needs that worker: a pool deadlock. Never wait on the same pool you are running on." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
