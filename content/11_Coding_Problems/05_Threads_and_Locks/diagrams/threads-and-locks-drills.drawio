<mxCell id="t161" value="Join sees the writes" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="t162" value="A thread fills a list; the caller reads it after join() returns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t163" value="caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110.0" y="104" width="140" height="30" as="geometry"/></mxCell>
<mxCell id="t164" value="worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410.0" y="104" width="140" height="30" as="geometry"/></mxCell>
<mxCell id="t165" value="" style="endArrow=none;html=1;strokeColor=#bbbbbb;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="134" as="sourcePoint"/><mxPoint x="180" y="266" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="t166" value="" style="endArrow=none;html=1;strokeColor=#bbbbbb;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="134" as="sourcePoint"/><mxPoint x="480" y="266" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="t167" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="152" as="sourcePoint"/><mxPoint x="480" y="152" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="t168" value="start()" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="184" y="136" width="292" height="15" as="geometry"/></mxCell>
<mxCell id="t169" value="box.append(1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="338.0" y="171" width="284" height="22" as="geometry"/></mxCell>
<mxCell id="t1610" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="212" as="sourcePoint"/><mxPoint x="180" y="212" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="t1611" value="last action → join() returns" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="184" y="196" width="292" height="15" as="geometry"/></mxCell>
<mxCell id="t1612" value="read box → [1] ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="38.0" y="231" width="284" height="22" as="geometry"/></mxCell>
<mxCell id="t1613" value="a read before join() has no edge: the list may be empty or half-updated" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="t1614" value="&lt;b&gt;Answer:&lt;/b&gt; join() is a publication edge for that thread&#x27;s work, so the read sees [1]. It is not a lock for later sharing with a third thread." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
