<mxCell id="h913" value="the loop retries until its swap wins: no lock, and someone always makes progress" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="820" height="18" as="geometry"/></mxCell>
