<mxCell id="h824" value="reads dominate and writes must not starve" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="254" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="h825" value="plain mutex" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="300" height="26" as="geometry"/></mxCell>
