<mxCell id="h718" value="the woken consumer goes back to sleep (why the wait is a loop)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="358" width="520" height="26" as="geometry"/></mxCell>
