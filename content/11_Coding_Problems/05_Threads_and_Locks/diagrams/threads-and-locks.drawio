<mxCell id="h711" value="dequeue, notify" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h74" target="h79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h712" value="producer:&amp;nbsp;make&amp;nbsp;item&amp;nbsp;|&amp;nbsp;lock&amp;nbsp;|&amp;nbsp;enqueue&amp;nbsp;|&amp;nbsp;notify&amp;nbsp;|&amp;nbsp;unlock&lt;br&gt;consumer:&amp;nbsp;lock&amp;nbsp;|&amp;nbsp;while&amp;nbsp;empty:&amp;nbsp;wait&amp;nbsp;|&amp;nbsp;dequeue&amp;nbsp;|&amp;nbsp;notify&amp;nbsp;|&amp;nbsp;unlock&amp;nbsp;|&amp;nbsp;use&amp;nbsp;item" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="820" height="46" as="geometry"/></mxCell>
