<mxCell id="h1415" value="volatile&amp;nbsp;boolean&lt;br&gt;&amp;nbsp;&amp;nbsp;shutdown&amp;nbsp;=&amp;nbsp;false;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="680" y="96" width="180" height="40" as="geometry"/></mxCell>
