<mxCell id="h1117" value="&lt;b&gt;circular wait&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:10px&#x27;&gt;the waits form a cycle&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="248" width="170" height="42" as="geometry"/></mxCell>
<mxCell id="h1118" value="a global lock order ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="248" width="140" height="42" as="geometry"/></mxCell>
