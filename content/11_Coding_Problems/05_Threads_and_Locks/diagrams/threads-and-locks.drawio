<mxCell id="h828" value="a single counter (never an RW lock)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="306" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="h829" value="Java: ReentrantReadWriteLock. Starvation is not deadlock: nobody is in a cycle, the writer is just never chosen." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="820" height="18" as="geometry"/></mxCell>
