<mxCell id="t1316" value="build a fresh store per test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="264" width="280" height="32" as="geometry"/></mxCell>
<mxCell id="t1317" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t1315" target="t1316"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
