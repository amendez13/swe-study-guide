<mxCell id="t41" value="Black-box vs white-box" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="t42" value="Write cases from the promise first; then look inside for paths the promise did not force you to hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t43" value="Black box: from the promise" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="390" height="18" as="geometry"/></mxCell>
<mxCell id="t44" value="“members are free through 2 hours”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="380" height="36" as="geometry"/></mxCell>
<mxCell id="t45" value="try 2 → 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="180" height="36" as="geometry"/></mxCell>
<mxCell id="t46" value="try 3 → 75" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="176" width="180" height="36" as="geometry"/></mxCell>
<mxCell id="t47" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t45" target="t46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t48" value="documents what callers may rely on" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="t49" value="White box: from reading the code" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="98" width="390" height="18" as="geometry"/></mxCell>
<mxCell id="t410" value="if&amp;nbsp;hours&amp;nbsp;&amp;lt;&amp;nbsp;0:&amp;nbsp;raise&amp;nbsp;ValueError&lt;br&gt;raw&amp;nbsp;=&amp;nbsp;max(0,&amp;nbsp;hours-2)*75&amp;nbsp;if&amp;nbsp;member&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;else&amp;nbsp;hours*100&lt;br&gt;return&amp;nbsp;min(raw,&amp;nbsp;1500)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470" y="124" width="390" height="80" as="geometry"/></mxCell>
<mxCell id="t411" value="→ cover the raise path and the min() cap path" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="212" width="390" height="18" as="geometry"/></mxCell>
<mxCell id="t412" value="✗ Starting from the code repeats the implementation and stays green across a wrong formula. ✗ Asserting a private counter moved breaks on a correct refactor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="t413" value="Look inside to find untested paths, then assert the caller-visible result of that path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
