<mxCell id="t1319" value="stub or fake the neighbor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="304" width="280" height="32" as="geometry"/></mxCell>
<mxCell id="t1320" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t1318" target="t1319"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1321" value="desk_open() with now()" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="104" width="180" height="16" as="geometry"/></mxCell>
<mxCell id="t1322" value="09:00 → pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="124" width="180" height="30" as="geometry"/></mxCell>
<mxCell id="t1323" value="20:00 → FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="180" height="30" as="geometry"/></mxCell>
<mxCell id="t1324" value="same code, different result" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=10;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="680" y="196" width="180" height="16" as="geometry"/></mxCell>
<mxCell id="t1325" value="desk_open(hour) asserts both" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="224" width="180" height="16" as="geometry"/></mxCell>
<mxCell id="t1326" value="9 → True, 20 → False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="244" width="180" height="30" as="geometry"/></mxCell>
<mxCell id="t1327" value="Retrying until green hides the cause; quarantine is a label to keep the suite usable, not a fix." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="820" height="34" as="geometry"/></mxCell>
