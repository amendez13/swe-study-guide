<mxCell id="t1312" value="sleep(“long enough”)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="240" height="32" as="geometry"/></mxCell>
