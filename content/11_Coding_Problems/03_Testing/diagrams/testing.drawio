<mxCell id="t11" value="What the interviewer is looking for" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="t12" value="Graded on the cases you choose and why, not on the framework name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t13" value="&lt;b&gt;the promise&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;members free through 2 h; guests pay from hour 1; cap 1500&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="84" as="geometry"/></mxCell>
<mxCell id="t14" value="&lt;b&gt;one ordinary case&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;guest, 5 h → 500&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="207" y="110" width="150" height="84" as="geometry"/></mxCell>
<mxCell id="t15" value="&lt;b&gt;boundaries between cases&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;member 2 h → 0, 3 h → 75&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="374" y="110" width="150" height="84" as="geometry"/></mxCell>
<mxCell id="t16" value="&lt;b&gt;one refusal&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;−1 hours → ValueError&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="541" y="110" width="150" height="84" as="geometry"/></mxCell>
<mxCell id="t17" value="&lt;b&gt;which layer runs it&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;function tests; one end-to-end checkout&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708" y="110" width="150" height="84" as="geometry"/></mxCell>
<mxCell id="t18" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t13" target="t14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t19" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t14" target="t15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t110" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t15" target="t16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t111" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t16" target="t17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t112" value="✗ thin answer: “I&#x27;d use pytest, aim for 90% coverage, write happy-path tests.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="t113" value="✓ “Members pay nothing for the first two hours, so I want the last free hour and the first paid hour. Nobody pays more than the cap. A negative hour is an error.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
