    </mxGraphModel>
  </diagram>
  <diagram id="load" name="Load and security basics">
    <mxGraphModel dx="900" dy="358" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="358" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="t141" value="Load and security basics" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="t142" value="A load check needs a workload and a pass line. Security cases here are refusals you can state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t143" value="Load" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="t144" value="&lt;b&gt;workload&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;which calls, which data, how much concurrency&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="t145" value="&lt;b&gt;pass line&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;50 checkouts/s, p95 under 200 ms, or it fails&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="t146" value="&lt;b&gt;failure you care about&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;latency, errors, or every locker full&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="t147" value="&lt;b&gt;not measured&lt;/b&gt;: &lt;span style=&#x27;font-weight:normal&#x27;&gt;the fee formula (that is a unit test)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=left;fontStyle=1;fontColor=#aaaaaa;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="t148" value="Security: refusals" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="98" width="390" height="18" as="geometry"/></mxCell>
<mxCell id="t149" value="input" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="124" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="t1410" value="expected" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="124" width="190" height="26" as="geometry"/></mxCell>
<mxCell id="t1411" value="another member&#x27;s code" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="t1412" value="refused, latch stays shut" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="670" y="150" width="190" height="26" as="geometry"/></mxCell>
<mxCell id="t1413" value="overlong locker code" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="176" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="t1414" value="rejected" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="670" y="176" width="190" height="26" as="geometry"/></mxCell>
<mxCell id="t1415" value="negative fee percent" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="202" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="t1416" value="no credit to the member" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="670" y="202" width="190" height="26" as="geometry"/></mxCell>
<mxCell id="t1417" value="non-attendant marks a locker free" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="228" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="t1418" value="refused" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="670" y="228" width="190" height="26" as="geometry"/></mxCell>
<mxCell id="t1419" value="One person refreshing a page is not a load test: there is no concurrency and no number that can fail." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="trouble" name="Troubleshooting questions">
    <mxGraphModel dx="900" dy="388" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="388" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="t151" value="Troubleshooting questions" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="t152" value="A symptom is a claim to pin down, not a cue for a one-line patch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t153" value="“Members are sometimes charged&lt;br&gt;for the first two hours.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="250" height="64" as="geometry"/></mxCell>
<mxCell id="t154" value="Who is charged, and for which stay (0, 1, or 2 h)?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="104" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="t155" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t153" target="t154"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t156" value="Any free window, or exactly the first two hours?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="148" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="t157" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t153" target="t156"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t158" value="Is a guest path mixed in?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="192" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="t159" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t153" target="t158"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1510" value="Receipt, ledger, or both?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="236" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="t1511" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t153" target="t1510"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1512" value="Can we name one member and one hour that shows it?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="280" width="400" height="36" as="geometry"/></mxCell>
<mxCell id="t1513" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t153" target="t1512"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1514" value="Cannot reproduce yet? Add a log or counter at the boundary, not a rewrite. Guessing “the comparison is wrong” before you know the layer is how a display bug gets a fee patch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="seq" name="A troubleshooting sequence">
    <mxGraphModel dx="900" dy="360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="t161" value="A troubleshooting sequence" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="t162" value="Same order every time, and say which step you are on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t163" value="1 expected vs reported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="t164" value="2 reproduce, or admit you cannot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="207" y="104" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="t165" value="3 narrow the layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="374" y="104" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="t166" value="4 check the boundary the symptom names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="541" y="104" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="t167" value="5 smallest fix + a test that was red" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708" y="104" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="t168" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t163" target="t164"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t169" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t164" target="t165"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1610" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t165" target="t166"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1611" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t166" target="t167"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
