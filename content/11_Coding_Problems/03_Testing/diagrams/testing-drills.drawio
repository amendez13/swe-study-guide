<mxCell id="u1134" value="same at 09:00 and at 20:00; it asserts both sides" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="390" height="36" as="geometry"/></mxCell>
<mxCell id="u1135" value="&lt;b&gt;Answer:&lt;/b&gt; datetime.now() reads the outside world. Pass the hour in and assert both open at 9 and shut at 20; do not retry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="820" height="40" as="geometry"/></mxCell>
