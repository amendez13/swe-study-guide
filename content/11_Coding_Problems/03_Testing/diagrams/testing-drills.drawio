<mxCell id="u138" value="refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="140" height="38" as="geometry"/></mxCell>
