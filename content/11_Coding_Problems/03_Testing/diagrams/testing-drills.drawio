  <diagram id="sometimes" name="Sometimes charged">
    <mxGraphModel dx="900" dy="408" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="408" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="u141" value="Sometimes charged" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="u142" value="“Members are sometimes charged for the first two hours.” You have not seen the code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="u143" value="function returned 0,&lt;br&gt;ledger stored ≠ 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="u144" value="inspect the writer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="124" width="200" height="40" as="geometry"/></mxCell>
<mxCell id="u145" value="function returned&lt;br&gt;non-zero?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="u146" value="unit test at the free boundary (hour 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="210" width="240" height="56" as="geometry"/></mxCell>
<mxCell id="u147" value="ask for a sharper example" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="620" y="124" width="240" height="40" as="geometry"/></mxCell>
<mxCell id="u148" value="yes" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="u143" target="u144"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u149" value="no" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u143" target="u145"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u1410" value="yes" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#2d7a1f;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#2d7a1f;fontStyle=1;" edge="1" parent="1" source="u145" target="u146"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u1411" value="no" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u145" target="u147"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u1412" value="next_step(0, 75) → inspect the writer   ·   next_step(75, 75) → unit test at the free boundary" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="u1413" value="Ask first: which members, a 0/1/2-hour stay, receipt vs ledger, one member id to look up. Refuse to patch locker_fee yet." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="u1414" value="&lt;b&gt;Answer:&lt;/b&gt; Pin down who, which stay, and which layer; get one example. Do not patch the fee until you know where the 75 comes from." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tautology" name="A test that cannot catch the bug">
    <mxGraphModel dx="900" dy="318" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="318" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="u151" value="A test that cannot catch the bug" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="u152" value="The bug: hour 2 costs a member 75. The test asserts value == value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="u153" value="value&amp;nbsp;=&amp;nbsp;locker_fee(2,&amp;nbsp;member=True)&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;75&amp;nbsp;with&amp;nbsp;the&amp;nbsp;bug&lt;br&gt;assert&amp;nbsp;value&amp;nbsp;==&amp;nbsp;value&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;always&amp;nbsp;True" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="46" as="geometry"/></mxCell>
<mxCell id="u154" value="green ✗ (cannot fail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="114" width="200" height="38" as="geometry"/></mxCell>
<mxCell id="u155" value="assert&amp;nbsp;locker_fee(2,&amp;nbsp;member=True)&amp;nbsp;==&amp;nbsp;0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="u156" value="red on the bug ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="176" width="200" height="38" as="geometry"/></mxCell>
<mxCell id="u157" value="100% coverage is possible with the first test. Coverage is not a promise." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="u158" value="&lt;b&gt;Answer:&lt;/b&gt; value == value is true for every return value. Assert the promise: locker_fee(2, member=True) == 0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
