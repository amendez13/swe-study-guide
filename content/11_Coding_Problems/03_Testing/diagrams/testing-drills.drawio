<mxCell id="u612" value="&lt;b&gt;Answer:&lt;/b&gt; Seven calls: three member classes, three guest classes, one refusal. Say whether you are listing classes or edges." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="820" height="40" as="geometry"/></mxCell>
