<mxCell id="u1312" value="open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="210" width="140" height="38" as="geometry"/></mxCell>
<mxCell id="u1313" value="happy path" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u1311" target="u1312"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u1314" value="&lt;b&gt;Answer:&lt;/b&gt; A foreign code and a malformed (empty or overlong) code are both refused; assert the latch stays shut and the occupant is unchanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="820" height="40" as="geometry"/></mxCell>
