<mxCell id="u82" value="30 browser tests (one per hour) and 1 unit test. A one-character fee change takes 12 minutes to verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="u83" value="before" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="u84" value="30 browser tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="124" width="340" height="42" as="geometry"/></mxCell>
<mxCell id="u85" value="seams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130.0" y="172" width="200" height="42" as="geometry"/></mxCell>
<mxCell id="u86" value="1 unit test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170.0" y="220" width="120" height="42" as="geometry"/></mxCell>
<mxCell id="u87" value="after" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="98" width="390" height="18" as="geometry"/></mxCell>
<mxCell id="u88" value="1 browser checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600.0" y="124" width="130" height="42" as="geometry"/></mxCell>
<mxCell id="u89" value="seams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="555.0" y="172" width="220" height="42" as="geometry"/></mxCell>
<mxCell id="u810" value="6 function cases: h2 h3 h22 h23 guest15 negative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475.0" y="220" width="380" height="42" as="geometry"/></mxCell>
<mxCell id="u811" value="29 browser tests deleted as slow duplicates; function cases fail in milliseconds and name the hour" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="u812" value="&lt;b&gt;Answer:&lt;/b&gt; Move the hours into function tests (classes and boundary pairs); keep one browser checkout that shows a fee; delete the other 29." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="314" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="double" name="Stub, fake, or mock">
    <mxGraphModel dx="900" dy="416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="416" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="u91" value="Stub, fake, or mock" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="u92" value="checkout asks a clock, writes through a ledger, and asks a mailer to send a receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="u93" value="checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="170" height="44" as="geometry"/></mxCell>
<mxCell id="u94" value="&lt;b&gt;clock → stub&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;test: desk refuses after 18:00; needs a canned hour only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="u95" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="u93" target="u94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u96" value="&lt;b&gt;ledger → fake&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;test: a checkout loads back; the row must really round-trip&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="u97" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="u93" target="u96"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u98" value="&lt;b&gt;mailer → mock&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;test: a receipt goes out only when fee &gt; 0; the call is the promise&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="180" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="u99" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="u93" target="u98"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u910" value="card&#x27;s run: ledger.load(&#x27;ada&#x27;) → 225, mail.sent → [225]" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="u911" value="&lt;b&gt;Answer:&lt;/b&gt; Clock: stub. Ledger: fake (it must save and load). Mailer: mock or recorder. Mocking the ledger would skip the behavior that test needs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
