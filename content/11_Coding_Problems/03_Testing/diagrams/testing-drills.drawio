<mxCell id="u1217" value="yes" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="242" width="160" height="26" as="geometry"/></mxCell>
<mxCell id="u1218" value="also say what it will not claim: the fee formula stays a unit test" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="u1219" value="&lt;b&gt;Answer:&lt;/b&gt; The workload, the pass line, and the failure mode. One person refreshing has no concurrency and no number that can fail." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
