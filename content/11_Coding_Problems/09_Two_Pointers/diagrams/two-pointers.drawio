<mxCell id="t226" value="left += 1 — the smallest value is finished" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="312" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="t227" value="too high" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="t228" value="right -= 1 — the largest value is finished" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="338" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="t229" value="equal" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="t230" value="hit — or move both when you want every pair" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="364" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="t231" value="Guard with left &lt; right so a value is never paired with itself. Scan O(n), O(1) memory; sorting first costs O(n log n) and indexes into the copy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="36" as="geometry"/></mxCell>
