<mxCell id="t1128" value="after the hit (−2, 0, 2) move both inner indexes; moving only left lands on the second 0 and repeats it" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="276" width="420" height="40" as="geometry"/></mxCell>
