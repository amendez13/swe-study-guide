<mxCell id="t421" value="a" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=13;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="296" y="290" width="48" height="34" as="geometry"/></mxCell>
<mxCell id="t422" value="&quot;cba&quot;" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="290" width="110" height="34" as="geometry"/></mxCell>
<mxCell id="t423" value="no ascent → (None, None): reverse everything back to the first arrangement" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="290" width="480" height="34" as="geometry"/></mxCell>
<mxCell id="t424" value="Folding find and act into one loop saves no asymptotic time and destroys the evidence the second step needed. Two linear scans are still O(n)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="820" height="36" as="geometry"/></mxCell>
