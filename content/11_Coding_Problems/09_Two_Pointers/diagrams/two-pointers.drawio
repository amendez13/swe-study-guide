<mxCell id="t1132" value="O(n)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="t1133" value="3" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="386" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="t1134" value="O(n²)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="386" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="t1135" value="k" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="t1136" value="O(n^(k−1)) — fix one value, recurse on the suffix" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="412" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="t1137" value="Unix uniq collapses only adjacent duplicates — the same reason the sort comes first. A set of tuples deduplicates too, and hides the hashing and storage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="820" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
