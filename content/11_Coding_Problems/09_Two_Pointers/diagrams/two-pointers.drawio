<mxCell id="t1032" value="leftmost larger" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="290" width="110" height="32" as="geometry"/></mxCell>
<mxCell id="t1033" value="swap with the 3, then reverse → 3221 skips 2123 ✗" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="440" height="32" as="geometry"/></mxCell>
<mxCell id="t1034" value="O(n). A Python string is immutable, so the list copy is O(n) extra memory; on a caller-owned list it is O(1). Order is character-code order, so &quot;aA&quot; → &quot;Aa&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="820" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
