<mxCell id="t1231" value="Palindromes, containers, compaction, and next arrangements stay on two pointers — they are not complement lookups. Sorting to enable a scan costs O(n log n) and changes indexes unless you carry them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="820" height="40" as="geometry"/></mxCell>
