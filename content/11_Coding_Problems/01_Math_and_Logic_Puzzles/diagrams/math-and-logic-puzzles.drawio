<mxCell id="a759" value="one card has one suit: hearts and spades never overlap" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="252" width="400" height="16" as="geometry"/></mxCell>
