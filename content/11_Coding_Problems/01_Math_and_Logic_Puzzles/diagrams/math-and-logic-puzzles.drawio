<mxCell id="a68" value="first H (blue + green) = 2/4; both H (green) = 1/4 = 1/2 · 1/2 ✓" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="320" height="40" as="geometry"/></mxCell>
