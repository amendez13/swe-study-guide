<mxCell id="a620" value="two events that are functions of the same draw" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="450" y="386" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="a621" value="a shuffled card, then an independent coin" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="a622" value="a story that says “random” twice" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="450" y="412" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="a623" value="Independence is about information, not overlap: two flips can both be heads and still be independent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="820" height="34" as="geometry"/></mxCell>
