<mxCell id="b172" value="Every label is wrong. Draw one item from the bin labeled MIXED (it must be pure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b173" value="label: MIXED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="80" y="104" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="b174" value="actually: BOLTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="b175" value="label: NUTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="350" y="104" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="b176" value="actually: MIXED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="140" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="b177" value="label: BOLTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="620" y="104" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="b178" value="actually: NUTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="b179" value="1. draw a bolt from “MIXED” → it is BOLTS (a wrong label means it is pure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="226" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="b1710" value="2. “NUTS” is not nuts and not bolts (found) → MIXED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="226" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="b1711" value="3. the last bin, “BOLTS”, → NUTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="226" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="b1712" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b179" target="b1710"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b1713" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1710" target="b1711"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b1714" value="a nut instead swaps the two pure labels; the same chain fixes the rest" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="b1715" value="✗ sampling “BOLTS” or “NUTS” fails: that bin might be mixed, and one item from a mixture does not say which pure bin is which" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="b1716" value="&lt;b&gt;Answer:&lt;/b&gt; Sample MIXED. A bolt: MIXED→BOLTS, NUTS→MIXED, BOLTS→NUTS. A nut: MIXED→NUTS, BOLTS→MIXED, NUTS→BOLTS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="820" height="40" as="geometry"/></mxCell>
