  <diagram id="lcm" name="Divide before you multiply">
    <mxGraphModel dx="900" dy="366" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="366" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="b131" value="Divide before you multiply" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="b132" value="lcm(18, 24) = 18 / gcd · 24, with gcd(24, 18) = 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b133" value="24 = 1 · 18 + 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="36" as="geometry"/></mxCell>
<mxCell id="b134" value="18 = 3 · 6 + 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="230" height="36" as="geometry"/></mxCell>
<mxCell id="b135" value="gcd = 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="230" height="36" as="geometry"/></mxCell>
<mxCell id="b136" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b133" target="b134"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b137" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b134" target="b135"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b138" value="largest intermediate value" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="b139" value="divide first: 18/6 · 24" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="230" height="30" as="geometry"/></mxCell>
<mxCell id="b1310" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="196" width="60.0" height="30" as="geometry"/></mxCell>
<mxCell id="b1311" value="72 (the answer itself)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="348.0" y="196" width="320" height="30" as="geometry"/></mxCell>
<mxCell id="b1312" value="multiply first: 18 · 24 / 6" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="230" height="30" as="geometry"/></mxCell>
<mxCell id="b1313" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="236" width="360.0" height="30" as="geometry"/></mxCell>
<mxCell id="b1314" value="432" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="648.0" y="236" width="320" height="30" as="geometry"/></mxCell>
<mxCell id="b1315" value="same result; in a fixed-width type the larger product is the one that can overflow" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="b1316" value="&lt;b&gt;Answer:&lt;/b&gt; lcm = 18 / 6 · 24 = 72. Dividing first keeps every intermediate ≤ the answer; 18 · 24 = 432 is the risky step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="reduce" name="Reduce, then multiply">
    <mxGraphModel dx="900" dy="310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="310" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="b141" value="Reduce, then multiply" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="b142" value="(98 · 97) mod 17 without computing 98 · 97: (a · b) mod m = ((a mod m)(b mod m)) mod m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b143" value="98 = 5 · 17 + 13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="40" as="geometry"/></mxCell>
<mxCell id="b144" value="97 = 5 · 17 + 12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="250" height="40" as="geometry"/></mxCell>
<mxCell id="b145" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b143" target="b144"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b146" value="13 · 12 = 156" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="250" height="40" as="geometry"/></mxCell>
<mxCell id="b147" value="156 = 9 · 17 + 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="250" height="40" as="geometry"/></mxCell>
<mxCell id="b148" value="answer: 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="250" height="40" as="geometry"/></mxCell>
<mxCell id="b149" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b146" target="b147"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b1410" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b147" target="b148"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b1411" value="the final reduction is still needed: 156 is larger than 17" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="b1412" value="&lt;b&gt;Answer:&lt;/b&gt; 3. Reducing each factor keeps the multiply small and does not change the congruence class." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
