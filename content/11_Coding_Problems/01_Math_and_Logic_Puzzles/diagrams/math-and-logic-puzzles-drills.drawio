<mxCell id="b820" value="round n adds n − 1 → score(n) = 1 + n(n − 1)/2" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=14;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="b821" value="predict: score(6) = 11 + 5 = 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="390" height="40" as="geometry"/></mxCell>
<mxCell id="b822" value="check with the closed form: score(4) = 1 + 4·3/2 = 7 ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="390" height="40" as="geometry"/></mxCell>
<mxCell id="b823" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b821" target="b822"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b824" value="&lt;b&gt;Answer:&lt;/b&gt; score(n) = 1 + n(n − 1)/2; round 6 is 16. Differences growing by 1 mean a quadratic, like triangular numbers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
