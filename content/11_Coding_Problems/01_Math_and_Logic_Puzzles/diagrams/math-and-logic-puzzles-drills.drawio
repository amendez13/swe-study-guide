<mxCell id="b657" value="P(A or B) = 1/2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="188" width="300" height="34" as="geometry"/></mxCell>
<mxCell id="b658" value="question" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="b659" value="answer" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="b660" value="mutually exclusive?" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="b661" value="yes: one card, one suit" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="276" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="b662" value="independent?" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="b663" value="no: 0 ≠ 1/16, and a heart rules a spade out" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="302" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="b664" value="&lt;b&gt;Answer:&lt;/b&gt; Mutually exclusive and dependent. P(A and B) = 0, P(A)·P(B) = 1/16, P(A or B) = 1/2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="shuttle" name="Say the assumption before the average">
    <mxGraphModel dx="900" dy="388" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="388" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="b71" value="Say the assumption before the average" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="b72" value="A shuttle every 10 minutes on a fixed schedule; you arrive at a uniformly random minute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="b73" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="120" width="600" height="30" as="geometry"/></mxCell>
<mxCell id="b74" value="one fixed 10-minute gap" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="122" width="600" height="26" as="geometry"/></mxCell>
<mxCell id="b75" value="" style="ellipse;html=1;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="304.0" y="114" width="12" height="12" as="geometry"/></mxCell>
<mxCell id="b76" value="you arrive" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270.0" y="96" width="80" height="16" as="geometry"/></mxCell>
<mxCell id="b77" value="" style="endArrow=block;startArrow=block;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="172" as="sourcePoint"/><mxPoint x="700" y="172" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="b78" value="wait = 10 − arrival" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310.0" y="174" width="390.0" height="16" as="geometry"/></mxCell>
<mxCell id="b79" value="0 min" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="76.0" y="151" width="48" height="14" as="geometry"/></mxCell>
<mxCell id="b710" value="5 min" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="376.0" y="151" width="48" height="14" as="geometry"/></mxCell>
<mxCell id="b711" value="10 min" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="676.0" y="151" width="48" height="14" as="geometry"/></mxCell>
<mxCell id="b712" value="wait is uniform from 0 to 10 → average 5" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=13;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="196" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="b713" value="What you are not claiming (illustration): if the gaps varied, say 4 and 16 min (mean 10), you land in the 16 four times as often" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="b714" value="4-min gap: 20% of arrivals, mean wait 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="268" width="120.0" height="28" as="geometry"/></mxCell>
<mxCell id="b715" value="16-min gap: 80% of arrivals, mean wait 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220.0" y="268" width="480.0" height="28" as="geometry"/></mxCell>
<mxCell id="b716" value="average wait 0.2·2 + 0.8·8 = 6.8 min &gt; half the mean gap" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="302" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="b717" value="&lt;b&gt;Answer:&lt;/b&gt; Say “one fixed 10-minute gap, uniform arrival, no random headway”. Under that model the average wait is 5 minutes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
