<mxCell id="ic7-47" value="an arrow at the first end hits every balloon that overlaps it: they end no earlier and start at or before that end; a point earlier than the end can miss one that starts there" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="348" width="820" height="40" as="geometry"/></mxCell>
