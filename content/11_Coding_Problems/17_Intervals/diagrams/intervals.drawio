<mxCell id="ic6-67" value="[5, 8)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="491" y="330" width="175" height="24" as="geometry"/></mxCell>
<mxCell id="ic6-68" value="[8, 10)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="665" y="330" width="116" height="24" as="geometry"/></mxCell>
<mxCell id="ic6-69" value="half-open: start &gt;= last keeps all three → remove 0 · closed: start &gt; last drops (5, 8) → remove 1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="ic6-70" value="exchange: the greedy interval ends no later than the optimal first one, so every later optimal interval still fits — swap it in, same size, repeat on the suffix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="ic6-71" value="[] → 0 · one interval → 0 · the exchange needs equal weights; a weighted version is a different problem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="ic6-72" value="Sort O(n log n) time, O(n) extra; the scan is O(n) time, O(1) extra." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="820" height="32" as="geometry"/></mxCell>
