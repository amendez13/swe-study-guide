<mxCell id="hp5-13" value="lower (max)" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="244" width="130" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-14" value="upper (min)" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="244" width="130" height="28" as="geometry"/></mxCell>
