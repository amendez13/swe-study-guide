<mxCell id="hp2-5" value="(count, word) heap root" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="126" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-6" value="Weaker heap root" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="126" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-7" value="apple" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="154" width="160" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-8" value="(2, apple)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="154" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-9" value="apple" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="530" y="154" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-10" value="fig" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="182" width="160" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-11" value="(2, apple) — earlier word compares smaller" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="182" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-12" value="fig — the later word is weaker" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="530" y="182" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-13" value="pear" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="160" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-14" value="(2, pear) &gt; root → apple is dropped" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="210" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-15" value="fig is not worse than pear → no change" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="530" y="210" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-16" value="reversed pops" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#f5f5f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="160" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-17" value="[&#x27;pear&#x27;, &#x27;fig&#x27;]  ✗" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="200" y="238" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-18" value="[&#x27;apple&#x27;, &#x27;fig&#x27;]  ✓" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="530" y="238" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="hp2-19" value="__lt__ = lower count, or the same count and a later word; replace the root only when it is worse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="hp2-20" value="(-count, word) already pops in report order — but -&quot;pear&quot; raises TypeError on a string key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="280" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="hp2-21" value="A dict payload needs (priority, counter, payload) so heapq never compares the dicts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="hp2-22" value="Size-k scan: O(n log k) time, O(k) extra memory. (count, word) still runs — it fails the tie." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="820" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
