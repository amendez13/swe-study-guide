<mxCell id="hp5-5" value="place" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="120" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-6" value="value ≤ lower root → lower heap (negated); otherwise → upper heap" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="160" y="124" width="700" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-7" value="fix" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="120" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-8" value="lower more than one ahead → move its root up; upper longer → move its root down" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="160" y="152" width="700" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-9" value="read" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="120" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-10" value="sizes differ → lower root; sizes equal → float average of both roots" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="160" y="180" width="700" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-11" value="arrivals 1, 9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="400" height="20" as="geometry"/></mxCell>
