<mxCell id="hp5-19" value="1.0" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="272" width="160" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-20" value="9" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="100" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-21" value="[1]" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="130" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-22" value="[9]  (9 &gt; 1)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="130" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-23" value="(1 + 9) / 2 = 5.0" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="160" height="28" as="geometry"/></mxCell>
<mxCell id="hp5-24" value="bug: both pushed to the lower heap, no fix&lt;br&gt;lower root = 9 → median reads 9, not 5.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="244" width="260" height="84" as="geometry"/></mxCell>
<mxCell id="hp5-25" value="invariant: sizes equal or lower one ahead · every lower value ≤ every upper value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="hp5-26" value="Add O(log n), read O(1), memory O(n). An insert moves one value at most once. No arrivals → no median." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="820" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
