<mxCell id="dp3-2" value="Top-down and bottom-up" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="dp3-3" value="same recurrence, two ways to evaluate it: ways(n, k) = ways(n − 1, k − 1) + ways(n − 1, k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="dp3-4" value="&lt;b&gt;Top-down&lt;/b&gt;&lt;br&gt;recursion + cache (lru_cache)&lt;br&gt;visits only the states it needs&lt;br&gt;Python depth limit ≈ 1,000 frames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="dp3-5" value="&lt;b&gt;Bottom-up&lt;/b&gt;&lt;br&gt;table filled in dependency order&lt;br&gt;no recursion, no call overhead&lt;br&gt;row n − 1 before row n" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="400" height="90" as="geometry"/></mxCell>
