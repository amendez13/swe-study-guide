<mxCell id="h1515" value="quickselect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="160" height="38" as="geometry"/></mxCell>
<mxCell id="h1516" value="a pivot off by one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="210" y="220" width="240" height="38" as="geometry"/></mxCell>
