<mxCell id="h12" value="Write the correct slow answer, then remove one layer of repeated work at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h13" value="O(n²): every pair" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="h14" value="|1 − 5| = 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="200" height="32" as="geometry"/></mxCell>
<mxCell id="h15" value="|1 − 6| = 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="200" height="32" as="geometry"/></mxCell>
<mxCell id="h16" value="|5 − 6| = 1 ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="32" as="geometry"/></mxCell>
