<mxCell id="h1513" value="test end-of-word" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="172" width="240" height="38" as="geometry"/></mxCell>
