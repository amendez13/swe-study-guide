<mxCell id="h1519" value="fast pair check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="160" height="38" as="geometry"/></mxCell>
<mxCell id="h1520" value="a neighbor test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="210" y="268" width="240" height="38" as="geometry"/></mxCell>
<mxCell id="h1521" value="the O(n²) specification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="268" width="240" height="38" as="geometry"/></mxCell>
