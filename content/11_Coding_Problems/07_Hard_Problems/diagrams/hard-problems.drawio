<mxCell id="h154" value="candidate" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="98" width="240" height="18" as="geometry"/></mxCell>
<mxCell id="h155" value="check" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="98" width="240" height="18" as="geometry"/></mxCell>
<mxCell id="h156" value="honest “none”" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="98" width="150" height="18" as="geometry"/></mxCell>
<mxCell id="h157" value="majority vote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="160" height="38" as="geometry"/></mxCell>
<mxCell id="h158" value="a value that might not be a majority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="210" y="124" width="240" height="38" as="geometry"/></mxCell>
<mxCell id="h159" value="count it in a second pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="124" width="240" height="38" as="geometry"/></mxCell>
<mxCell id="h1510" value="no majority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="710" y="124" width="150" height="38" as="geometry"/></mxCell>
