<mxCell id="n132" value="32-bit ids: how much memory, and does a hash map fit on a laptop?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="n133" value="1,000,000 ids" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="170" height="30" as="geometry"/></mxCell>
<mxCell id="n134" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="120" width="277.2" height="30" as="geometry"/></mxCell>
<mxCell id="n135" value="× 4 B = 4,000,000 B ≈ 4 MB (+ map overhead)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505.2" y="120" width="320" height="30" as="geometry"/></mxCell>
<mxCell id="n136" value="1,000,000,000 ids" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="170" height="30" as="geometry"/></mxCell>
<mxCell id="n137" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="164" width="403.2" height="30" as="geometry"/></mxCell>
<mxCell id="n138" value="≈ 4 GB before overhead: ask if it fits" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="631.2" y="164" width="320" height="30" as="geometry"/></mxCell>
<mxCell id="n139" value="2^20 ≈ a million: the estimate to say out loud" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="n1310" value="&lt;b&gt;Answer:&lt;/b&gt; About 4 MB plus a constant-factor overhead: it fits easily, so a hash map is allowed. A billion ids is where you stop and check." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
