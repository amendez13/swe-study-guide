<mxCell id="n103" value="locked" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="120" height="44" as="geometry"/></mxCell>
<mxCell id="n104" value="open" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="230" y="130" width="120" height="44" as="geometry"/></mxCell>
<mxCell id="n105" value="badge" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n103" target="n104"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n106" value="locked" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="120" height="44" as="geometry"/></mxCell>
<mxCell id="n107" value="pass" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n104" target="n106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n108" value="open" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="120" height="44" as="geometry"/></mxCell>
<mxCell id="n109" value="badge" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n106" target="n108"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n1010" value="alarm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="120" height="44" as="geometry"/></mxCell>
