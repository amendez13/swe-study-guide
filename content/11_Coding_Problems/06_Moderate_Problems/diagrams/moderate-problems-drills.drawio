<mxCell id="n1225" value="9 does not divide 12 ✗" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="236" width="260" height="26" as="geometry"/></mxCell>
<mxCell id="n1226" value="&lt;b&gt;Answer:&lt;/b&gt; 6 feet: Euclid goes (18, 12) → (12, 6) → (6, 0). 9 leaves 3 feet on the 12-foot spool. O(log min(a, b))." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="820" height="40" as="geometry"/></mxCell>
