<mxCell id="n1518" value="&lt;b&gt;Answer:&lt;/b&gt; 4. One modulo is O(1); Python&#x27;s % already wraps negatives to 11." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="820" height="40" as="geometry"/></mxCell>
