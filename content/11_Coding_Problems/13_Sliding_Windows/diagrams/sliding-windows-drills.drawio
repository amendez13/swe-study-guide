<mxCell id="x928" value="explicit zeros on both sides" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="270" width="160" height="28" as="geometry"/></mxCell>
<mxCell id="x929" value="collections.Counter would also report 1 — Counter equality ignores zero counts. Know which mapping you compared." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="x930" value="&lt;b&gt;Answer:&lt;/b&gt; The leftover c: 0 breaks dict equality. Delete the key at 0, or compare 26-slot arrays: both return 1 and 1. O(n), O(1) for lowercase." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="820" height="40" as="geometry"/></mxCell>
