<mxCell id="w1030" value="block maximum: [8, 3, 5] → 8, then [3, 5, 1] → 5 — a stored 8 has no subtraction repair → monotonic deque" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="820" height="18" as="geometry"/></mxCell>
