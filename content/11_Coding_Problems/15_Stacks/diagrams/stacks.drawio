<mxCell id="s463" value="Amortized O(1) still allows one O(n) call — a pour of n values. Worst-case O(1) per call is a ring buffer. Rebuilding a string on every cancelled pair is the genuinely quadratic version." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="820" height="40" as="geometry"/></mxCell>
