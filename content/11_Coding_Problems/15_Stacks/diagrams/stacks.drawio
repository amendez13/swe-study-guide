<mxCell id="s11" value="When a stack fits" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="s12" value="Change one end only: push, pop, peek, empty — each O(1); the value you take off is the last one put on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="s13" value="type-a" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="202" width="100" height="28" as="geometry"/></mxCell>
<mxCell id="s14" value="type-b" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="174" width="100" height="28" as="geometry"/></mxCell>
<mxCell id="s15" value="delete" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="146" width="100" height="28" as="geometry"/></mxCell>
<mxCell id="s16" value="" style="endArrow=none;html=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="76" y="230" as="sourcePoint"/><mxPoint x="184" y="230" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="s17" value="undo stack (top = latest)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="234" width="140" height="16" as="geometry"/></mxCell>
<mxCell id="s18" value="pop → delete, type-b, type-a" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=12;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="150" width="240" height="30" as="geometry"/></mxCell>
<mxCell id="s19" value="matching&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;a closer pairs with the opener still open: brackets, tags, indentation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="96" width="390" height="52" as="geometry"/></mxCell>
<mxCell id="s110" value="undo&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;remove the latest action&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="154" width="390" height="52" as="geometry"/></mxCell>
<mxCell id="s111" value="deferred work&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;a value waits for a later event: next larger reading, a queue built from stacks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="212" width="390" height="52" as="geometry"/></mxCell>
<mxCell id="s112" value="reversal&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;pouring one stack into another flips the order&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="270" width="390" height="52" as="geometry"/></mxCell>
<mxCell id="s113" value="real stack" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="260" height="28" as="geometry"/></mxCell>
