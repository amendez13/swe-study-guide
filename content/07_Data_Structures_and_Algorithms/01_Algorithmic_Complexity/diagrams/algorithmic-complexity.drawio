<mxCell id="a15c1" value="Stating complexity in interviews" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a15c2" value="A complete answer has four parts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="a15c3" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Time&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Courier New;font-size:11px&#x27;&gt;worst-case O(N²)&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="94" width="195" height="60" as="geometry"/></mxCell>
<mxCell id="a15c4" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Space&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Courier New;font-size:11px&#x27;&gt;O(1) extra&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="247" y="94" width="195" height="60" as="geometry"/></mxCell>
<mxCell id="a15c5" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Case&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Courier New;font-size:11px&#x27;&gt;expected = worst here&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="454" y="94" width="195" height="60" as="geometry"/></mxCell>
<mxCell id="a15c6" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Why&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Courier New;font-size:11px&#x27;&gt;nested loops over N&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="661" y="94" width="195" height="60" as="geometry"/></mxCell>
<mxCell id="a15c7" value="name the case only when best / worst / expected differ · tie the “why” to the code" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="a15c8" value="&lt;b&gt;✗ Bad&lt;/b&gt;&lt;br&gt;&lt;i&gt;“It&#x27;s basically fine, like O(N)ish.”&lt;/i&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;no case, no space, no reason, and probably wrong&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="a15c9" value="&lt;b&gt;✓ Good&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Worst-case time O(N²) from the nested loops; O(1) extra space; expected case same as worst here.”&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="196" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="a15c10" value="One-line justifications that work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a15c11" value="pattern in the code" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="300" height="26" as="geometry"/></mxCell>
