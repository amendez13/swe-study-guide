<mxCell id="a6c40" value="total = 5 × 3 = &lt;b&gt;15&lt;/b&gt; = A × B" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="258" width="400" height="20" as="geometry"/></mxCell>
<mxCell id="a6c41" value="for x in a:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; # A times...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;for y in b:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; #   ...B steps each&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;print(x, y)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="460" y="284" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="a6c42" value="Which one?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a6c43" value="Are the steps &lt;b&gt;independent&lt;/b&gt; or &lt;b&gt;nested&lt;/b&gt;?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="412" width="260" height="44" as="geometry"/></mxCell>
<mxCell id="a6c44" value="“do this, &lt;b&gt;then&lt;/b&gt; do that”&lt;br&gt;→ &lt;b&gt;add&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="476" width="260" height="48" as="geometry"/></mxCell>
<mxCell id="a6c45" value="“for &lt;b&gt;each&lt;/b&gt; time you do this, do that”&lt;br&gt;→ &lt;b&gt;multiply&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="560" y="476" width="260" height="48" as="geometry"/></mxCell>
<mxCell id="a6c46" value="sequential" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a6c43" target="a6c44"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a6c47" value="nested" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a6c43" target="a6c45"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a6c48" value="⚠️ Two different inputs give O(A + B) or O(A × B), not O(N) or O(N²). Only call it N² when both loops run over the same N." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="820" height="30" as="geometry"/></mxCell>
