<mxCell id="a12c35" value="✓ nested loop over a and b" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="590" y="464" width="270" height="26" as="geometry"/></mxCell>
