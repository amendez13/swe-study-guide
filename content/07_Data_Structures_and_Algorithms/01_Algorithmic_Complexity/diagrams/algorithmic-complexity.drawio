<mxCell id="a2c8" value="f(N): the real cost" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="134.9996725008129" width="120" height="20" as="geometry"/></mxCell>
<mxCell id="a2c9" value="&lt;font color=&#x27;#b85450&#x27;&gt;&lt;b&gt;- - -&lt;/b&gt; c₂·g(N): upper bound → &lt;b&gt;O(g)&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&amp;nbsp; &lt;font color=&#x27;#6c8ebf&#x27;&gt;&lt;b&gt;- - -&lt;/b&gt; c₁·g(N): lower bound → &lt;b&gt;Ω(g)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="480" height="20" as="geometry"/></mxCell>
<mxCell id="a2c10" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="153.0" y="80" as="sourcePoint"/><mxPoint x="153.0" y="370" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="a2c11" value="N₀" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="138.0" y="372" width="30" height="16" as="geometry"/></mxCell>
<mxCell id="a2c12" value="← bounds only need to hold for N ≥ N₀ (small inputs don&#x27;t count)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#888888;align=left;" vertex="1" parent="1"><mxGeometry x="171.0" y="372" width="300" height="16" as="geometry"/></mxCell>
<mxCell id="a2c13" value="f is squeezed between two multiples of g → &lt;b&gt;Θ(g)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="90" y="392" width="420" height="20" as="geometry"/></mxCell>
<mxCell id="a2c14" value="&lt;span style=&#x27;font-size:18px;font-family:Courier New&#x27;&gt;&lt;b&gt;O(g)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;upper bound&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;grows &lt;b&gt;at most&lt;/b&gt; as fast as g&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="300" height="86" as="geometry"/></mxCell>
<mxCell id="a2c15" value="&lt;span style=&#x27;font-size:18px;font-family:Courier New&#x27;&gt;&lt;b&gt;Ω(g)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;lower bound&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;grows &lt;b&gt;at least&lt;/b&gt; as fast as g&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="300" height="86" as="geometry"/></mxCell>
<mxCell id="a2c16" value="&lt;span style=&#x27;font-size:18px;font-family:Courier New&#x27;&gt;&lt;b&gt;Θ(g)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;tight bound&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;both at once: grows &lt;b&gt;exactly&lt;/b&gt; like g&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="300" height="86" as="geometry"/></mxCell>
<mxCell id="a2c17" value="If O and Ω match, Θ is that rate." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="372" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="a2c18" value="Example: merge sort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a2c19" value="&lt;b style=&#x27;font-family:Courier New&#x27;&gt;O(N log N)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;never worse than N log N&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="a2c20" value="+" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;color=#666666;" vertex="1" parent="1"><mxGeometry x="286" y="490" width="40" height="36" as="geometry"/></mxCell>
<mxCell id="a2c21" value="&lt;b style=&#x27;font-family:Courier New&#x27;&gt;Ω(N log N)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;never better than N log N, even on sorted input&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="482" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="a2c22" value="=" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;color=#666666;" vertex="1" parent="1"><mxGeometry x="576" y="490" width="40" height="36" as="geometry"/></mxCell>
<mxCell id="a2c23" value="&lt;b style=&#x27;font-family:Courier New&#x27;&gt;Θ(N log N)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;so the tight bound is N log N&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="482" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="a2c24" value="Everyday engineering talk says “O” and means the tight bound. Formal analysis keeps the three distinct." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="544" width="820" height="20" as="geometry"/></mxCell>
      </root>
