<mxCell id="a15c32" value="Checklist before you answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="534" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a15c33" value="☐ Two inputs? Use both sizes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="574" width="400" height="32" as="geometry"/></mxCell>
<mxCell id="a15c34" value="☐ Recursion? Count the call stack in space." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="574" width="400" height="32" as="geometry"/></mxCell>
<mxCell id="a15c35" value="☐ Occasional expensive step? Say “amortized”." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="614" width="400" height="32" as="geometry"/></mxCell>
<mxCell id="a15c36" value="☐ Dropped constants? Mention only if asked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="614" width="400" height="32" as="geometry"/></mxCell>
