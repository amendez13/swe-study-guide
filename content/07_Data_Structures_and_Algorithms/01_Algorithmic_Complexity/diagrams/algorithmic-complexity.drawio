<mxCell id="a1c5" value="N = 2,000" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="92" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="a1c6" value="doubling N…" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="92" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="a1c7" value="O(1)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontColor=#2d7a1f;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="170" height="28" as="geometry"/></mxCell>
