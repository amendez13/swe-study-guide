<mxCell id="a7c55" value="Resizes get &lt;b&gt;exponentially rarer&lt;/b&gt;: each one doubles the room before the next." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="670" y="204" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="a7c56" value="Add it up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a7c57" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;17 writes&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;1 per append&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="a7c58" value="+" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="286" y="404" width="40" height="36" as="geometry"/></mxCell>
<mxCell id="a7c59" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;31 copies&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;1 + 2 + 4 + 8 + 16&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="396" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="a7c60" value="=" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="576" y="404" width="40" height="36" as="geometry"/></mxCell>
<mxCell id="a7c61" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;48 total&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;≤ 3 × 17 = 51&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="396" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="a7c62" value="The copies form a geometric series: 1 + 2 + 4 + … + N &amp;lt; 2N. So N appends cost less than 3N in total: &lt;b&gt;O(1) amortized&lt;/b&gt; per append, even though one append can cost O(N)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="458" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="a7c63" value="Amortized ≠ average over random inputs: it is a guarantee about &lt;b&gt;any&lt;/b&gt; sequence of operations." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="820" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
