<mxCell id="a4c32" value="def sum_to(n):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if n == 0:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return n + sum_to(n - 1)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="a4c33" value="no lists allocated, yet…" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="a4c34" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;fillColor=none;strokeWidth=2.5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="316" width="190" height="128" as="geometry"/></mxCell>
<mxCell id="a4c35" value="sum_to(4)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="416" width="180" height="24" as="geometry"/></mxCell>
<mxCell id="a4c36" value="sum_to(3)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="392" width="180" height="24" as="geometry"/></mxCell>
<mxCell id="a4c37" value="sum_to(2)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="368" width="180" height="24" as="geometry"/></mxCell>
<mxCell id="a4c38" value="sum_to(1)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="344" width="180" height="24" as="geometry"/></mxCell>
<mxCell id="a4c39" value="sum_to(0)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="320" width="180" height="24" as="geometry"/></mxCell>
<mxCell id="a4c40" value="call stack at the deepest point of sum_to(4)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="370" y="446" width="210" height="30" as="geometry"/></mxCell>
<mxCell id="a4c41" value="N nested calls → N frames alive at once → &lt;b&gt;O(N) space&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Python stops at ~1000 frames (RecursionError), so deep recursion is a space problem before it is a time problem." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="260" height="110" as="geometry"/></mxCell>
