<mxCell id="a1c9" value="1" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="410" y="120" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="a1c10" value="no change" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="a1c11" value="O(log N)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="170" height="28" as="geometry"/></mxCell>
