<mxCell id="a1c13" value="≈ 11" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="410" y="148" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="a1c14" value="adds one step" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="148" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="a1c15" value="O(N)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="170" height="28" as="geometry"/></mxCell>
<mxCell id="a1c16" value="1,000" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="210" y="176" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="a1c17" value="2,000" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="410" y="176" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="a1c18" value="doubles the work" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="176" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="a1c19" value="O(N log N)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="170" height="28" as="geometry"/></mxCell>
