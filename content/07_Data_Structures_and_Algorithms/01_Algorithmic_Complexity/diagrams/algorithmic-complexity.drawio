<mxCell id="a3c48" value="pivot always the min or max" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="436" width="400" height="26" as="geometry"/></mxCell>
<mxCell id="a3c49" value="O(N²)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="620" y="436" width="240" height="26" as="geometry"/></mxCell>
<mxCell id="a3c50" value="&lt;b&gt;Why production code randomizes the pivot&lt;/b&gt; (or uses median-of-three): the worst case still exists, but no particular input can trigger it reliably, so it becomes astronomically unlikely." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="820" height="44" as="geometry"/></mxCell>
<mxCell id="a3c51" value="When the cases differ, say which one you mean: “expected O(N log N), worst case O(N²)”." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="528" width="820" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
