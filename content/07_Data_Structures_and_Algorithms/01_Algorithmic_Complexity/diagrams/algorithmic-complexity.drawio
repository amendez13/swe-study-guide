<mxCell id="a6c1" value="Multi-part algorithms: add vs. multiply" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="a6c2" value="&lt;b&gt;Sequential&lt;/b&gt;: do A, then do B → &lt;b&gt;O(A + B)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="400" height="34" as="geometry"/></mxCell>
<mxCell id="a6c3" value="&lt;b&gt;Nested&lt;/b&gt;: for each a, do all of B → &lt;b&gt;O(A × B)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="52" width="400" height="34" as="geometry"/></mxCell>
