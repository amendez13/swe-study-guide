<mxCell id="a12c33" value="O(A × B)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="464" width="230" height="26" as="geometry"/></mxCell>
