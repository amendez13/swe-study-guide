<mxCell id="a8c104" value="The base doesn&#x27;t matter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="346" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="a8c105" value="log₂ N = log₁₀ N / log₁₀ 2 ≈ 3.32 · log₁₀ N&lt;br&gt;&lt;br&gt;Changing the base only multiplies by a constant, and Big O drops constants. Halving, thirding, or dividing by any constant factor → &lt;b&gt;O(log N)&lt;/b&gt;." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="460" y="384" width="400" height="100" as="geometry"/></mxCell>
<mxCell id="a8c106" value="Spot it: the remaining work shrinks by a constant &lt;b&gt;factor&lt;/b&gt; each step (not by a constant amount)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="400" height="36" as="geometry"/></mxCell>
