<mxCell id="d4c12" value="N = 8" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="104" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="d4c13" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="150" as="sourcePoint"/><mxPoint x="360" y="184" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="d4c14" value="positives = new list in memory" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="370" y="154" width="220" height="24" as="geometry"/></mxCell>
<mxCell id="d4c15" value="&lt;b&gt;pass 2&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;sum, P ≤ N steps&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;align=right;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="d4c16" value="4" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="160" y="190" width="50" height="40" as="geometry"/></mxCell>
<mxCell id="d4c17" value="7" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="210" y="190" width="50" height="40" as="geometry"/></mxCell>
<mxCell id="d4c18" value="2" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="260" y="190" width="50" height="40" as="geometry"/></mxCell>
<mxCell id="d4c19" value="5" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="310" y="190" width="50" height="40" as="geometry"/></mxCell>
<mxCell id="d4c20" value="6" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="360" y="190" width="50" height="40" as="geometry"/></mxCell>
<mxCell id="d4c21" value="P = 5" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="190" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="d4c22" value="total steps = N + P = 8 + 5 = &lt;b&gt;13&lt;/b&gt; ≤ 2N" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="160" y="250" width="520" height="22" as="geometry"/></mxCell>
<mxCell id="d4c23" value="Add, don&#x27;t multiply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="d4c24" value="Pass 2 starts after pass 1 finishes. Nothing is repeated per element, so the costs add: O(N) + O(P) ≤ O(2N) = &lt;b&gt;O(N)&lt;/b&gt;." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="d4c25" value="Where the space goes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="290" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="d4c26" value="&lt;b&gt;positives&lt;/b&gt; can hold every element (if all are &amp;gt; 0) → &lt;b&gt;O(N) extra space&lt;/b&gt;. A single loop with a running total would need O(1)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="460" y="328" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="d4c27" value="&lt;b&gt;Answer:&lt;/b&gt; time O(N): two sequential O(N) passes add up. Space O(N) for the filtered list." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
