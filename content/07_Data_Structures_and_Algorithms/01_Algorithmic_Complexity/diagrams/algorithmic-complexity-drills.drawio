<mxCell id="d10c24" value="Cost per frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="92" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="d10c25" value="one comparison, one addition: O(1) work each.&lt;br&gt;&lt;br&gt;N frames × O(1) = &lt;b&gt;O(N) time&lt;/b&gt;.&lt;br&gt;Every frame waits on the stack → &lt;b&gt;O(N) space&lt;/b&gt;." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="d10c26" value="Python&#x27;s default recursion limit is about 1,000 frames: sum_to_zero(5000) raises RecursionError. A loop does the same job in O(1) space." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="d10c27" value="&lt;b&gt;Answer:&lt;/b&gt; time O(N), space O(N) for the call stack: N frames, constant work each." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
