<mxCell id="d14c32" value="1 call → 3 calls (3 first letters) → 6 leaves (2 second letters each; the last letter is forced): 3 × 2 × 1 = 3! = 6" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="d14c33" value="&lt;b&gt;How a result is built on the way back up&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="820" height="20" as="geometry"/></mxCell>
