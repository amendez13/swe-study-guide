<mxCell id="d1c29" value="Only the loop variable &lt;b&gt;x&lt;/b&gt; lives in memory: no copy of xs, no extra list, so space doesn&#x27;t grow with N → &lt;b&gt;O(1) extra space&lt;/b&gt;." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="d1c30" value="&lt;b&gt;Answer:&lt;/b&gt; worst-case time O(N), best case O(1) when xs[0] &amp;lt; 0; O(1) extra space. Quote the worst case unless asked for another." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="820" height="40" as="geometry"/></mxCell>
