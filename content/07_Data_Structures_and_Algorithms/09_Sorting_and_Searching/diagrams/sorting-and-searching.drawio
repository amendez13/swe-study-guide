<mxCell id="s841" value="(1,a) → slot start[1] = 1, then start[1] becomes 2" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="412" width="420" height="20" as="geometry"/></mxCell>
<mxCell id="s842" value="(3,d) → slot start[3] = 3, then start[3] becomes 4" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="432" width="420" height="20" as="geometry"/></mxCell>
<mxCell id="s843" value="(0,z) → slot start[0] = 0, then start[0] becomes 1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="452" width="420" height="20" as="geometry"/></mxCell>
<mxCell id="s844" value="walk the input left to right" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="184" height="20" as="geometry"/></mxCell>
<mxCell id="s845" value="(3,c) is placed before (3,d) because it comes first in the input and takes start[3] first: that is why counting sort is stable, and why radix sort can use it per digit." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="s846" value="Time and space O(N + K). Great when K = O(N) (ages, scores, digits); wasteful when K ≫ N (ten 64-bit IDs)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="radix" name="Radix sort">
    <mxGraphModel dx="900" dy="532" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="532" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
