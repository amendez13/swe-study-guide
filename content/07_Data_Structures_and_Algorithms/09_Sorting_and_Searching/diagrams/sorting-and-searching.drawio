<mxCell id="s557" value="Each row shows the ranges after partitioning (orange = that range&#x27;s pivot, now at its final index). Green = already final." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="s558" value="&lt;b&gt;Good pivots&lt;/b&gt;: each split is about half, log N levels × O(N) partition work = O(N log N)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="454" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="s559" value="&lt;b&gt;Bad pivots&lt;/b&gt; (sorted input, last-element pivot): each split peels off one value, N levels = O(N²). Random pivots make this vanishingly rare." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="460" y="454" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="s560" value="Average O(N log N), worst O(N²), O(log N) stack (recurse into the smaller side first). Not stable. Fast in practice thanks to cache locality." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
