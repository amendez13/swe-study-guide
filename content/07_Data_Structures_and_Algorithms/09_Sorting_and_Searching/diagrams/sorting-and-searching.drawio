<mxCell id="s964" value="Look at 2 and 802 after the tens pass: both have tens digit 0, and 802 stays ahead of 2 because it was ahead after the ones pass and the sort is stable. The hundreds pass then puts 2 first (hundreds digit 0)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="s965" value="cost" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="s966" value="why" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="392" width="620" height="26" as="geometry"/></mxCell>
<mxCell id="s967" value="time O(k · (N + b))" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="s968" value="k digit passes of counting sort over base b (here k = 3, b = 10)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="418" width="620" height="26" as="geometry"/></mxCell>
<mxCell id="s969" value="space O(N + b)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="s970" value="output array plus the count array" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240" y="444" width="620" height="26" as="geometry"/></mxCell>
<mxCell id="s971" value="Beats O(N log N) when the key width k is small: fixed-length IDs, IP addresses, fixed-width strings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
