<mxCell id="s457" value="each merge level touches all N values once: O(N) per level" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="302" width="260" height="44" as="geometry"/></mxCell>
<mxCell id="s458" value="&lt;b&gt;Merge step&lt;/b&gt;: two pointers walk the sorted halves and copy the smaller head. On a tie take the left one (&lt;b&gt;&amp;lt;=&lt;/b&gt;) to stay stable. [3, 27, 38, 43] + [9, 10, 82] → 3, 9, 10, 27, 38, 43, 82" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="s459" value="O(N log N) in every case, stable, O(N) extra space for arrays (only O(log N) stack when relinking list nodes)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
