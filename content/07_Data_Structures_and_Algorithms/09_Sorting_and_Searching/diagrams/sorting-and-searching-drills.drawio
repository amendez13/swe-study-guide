<mxCell id="t853" value="count_value(1234) = bisect_right − bisect_left = 3 − 3 = 0: both land on the same insertion point" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="t854" value="&lt;b&gt;Answer:&lt;/b&gt; Value: bisect_right(x) − bisect_left(x) = 3. Range [a, b]: bisect_right(b) − bisect_left(a) = 6. Two O(log N) searches each." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="820" height="40" as="geometry"/></mxCell>
