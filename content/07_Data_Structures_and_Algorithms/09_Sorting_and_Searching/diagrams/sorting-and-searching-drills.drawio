<mxCell id="t1534" value="Strings cannot be negated, so the Z → A order is set by the first sort and kept inside each points tie by the second, stable sort. (Both fields descending here, so reverse=True on (points, name) also works.)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="t1535" value="&lt;b&gt;Answer:&lt;/b&gt; sorted(rows, key=lambda r: (−r[1], r[0])); for names Z → A, sort by name reverse, then stable-sort by points reverse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
