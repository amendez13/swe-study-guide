<mxCell id="t283" value="Left: the 1 (orange) moves one slot left each pass, so passes 1–5 each swap once; the outer loop still runs pass 6, whose inner loop is empty. Right: the 6 rides to the end in one pass; pass 2 sees no swaps and exits." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="t284" value="&lt;b&gt;Answer:&lt;/b&gt; 6 passes for [2, 3, 4, 5, 6, 1] (the maximum); 2 passes for [6, 1, 2, 3, 4, 5]. Where the disorder sits matters, not how much." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="820" height="40" as="geometry"/></mxCell>
