<mxCell id="l8c24" value="Python&#x27;s recursion limit is about 1,000 frames, so reverse() on a 5,000-node list raises RecursionError. The iterative version uses O(1) space." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="820" height="36" as="geometry"/></mxCell>
