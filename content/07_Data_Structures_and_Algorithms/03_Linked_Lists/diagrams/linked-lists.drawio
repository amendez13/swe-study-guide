<mxCell id="l7c44" value="Why it works: if the tail before the cycle has length μ and the cycle has length λ, the meeting point sits μ steps (mod λ) before the entrance, so both pointers moving 1 step reach it together." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="l7c45" value="O(N) time, O(1) space. A visited set also works, but needs O(N) memory." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="820" height="18" as="geometry"/></mxCell>
