<mxCell id="l13c42" value="Without slow.next = None, node 3 still points at 4. After reversing the second half, 4.next becomes None but 3 → 4 survives, so the first half is 1 → 2 → 3 → 4 and the weave revisits 4 or loops forever." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="l13c43" value="Each step is one short loop you can test alone: find middle O(N), reverse O(N), weave O(N). Total O(N) time, O(1) space." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="446" width="820" height="20" as="geometry"/></mxCell>
