<mxCell id="l6c63" value="One pass, O(1) extra space, no need to count the length first." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="596" width="820" height="18" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
