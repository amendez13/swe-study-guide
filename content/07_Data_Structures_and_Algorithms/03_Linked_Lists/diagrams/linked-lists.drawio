<mxCell id="l8c1" value="Recursive list processing: reverse" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="l8c2" value="reverse(1 → 2 → 3): recurse to the end, then flip one pointer per frame on the way back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="l8c3" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;fillColor=none;strokeWidth=2.5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="l8c4" value="reverse(1)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="172" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="l8c5" value="reverse(2)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="138" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="l8c6" value="reverse(3)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="104" width="180" height="34" as="geometry"/></mxCell>
<mxCell id="l8c7" value="call stack: one frame per node → O(N) space" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="240" height="16" as="geometry"/></mxCell>
<mxCell id="l8c8" value="&lt;b&gt;reverse(3)&lt;/b&gt; returns" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=right;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="110" height="40" as="geometry"/></mxCell>
<mxCell id="l8c9" value="base case: 3.next is None → return 3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="440" height="40" as="geometry"/></mxCell>
<mxCell id="l8c10" value="&lt;b&gt;reverse(2)&lt;/b&gt; returns" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=right;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="300" y="156" width="110" height="40" as="geometry"/></mxCell>
<mxCell id="l8c11" value="head.next.next = head (3 → 2); head.next = None" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="420" y="156" width="440" height="40" as="geometry"/></mxCell>
<mxCell id="l8c12" value="&lt;b&gt;reverse(1)&lt;/b&gt; returns" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=right;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="300" y="212" width="110" height="40" as="geometry"/></mxCell>
<mxCell id="l8c13" value="head.next.next = head (2 → 1); head.next = None" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="420" y="212" width="440" height="40" as="geometry"/></mxCell>
