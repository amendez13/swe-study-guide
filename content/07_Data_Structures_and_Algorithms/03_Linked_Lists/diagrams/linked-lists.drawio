<mxCell id="l6c60" value="slow +1, fast +2; they meet only if there&#x27;s a loop" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="536" width="560" height="26" as="geometry"/></mxCell>
<mxCell id="l6c61" value="split for merge sort" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="562" width="260" height="26" as="geometry"/></mxCell>
