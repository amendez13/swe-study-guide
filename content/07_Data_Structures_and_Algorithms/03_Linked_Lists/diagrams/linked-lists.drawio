<mxCell id="l8c30" value="three pointers, a loop" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="550" y="456" width="310" height="26" as="geometry"/></mxCell>
