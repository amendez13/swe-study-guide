  <diagram id="recursion-depth" name="Recursion depth">
    <mxGraphModel dx="900" dy="516" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="516" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="m13c1" value="Recursion depth on a long list" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="m13c2" value="length(head) = 1 + length(head.next): one stack frame per node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="m13c3" value="" style="rounded=0;html=1;fillColor=#82b366;strokeColor=none;opacity=100;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="12.0" height="34" as="geometry"/></mxCell>
<mxCell id="m13c4" value="100 nodes" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;align=right;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="76" height="34" as="geometry"/></mxCell>
<mxCell id="m13c5" value="" style="rounded=0;html=1;fillColor=#b85450;strokeColor=none;opacity=40;" vertex="1" parent="1"><mxGeometry x="120" y="176" width="120.0" height="34" as="geometry"/></mxCell>
<mxCell id="m13c6" value="1,000 limit" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;align=right;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="76" height="34" as="geometry"/></mxCell>
<mxCell id="m13c7" value="" style="rounded=0;html=1;fillColor=#d79b00;strokeColor=none;opacity=100;" vertex="1" parent="1"><mxGeometry x="120" y="232" width="600.0" height="34" as="geometry"/></mxCell>
<mxCell id="m13c8" value="5,000 nodes" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;align=right;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="76" height="34" as="geometry"/></mxCell>
<mxCell id="m13c9" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240.0" y="112" as="sourcePoint"/><mxPoint x="240.0" y="290" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="m13c10" value="RecursionError around frame ~1,000" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#b85450;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="248.0" y="180" width="260" height="18" as="geometry"/></mxCell>
<mxCell id="m13c11" value="sys.setrecursionlimit only moves the wall, and a very deep C stack can crash the interpreter." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="m13c12" value="def length(head):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;n = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;while head:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;n += 1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;head = head.next&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return n" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="m13c13" value="Iterative: O(N) time, O(1) space, any length." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;fontColor=#2d7a1f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="480" height="30" as="geometry"/></mxCell>
<mxCell id="m13c14" value="&lt;b&gt;Answer:&lt;/b&gt; RecursionError: each node adds a frame and CPython&#x27;s default limit is about 1,000. Use an iterative loop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
