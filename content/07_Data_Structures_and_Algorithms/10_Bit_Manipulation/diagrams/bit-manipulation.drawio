  <diagram id="abs" name="Sign bit and branchless abs">
    <mxGraphModel dx="900" dy="670" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="670" math="0" shadow="0">
