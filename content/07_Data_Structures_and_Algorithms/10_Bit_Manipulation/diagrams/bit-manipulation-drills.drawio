<mxCell id="d9133" value="0x3A7FFF, green safe" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="774" y="270" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="d9134" value="&lt;b&gt;Answer:&lt;/b&gt; Green = (c &gt;&gt; 8) &amp; 0xFF = 127. set_blue clears the low byte and ORs in b &amp; 0xFF, so 0x1FF cannot spill into green." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="820" height="40" as="geometry"/></mxCell>
