<mxCell id="p64" value="&lt;b&gt;2  Hot spots&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;font-weight:normal&#x27;&gt;loop bounds, off-by-one, base cases, empty input&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="330" height="48" as="geometry"/></mxCell>
