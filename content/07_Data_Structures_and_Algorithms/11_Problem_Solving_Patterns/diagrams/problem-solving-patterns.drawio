<mxCell id="p2016" value="[3] is pruned: only 1 item would be left for a path that needs 2 (len(items) − i &lt; k − len(path)), so the loop breaks." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="p2017" value="if&amp;nbsp;len(path)&amp;nbsp;==&amp;nbsp;k:&amp;nbsp;record,&amp;nbsp;return&lt;br&gt;for&amp;nbsp;i&amp;nbsp;in&amp;nbsp;range(start,&amp;nbsp;len(items)):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;too&amp;nbsp;few&amp;nbsp;left:&amp;nbsp;break&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;prune&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;path.append(items[i])&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;choose&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;backtrack(i&amp;nbsp;+&amp;nbsp;1)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;explore&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;path.pop()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;unchoose" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470" y="316" width="390" height="110" as="geometry"/></mxCell>
