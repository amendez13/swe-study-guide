<mxCell id="h13c9" value="✗" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="244" y="182" width="86" height="16" as="geometry"/></mxCell>
<mxCell id="h13c10" value="dee: 64" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1"><mxGeometry x="336" y="146" width="86" height="34" as="geometry"/></mxCell>
<mxCell id="h13c11" value="✗" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="336" y="182" width="86" height="16" as="geometry"/></mxCell>
<mxCell id="h13c12" value="hash order is unrelated to score: all 4 must be checked" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="400" height="16" as="geometry"/></mxCell>
