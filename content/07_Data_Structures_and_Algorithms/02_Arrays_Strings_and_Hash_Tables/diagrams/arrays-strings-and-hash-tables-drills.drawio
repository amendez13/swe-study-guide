<mxCell id="h15c28" value="Why frozenset, not set? Dict keys must be hashable, so they must be immutable. set can change after insertion, so it can&#x27;t be a key." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="22" as="geometry"/></mxCell>
