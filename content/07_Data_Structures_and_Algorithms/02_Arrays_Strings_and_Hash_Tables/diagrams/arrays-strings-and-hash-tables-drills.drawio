<mxCell id="h13c39" value="O(log N + k)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="440" y="368" width="220" height="26" as="geometry"/></mxCell>
<mxCell id="h13c40" value="BST" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="368" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="h13c41" value="Java TreeMap, C++ std::map, Python sortedcontainers.SortedList. A plain sorted list has O(N) inserts; a BST keeps them O(log N)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="h13c42" value="&lt;b&gt;Answer:&lt;/b&gt; dict-only costs O(N log N) worst case per query. A BST map keyed by (score, player) answers in O(log N + k), with O(log N) updates; keep the dict for O(1) lookup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="446" width="820" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
