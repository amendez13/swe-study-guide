<mxCell id="h2c57" value="row i=0 ruled out by step 1:&lt;br&gt;2 + 13 is the biggest sum 2 can make" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="h2c58" value="Why moving left is safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="h2c59" value="The array is sorted, so 13 is the largest partner available. If 2 + 13 is still too small, 2 can&#x27;t reach 17 with &lt;b&gt;any&lt;/b&gt; partner: one comparison discards a whole row of pairs." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="h2c60" value="&lt;b&gt;Answer:&lt;/b&gt; returns (1, 4): 4 + 13. Each step discards a whole row or column of pairs: O(N) time, O(1) space." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
