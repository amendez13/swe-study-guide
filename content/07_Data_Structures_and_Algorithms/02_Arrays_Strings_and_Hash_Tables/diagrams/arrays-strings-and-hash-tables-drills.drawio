<mxCell id="h16c37" value="Real Rabin–Karp takes every hash mod a large prime so numbers stay small. Different windows can then share a hash (a collision), so a hash match is confirmed with a direct compare: text[1:4] == &quot;141&quot;." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="h16c38" value="&lt;b&gt;Answer:&lt;/b&gt; 314 → 141 → 415. The hash 141 equals the pattern&#x27;s at start index 1, so &quot;141&quot; matches there (confirmed by a direct compare)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="820" height="40" as="geometry"/></mxCell>
