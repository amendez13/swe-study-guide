  <diagram id="pair-sum-bug" name="Seen-set bug">
    <mxGraphModel dx="900" dy="430" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="430" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h8c1" value="Seen-set pair sum: spot the bug" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h8c2" value="pair_sum([3, 8], target = 6): the order of “store” and “check” decides the answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h8c3" value="&lt;b&gt;✗ store, then check&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="h8c4" value="j=0 x=3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;align=right;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="70" height="48" as="geometry"/></mxCell>
<mxCell id="h8c5" value="① store seen[3] = 0&lt;br&gt;② is 6 − 3 = 3 in seen? &lt;b&gt;yes&lt;/b&gt; (itself!)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="170" height="48" as="geometry"/></mxCell>
<mxCell id="h8c6" value="seen={3: 0}" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;fontColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="296" y="140" width="144" height="48" as="geometry"/></mxCell>
<mxCell id="h8c7" value="&lt;b&gt;returns (0, 0)&lt;/b&gt;: 3 paired with itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="h8c8" value="&lt;b&gt;✓ check, then store&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="h8c9" value="j=0 x=3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;align=right;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="70" height="48" as="geometry"/></mxCell>
<mxCell id="h8c10" value="① is 3 in seen? no&lt;br&gt;② store seen[3] = 0" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="170" height="48" as="geometry"/></mxCell>
<mxCell id="h8c11" value="seen={3: 0}" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;fontColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="716" y="140" width="144" height="48" as="geometry"/></mxCell>
<mxCell id="h8c12" value="j=1 x=8" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;align=right;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="460" y="198" width="70" height="48" as="geometry"/></mxCell>
<mxCell id="h8c13" value="① is −2 in seen? no&lt;br&gt;② store seen[8] = 1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="198" width="170" height="48" as="geometry"/></mxCell>
<mxCell id="h8c14" value="seen={3: 0, 8: 1}" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;fontColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="716" y="198" width="144" height="48" as="geometry"/></mxCell>
<mxCell id="h8c15" value="&lt;b&gt;returns None&lt;/b&gt;: correct, no valid pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d7a1f;fontSize=13;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="460" y="260" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="h8c16" value="Checking first means seen only holds &lt;b&gt;earlier&lt;/b&gt; indices, so a value can never pair with itself. A real duplicate still works: [3, 3] with target 6 → (0, 1)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="h8c17" value="&lt;b&gt;Answer:&lt;/b&gt; the buggy version returns (0, 0). Check for target − x before storing seen[x] = j. Still one pass: O(N) time, O(N) space." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
