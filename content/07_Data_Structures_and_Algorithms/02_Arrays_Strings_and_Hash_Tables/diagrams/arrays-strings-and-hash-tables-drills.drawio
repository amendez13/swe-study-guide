<mxCell id="h9c25" value="12 % 5 = 7 % 5 = 22 % 5 = 17 % 5 = 2 → four keys share one chain" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="334" width="500" height="18" as="geometry"/></mxCell>
<mxCell id="h9c26" value="Two lookups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="h9c27" value="&lt;b&gt;get(17)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;bucket 2 → compare 12, 7, 22, 17 → found on comparison 4&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="300" height="56" as="geometry"/></mxCell>
<mxCell id="h9c28" value="&lt;b&gt;get(2)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;2 % 5 = 2 → compare all 4 keys → miss&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="206" width="300" height="56" as="geometry"/></mxCell>
<mxCell id="h9c29" value="A miss always walks the whole chain. With good hashing chains stay ~load-factor long, so O(1) average; with keys like these one chain does all the work." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="272" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="h9c30" value="&lt;b&gt;Answer:&lt;/b&gt; get(17) makes 4 comparisons; get(2) also makes 4 and misses. A poor key spread turns O(1) average into a linear chain walk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
