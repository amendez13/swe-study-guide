<mxCell id="h1c45" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;15 &amp;lt; 2 × 9 = 18&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;a geometric series stays under 2N&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="442" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="h1c46" value="&lt;b&gt;Answer:&lt;/b&gt; 15 copies, final capacity 16. Copies stay under 2N, so append is amortized O(1) even though one resize is O(N)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="820" height="40" as="geometry"/></mxCell>
