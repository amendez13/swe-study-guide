<mxCell id="h12c54" value="An empty slot means “the probe chain ends here”. A tombstone means “something was here, keep looking”; inserts may reuse it." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="820" height="36" as="geometry"/></mxCell>
