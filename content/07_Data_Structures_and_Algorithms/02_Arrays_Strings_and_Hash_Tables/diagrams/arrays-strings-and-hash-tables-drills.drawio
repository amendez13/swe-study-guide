<mxCell id="h5c28" value="Each += allocates len(s) + 1 and copies the old string. join measures all parts, allocates once, copies once." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="260" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="h5c29" value="CPython sometimes extends s in place for +=; don&#x27;t rely on it. Java&#x27;s String never does (use StringBuilder)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="820" height="22" as="geometry"/></mxCell>
<mxCell id="h5c30" value="&lt;b&gt;Answer:&lt;/b&gt; 1 + 2 + … + 1000 = 500,500 copies → O(N²). &quot;&quot;.join copies about 1,000 → O(N)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="820" height="40" as="geometry"/></mxCell>
