<mxCell id="c15c36" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;compare hashes&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;w_hash == p_hash? one integer compare, O(1)&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;spacingLeft=18;spacingRight=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="264" height="72" as="geometry"/></mxCell>
<mxCell id="c15c37" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;confirm&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;if equal: text[start:start+3] == &quot;ana&quot;, O(m), catches collisions&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;spacingLeft=18;spacingRight=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="316" y="260" width="264" height="72" as="geometry"/></mxCell>
<mxCell id="c15c38" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;roll&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;w = (w − ord(left) · high) % mod;  w = (w · base + ord(right)) % mod&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;spacingLeft=18;spacingRight=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="592" y="260" width="264" height="72" as="geometry"/></mxCell>
<mxCell id="c15c39" value="base = 256, mod = 1,000,003, high = base&lt;sup&gt;m−1&lt;/sup&gt; % mod (the leftmost character&#x27;s weight)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="820" height="18" as="geometry"/></mxCell>
