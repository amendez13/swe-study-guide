<mxCell id="c2c38" value="Each step up is one O(N) copy. Doubling makes them exponentially rarer, so N appends cost &amp;lt; 3N in total: &lt;b&gt;amortized O(1)&lt;/b&gt; per append.&lt;br&gt;&lt;br&gt;CPython over-allocates by about 1.125× rather than 2×, so its jumps are smaller and more frequent, but the argument is the same: geometric growth." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="260" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
