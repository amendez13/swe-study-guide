<mxCell id="q6h10" value="class Rev:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def __init__(self, v): self.v = v&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;def __lt__(self, other):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return self.v &amp;gt; other.v   # reversed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="q6h11" value="heapq calls &amp;lt;, so the &quot;smallest&quot; Rev is the largest word: &quot;pear&quot; sits at the root." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="204" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="q6h12" value="pop order" style="text;html=1;whiteSpace=wrap;fontSize=11;align=right;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="134" y="344" width="100" height="30" as="geometry"/></mxCell>
<mxCell id="q6h13" value="&#x27;pear&#x27;" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="240" y="344" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="q6h14" value="&#x27;kiwi&#x27;" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="360" y="344" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="q6h15" value="&#x27;fig&#x27;" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="344" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="q6h16" value="&#x27;apple&#x27;" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="344" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="q6h17" value="&lt;b&gt;Answer:&lt;/b&gt; wrap in Rev (reversed __lt__): pops &#x27;pear&#x27;, &#x27;kiwi&#x27;, &#x27;fig&#x27;, &#x27;apple&#x27;. Works for any comparable type; for numbers, just negate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="394" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
