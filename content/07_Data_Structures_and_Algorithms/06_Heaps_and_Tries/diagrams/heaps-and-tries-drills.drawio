<mxCell id="q12h45" value="Why max? Each round swaps the largest to the end of the heap region, so the sorted part grows from the right with no extra memory." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="346" width="220" height="110" as="geometry"/></mxCell>
