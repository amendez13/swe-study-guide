<mxCell id="q11h26" value="(empty)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="160" y="356" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="q11h27" value="return None" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="360" y="356" width="260" height="28" as="geometry"/></mxCell>
<mxCell id="q11h28" value="Each entry is popped at most once, so the skips are paid for by earlier pushes: pops stay O(log N) amortized." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="660" y="216" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="q11h29" value="&lt;b&gt;Answer:&lt;/b&gt; remove + heapify is O(N) per cancel. Lazy deletion: O(1) cancel, and pops return [&#x27;j4&#x27;, &#x27;j1&#x27;, &#x27;j3&#x27;, None]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
