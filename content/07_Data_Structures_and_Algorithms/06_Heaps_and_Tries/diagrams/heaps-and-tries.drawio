  <diagram id="not-heap" name="When not to use a heap">
    <mxGraphModel dx="900" dy="450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h13c1" value="When not to use a heap" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h13c2" value="A heap fits one shape: items keep arriving and you repeatedly need the current extremum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h13c3" value="Need" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="h13c4" value="Better choice" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="96" width="240" height="28" as="geometry"/></mxCell>
<mxCell id="h13c5" value="Why" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="96" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="h13c6" value="the minimum once" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="h13c7" value="min(xs)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="124" width="240" height="28" as="geometry"/></mxCell>
<mxCell id="h13c8" value="O(N), no setup" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="124" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="h13c9" value="everything in order" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="h13c10" value="sorted(xs)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="152" width="240" height="28" as="geometry"/></mxCell>
<mxCell id="h13c11" value="same O(N log N), simpler" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="152" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="h13c12" value="search / delete any / ranges" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="h13c13" value="balanced BST, sorted container" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="240" height="28" as="geometry"/></mxCell>
<mxCell id="h13c14" value="heap search is O(N)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="h13c15" value="both min and max" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="300" height="28" as="geometry"/></mxCell>
