<mxCell id="h11c25" value="(5, backup)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="180" y="280" width="160" height="28" as="geometry"/></mxCell>
