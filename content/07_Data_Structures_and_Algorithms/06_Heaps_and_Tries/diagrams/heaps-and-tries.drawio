<mxCell id="h11c27" value="heap empty → None" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="580" y="280" width="280" height="28" as="geometry"/></mxCell>
<mxCell id="h11c28" value="&lt;b&gt;Position map&lt;/b&gt;&lt;br&gt;pos[item] = index, updated on every swap; sift the changed entry up or down. True O(log N) decrease-key, more bookkeeping." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="h11c29" value="&lt;b&gt;Lazy deletion&lt;/b&gt; (usual in Python)&lt;br&gt;push the new priority, remember the current one, discard mismatches at the root. O(log P) for P pushes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="324" width="400" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
