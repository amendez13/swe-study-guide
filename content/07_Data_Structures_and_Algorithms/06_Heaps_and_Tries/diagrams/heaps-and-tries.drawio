<mxCell id="h8c1" value="Priority queue with heapq" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h8c2" value="The list is the heap; the module functions keep the invariant. Don&#x27;t edit the list directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h8c3" value="&lt;span style=&#x27;font-family:Courier New&#x27;&gt;&lt;b&gt;heappush(h, x)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;color:#d79b00&#x27;&gt;&lt;b&gt;O(log N)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;append + sift up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="h8c4" value="&lt;span style=&#x27;font-family:Courier New&#x27;&gt;&lt;b&gt;heappop(h)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;color:#d79b00&#x27;&gt;&lt;b&gt;O(log N)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;remove h[0], sift down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="247" y="96" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="h8c5" value="&lt;span style=&#x27;font-family:Courier New&#x27;&gt;&lt;b&gt;h[0]&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;color:#d79b00&#x27;&gt;&lt;b&gt;O(1)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;peek the minimum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="454" y="96" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="h8c6" value="&lt;span style=&#x27;font-family:Courier New&#x27;&gt;&lt;b&gt;heapify(xs)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;color:#d79b00&#x27;&gt;&lt;b&gt;O(N)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;in place, bottom-up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="661" y="96" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="h8c7" value="&lt;span style=&#x27;font-family:Courier New&#x27;&gt;&lt;b&gt;heappushpop(h, x)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;color:#d79b00&#x27;&gt;&lt;b&gt;O(log N)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;push then pop, one sift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="h8c8" value="&lt;span style=&#x27;font-family:Courier New&#x27;&gt;&lt;b&gt;heapreplace(h, x)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;color:#d79b00&#x27;&gt;&lt;b&gt;O(log N)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;pop then push, one sift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="247" y="188" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="h8c9" value="&lt;span style=&#x27;font-family:Courier New&#x27;&gt;&lt;b&gt;nlargest(3, scores)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;color:#d79b00&#x27;&gt;&lt;b&gt;O(N log k)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;[99, 95, 91]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="454" y="188" width="200" height="80" as="geometry"/></mxCell>
