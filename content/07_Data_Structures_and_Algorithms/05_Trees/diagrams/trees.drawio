<mxCell id="t14c12" value="(−∞, ∞)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="143.0" y="162.0" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="t14c13" value="(−∞, 10)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="53.0" y="262.0" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="t14c14" value="(10, ∞)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="323.0" y="262.0" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="t14c15" value="(10, 15) ✗" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#b85450;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="233.0" y="362.0" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="t14c16" value="(15, ∞)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="413.0" y="362.0" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="t14c17" value="&lt;b&gt;Parent-only check&lt;/b&gt;&lt;br&gt;6 &amp;lt; 15, it&#x27;s a left child ✓&lt;br&gt;&lt;i&gt;passes, but the tree is not a BST&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="t14c18" value="&lt;b&gt;Range check&lt;/b&gt;&lt;br&gt;6 lives in 10&#x27;s right subtree and 15&#x27;s left subtree, so it needs 10 &amp;lt; 6 &amp;lt; 15 ✗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="206" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="t14c19" value="def valid(n, lo=-inf, hi=inf):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if n is None: return True&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return (lo &amp;lt; n.val &amp;lt; hi&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;and valid(n.left, lo, n.val)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;and valid(n.right, n.val, hi))" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="292" width="340" height="96" as="geometry"/></mxCell>
<mxCell id="t14c20" value="The intervals are also exactly the slots where an insert can land, and the reason in-order must be strictly increasing." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="820" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
