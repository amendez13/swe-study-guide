<mxCell id="t11c20" value="height&lt;br&gt;grows&lt;br&gt;up" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#d79b00;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="546" y="200" width="50" height="50" as="geometry"/></mxCell>
<mxCell id="t11c21" value="def height(n):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if n is None:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return -1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;  # empty tree&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return 1 + max(height(n.left),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;   height(n.right))" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="610" y="116" width="250" height="96" as="geometry"/></mxCell>
<mxCell id="t11c22" value="&lt;b&gt;depth(4) = 2&lt;/b&gt;: the green path 5 → 3 → 4 has two edges.&lt;br&gt;&lt;b&gt;height(root) = 2&lt;/b&gt;: the tree&#x27;s height is its root&#x27;s height. Leaves have height 0." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="610" y="222" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="t11c23" value="Balance check: at every node, |height(left) − height(right)| ≤ 1. An O(log N) BST is a promise that height stays near log N." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="820" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
