<mxCell id="t10c33" value="[]" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="740" y="200" width="120" height="32" as="geometry"/></mxCell>
<mxCell id="t10c34" value="queue = deque([root])&lt;br&gt;while queue:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;level = []&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;for _ in range(len(queue)):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;node = queue.popleft()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;level.append(node.val)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# enqueue left, then right&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;result.append(level)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="246" width="420" height="130" as="geometry"/></mxCell>
<mxCell id="t10c35" value="&lt;b&gt;Result:&lt;/b&gt; [[5], [3, 8], [1, 4]]. Each node is enqueued and dequeued once: O(N) time, O(width) queue space." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="t10c36" value="Per level: right-side view, max per level, completeness." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="380" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
