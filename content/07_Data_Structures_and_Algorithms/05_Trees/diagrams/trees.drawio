  </diagram>
  <diagram id="bst-range" name="BST range property">
    <mxGraphModel dx="900" dy="444" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="444" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="t14c1" value="BST range property: every ancestor constrains you" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="t14c2" value="Each node must sit inside an open interval (low, high). Going left sets high = node; going right sets low = node." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="t14c3" value="5" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Courier New;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80.0" y="220.0" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="t14c4" value="10" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Courier New;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170.0" y="120.0" width="46" height="46" as="geometry"/></mxCell>
