<mxCell id="t17c40" value="A 5000-node chain: same work, different memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="820" height="26" as="geometry"/></mxCell>
<mxCell id="t17c41" value="&lt;b&gt;Recursive&lt;/b&gt;: one Python frame per level&lt;br&gt;5000 levels &amp;gt; ~1000 limit → &lt;b&gt;RecursionError&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="t17c42" value="&lt;b&gt;Iterative&lt;/b&gt;: the stack is a list on the heap&lt;br&gt;inorder_iter(deep) → &lt;b&gt;5000 values&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="354" width="400" height="52" as="geometry"/></mxCell>
<mxCell id="t17c43" value="Both are O(N) time and O(h) extra space. Start recursive in an interview; mention the explicit stack when depth could be large." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="820" height="24" as="geometry"/></mxCell>
