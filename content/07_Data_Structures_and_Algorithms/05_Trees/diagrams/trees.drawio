<mxCell id="t7c18" value="def inorder(n):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if n is None: return []&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return (inorder(n.left) + [n.val]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ inorder(n.right))" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="176" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="t7c19" value="Go as far left as possible, visit, then go right. Every left-subtree value is visited before its node and every right-subtree value after it." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="340" height="70" as="geometry"/></mxCell>
