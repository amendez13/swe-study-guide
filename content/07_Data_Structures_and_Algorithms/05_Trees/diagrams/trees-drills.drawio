<mxCell id="d9t22" value="&lt;b&gt;green&lt;/b&gt;: value ≥ best, so visible (3 counts: ties are visible)&lt;br&gt;&lt;b&gt;grey&lt;/b&gt;: a larger ancestor hides it" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="d9t23" value="def visible(n, best=-inf):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if n is None: return 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;here = 1 if n.v &amp;gt;= best else 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;best = max(best, n.v)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return (here + visible(n.l, best)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; + visible(n.r, best))" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="560" y="226" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="d9t24" value="&lt;b&gt;Answer:&lt;/b&gt; 4 (the root 3, the lower 3, 4 and 5). O(N) time, O(h) stack." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
