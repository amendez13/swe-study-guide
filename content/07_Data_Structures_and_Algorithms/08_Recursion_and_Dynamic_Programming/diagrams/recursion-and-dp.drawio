<mxCell id="r2092" value="cell = ways(i, remaining) for every state visited; blank = never reached. ways(0, 10) = 3" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="480" y="368" width="380" height="34" as="geometry"/></mxCell>
