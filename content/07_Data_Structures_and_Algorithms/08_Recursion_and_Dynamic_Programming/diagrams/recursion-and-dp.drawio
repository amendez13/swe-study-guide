  <diagram id="rec-iter" name="Recursive vs. iterative">
    <mxGraphModel dx="900" dy="536" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="536" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="r41" value="Recursive vs. iterative" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="r42" value="Same answer, different cost: recursion uses one frame per element, a loop uses one variable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r43" value="&lt;b&gt;total_recursive(xs)&lt;/b&gt;, len(xs) = 5000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="26" as="geometry"/></mxCell>
<mxCell id="r44" value="xs[0] + total(xs, 1)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="r45" value="xs[1] + total(xs, 2)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="176" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="r46" value="xs[2] + total(xs, 3)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="212" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="r47" value="…" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="248" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="r48" value="frame ~1000: RecursionError" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="284" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="r49" value="one frame per element: O(N) stack" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="r410" value="&lt;b&gt;total_iterative(xs)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="400" height="26" as="geometry"/></mxCell>
<mxCell id="r411" value="total = 0" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="320" height="28" as="geometry"/></mxCell>
<mxCell id="r412" value="for x in xs: total += x" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Courier New;fontStyle=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="500" y="176" width="320" height="28" as="geometry"/></mxCell>
<mxCell id="r413" value="→ 12497500" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#2d7a1f;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="212" width="320" height="28" as="geometry"/></mxCell>
<mxCell id="r414" value="O(1) extra space, no limit" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="r415" value="Prefer recursion when" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="r416" value="Prefer iteration when" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="364" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="r417" value="the structure is recursive (trees, nested data)" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="r418" value="depth can grow with N" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="450" y="390" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="r419" value="depth is small or logarithmic" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="r420" value="you need O(1) extra space" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="450" y="416" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="r421" value="a memoized recurrence is the clearest draft" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="r422" value="the DP fill order is obvious" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="450" y="442" width="410" height="26" as="geometry"/></mxCell>
<mxCell id="r423" value="Branching or post-call work? Use an explicit stack instead of a plain loop. Write recursion first, then offer the iterative version." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
