<mxCell id="r111" value="Is this a DP problem?" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="r112" value="DP needs both overlapping subproblems and optimal substructure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r113" value="breaks into subproblems?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="r114" value="subproblems overlap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="r115" value="optimal substructure?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="100" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="r116" value="&lt;b&gt;Not DP&lt;/b&gt;&lt;br&gt;try greedy or brute force" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="r117" value="&lt;b&gt;Plain recursion&lt;/b&gt;&lt;br&gt;or divide and conquer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="r118" value="&lt;b&gt;Rethink the state&lt;/b&gt;&lt;br&gt;overlap but no substructure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="170" height="50" as="geometry"/></mxCell>
