<mxCell id="r1051" value="best is filled right to left: best(9) = 1, best(8) = 100 + best(9)... each value only trusts the optimal best(i + 1) and best(i + 2)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="r1052" value="&lt;b&gt;Counterexample: longest simple path&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="400" height="26" as="geometry"/></mxCell>
<mxCell id="r1053" value="The longest A → B path and longest B → C path can reuse vertices, so gluing them is not a valid longest A → C path. No optimal substructure, no simple DP." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="r1054" value="&lt;b&gt;Counting version&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="310" width="400" height="26" as="geometry"/></mxCell>
<mxCell id="r1055" value="For &quot;how many ways&quot;, subproblems must split the possibilities into disjoint groups so their counts add." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="460" y="344" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="r1056" value="min_cost_to_end([10, 15, 20]) = 15; for the 10-cell list above it is 6." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="isdp" name="Is this a DP problem">
    <mxGraphModel dx="900" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="470" math="0" shadow="0">
      <root>
