<mxCell id="r19103" value="match: take the letter, move diagonally" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="444" y="110" width="280" height="22" as="geometry"/></mxCell>
<mxCell id="r19104" value="" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="136" width="18" height="18" as="geometry"/></mxCell>
<mxCell id="r19105" value="skip: follow the larger neighbor" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="444" y="134" width="280" height="22" as="geometry"/></mxCell>
<mxCell id="r19106" value="dp[i][j] = LCS length of suffixes a[i:] and b[j:]. Match → 1 + diagonal, else max(down, right). Filled from the bottom-right; the answer is dp[0][0] = 6." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="440" height="60" as="geometry"/></mxCell>
<mxCell id="r19107" value="Ties go down (&gt;=), which decides which of several optimal answers you get." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="420" y="240" width="440" height="30" as="geometry"/></mxCell>
<mxCell id="r19108" value="Result: (6, &#x27;PHONIC&#x27;)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fontSize=14;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="440" height="24" as="geometry"/></mxCell>
<mxCell id="r19109" value="A one-row space-optimized version can report the length 6 but not the letters: the walk needs the cells it passes through." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="440" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
