<mxCell id="q1432" value="green = [3, 4, 6, 7], linked by prev pointers (2, 4, 6, 7 is another)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;fontStyle=1;fontColor=#2d7a1f;" vertex="1" parent="1"><mxGeometry x="200" y="250" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="q1433" value="&lt;b&gt;Why not &quot;best among the first i&quot;?&lt;/b&gt; It forgets the last value used, so you can&#x27;t tell whether nums[i] extends it. &quot;Ends at i&quot; fixes the last value." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="286" width="820" height="46" as="geometry"/></mxCell>
<mxCell id="q1434" value="dp[i] = 1 + max(dp[j]) over j &amp;lt; i with nums[j] &amp;lt; nums[i]; answer = max(dp). O(N²)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="q1435" value="dp = [1, 2, 1, 1, 3, 2, 3, 4]; the longest length is 4 (for example 2, 4, 6, 7)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
