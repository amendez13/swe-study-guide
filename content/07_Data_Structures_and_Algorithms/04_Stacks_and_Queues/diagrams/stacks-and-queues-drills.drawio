<mxCell id="q4c25" value="−" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="160" height="26" as="geometry"/></mxCell>
<mxCell id="q4c26" value="yes" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="318" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="q4c27" value="returns y − x" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="318" width="460" height="26" as="geometry"/></mxCell>
<mxCell id="q4c28" value="/" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="160" height="26" as="geometry"/></mxCell>
<mxCell id="q4c29" value="yes" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="344" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="q4c30" value="returns y / x" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="344" width="460" height="26" as="geometry"/></mxCell>
<mxCell id="q4c31" value="&lt;b&gt;Answer:&lt;/b&gt; it returns −5. Pop into right first, then left, and compute left op right. + and * hide the bug; − and / expose it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
