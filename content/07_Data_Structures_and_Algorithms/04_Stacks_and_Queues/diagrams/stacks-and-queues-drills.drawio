<mxCell id="q11c16" value="&lt;b&gt;keep a size counter&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;empty: size == 0 · full: size == cap · enqueue raises on full&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="q11c17" value="&lt;b&gt;leave one slot unused&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;full: (tail + 1) % cap == head · stores only cap − 1 items&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="q11c18" value="&lt;b&gt;Answer:&lt;/b&gt; is_empty() reports True on a full buffer: head == tail means both states. Track size (or leave a slot free)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="820" height="40" as="geometry"/></mxCell>
