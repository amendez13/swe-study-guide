<mxCell id="q3c8" value="stack holding None" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="208" width="160" height="16" as="geometry"/></mxCell>
<mxCell id="q3c9" value="peek() → None" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#b85450;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="100" y="230" width="160" height="20" as="geometry"/></mxCell>
<mxCell id="q3c10" value="peek() → None" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#b85450;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="160" height="20" as="geometry"/></mxCell>
<mxCell id="q3c11" value="same answer, different states:&lt;br&gt;the caller can&#x27;t tell them apart" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="q3c12" value="Fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="q3c13" value="def peek(self):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if not self._items:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;raise IndexError(&quot;peek at empty stack&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return self._items[-1]&lt;br&gt;&lt;br&gt;def is_empty(self):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return not self._items" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="q3c14" value="Underflow becomes loud and impossible to confuse with a stored value. Callers who expect emptiness check is_empty() first." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="308" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="q3c15" value="&lt;b&gt;Answer:&lt;/b&gt; after push(None), peek() returns None, indistinguishable from empty. Raise on empty, and offer is_empty()." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="postfix-order" name="Postfix operand order">
