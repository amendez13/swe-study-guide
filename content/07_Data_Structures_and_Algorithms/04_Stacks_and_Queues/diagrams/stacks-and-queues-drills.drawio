<mxCell id="q4c7" value="8" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="215" y="146" width="80" height="32" as="geometry"/></mxCell>
<mxCell id="q4c8" value="3" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="215" y="114" width="80" height="32" as="geometry"/></mxCell>
<mxCell id="q4c9" value="push 3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="190" width="90" height="18" as="geometry"/></mxCell>
<mxCell id="q4c10" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;fillColor=none;strokeWidth=2.5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="90" height="72" as="geometry"/></mxCell>
<mxCell id="q4c11" value="8" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="365" y="146" width="80" height="32" as="geometry"/></mxCell>
<mxCell id="q4c12" value="3" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="365" y="114" width="80" height="32" as="geometry"/></mxCell>
<mxCell id="q4c13" value="see −" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="190" width="90" height="18" as="geometry"/></mxCell>
<mxCell id="q4c14" value="&lt;b&gt;✗ a = pop(); b = pop(); a − b&lt;/b&gt;&lt;br&gt;a = 3, b = 8 → 3 − 8 = &lt;b&gt;−5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="340" height="52" as="geometry"/></mxCell>
<mxCell id="q4c15" value="&lt;b&gt;✓ right = pop(); left = pop(); left − right&lt;/b&gt;&lt;br&gt;right = 3, left = 8 → 8 − 3 = &lt;b&gt;5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="164" width="340" height="52" as="geometry"/></mxCell>
<mxCell id="q4c16" value="operator" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="160" height="26" as="geometry"/></mxCell>
<mxCell id="q4c17" value="order matters?" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="240" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="q4c18" value="&quot;x y op&quot; with the bug" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="460" height="26" as="geometry"/></mxCell>
<mxCell id="q4c19" value="+" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="160" height="26" as="geometry"/></mxCell>
