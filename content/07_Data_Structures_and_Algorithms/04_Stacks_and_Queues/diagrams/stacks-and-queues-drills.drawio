<mxCell id="q4c4" value="8" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="65" y="146" width="80" height="32" as="geometry"/></mxCell>
<mxCell id="q4c5" value="push 8" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="90" height="18" as="geometry"/></mxCell>
