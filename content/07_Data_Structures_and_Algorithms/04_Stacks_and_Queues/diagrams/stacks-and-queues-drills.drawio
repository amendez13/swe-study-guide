<mxCell id="q16c21" value="at 3002 the window starts at 2, so 1 falls off the front (popleft)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="170" y="328" width="600" height="18" as="geometry"/></mxCell>
