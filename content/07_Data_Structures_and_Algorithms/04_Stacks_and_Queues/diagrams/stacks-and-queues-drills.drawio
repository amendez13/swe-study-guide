<mxCell id="q4c21" value="hides the bug" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="266" width="460" height="26" as="geometry"/></mxCell>
<mxCell id="q4c22" value="*" style="whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="160" height="26" as="geometry"/></mxCell>
