<mxCell id="q5c31" value="&lt;b&gt;Answer:&lt;/b&gt; push unless the char equals the top, then pop. New neighbours are handled for free. O(N) time, O(N) space." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="40" as="geometry"/></mxCell>
