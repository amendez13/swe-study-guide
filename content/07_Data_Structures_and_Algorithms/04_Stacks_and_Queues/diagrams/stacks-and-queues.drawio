<mxCell id="p6c29" value="Each element waits behind everything that arrived before it. Compare the stack, where push and pop share one end." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="820" height="22" as="geometry"/></mxCell>
