<mxCell id="p8c4" value="&lt;b&gt;out_stack&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;dequeue pops here&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="90" width="140" height="36" as="geometry"/></mxCell>
