        </mxCell>
        <mxCell id="t12" value="push(C)" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;fontColor=#2d7a1f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h1" target="h2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="pop()" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h2" target="h3">
