<mxCell id="p10c35" value="(1, &#x27;normal&#x27;)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="730" y="300" width="125" height="32" as="geometry"/></mxCell>
<mxCell id="p10c36" value="• children of index i sit at 2i+1 and 2i+2&lt;br&gt;• every parent ≤ its children, so &lt;b&gt;heap[0] is always the min&lt;/b&gt;&lt;br&gt;• the rest is only partly ordered, which is why push and pop stay cheap" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="470" y="338" width="390" height="64" as="geometry"/></mxCell>
<mxCell id="p10c37" value="&lt;b&gt;heappush&lt;/b&gt;: append at the end, then sift up (swap with the parent while smaller) → O(log n)&lt;br&gt;&lt;b&gt;heappop&lt;/b&gt;: take heap[0], move the last item to the root, sift down → O(log n)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="820" height="42" as="geometry"/></mxCell>
<mxCell id="p10c38" value="Why a heap? Costs of the obvious alternatives" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="820" height="22" as="geometry"/></mxCell>
