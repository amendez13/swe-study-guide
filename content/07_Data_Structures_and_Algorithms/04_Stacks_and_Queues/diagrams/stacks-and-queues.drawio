<mxCell id="p6c42" value="_back" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Courier New;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="585" y="506" width="70" height="26" as="geometry"/></mxCell>
