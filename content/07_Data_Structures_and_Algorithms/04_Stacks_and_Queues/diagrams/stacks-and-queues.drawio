<mxCell id="p9c89" value="Each block holds many slots and is doubly linked to its neighbours. Growing either end fills the end block or adds a new one, so nothing shifts. Trade-off: indexing into the middle is O(n)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="520" width="390" height="56" as="geometry"/></mxCell>
<mxCell id="p9c90" value="⚠️ &lt;b&gt;list.pop(0)&lt;/b&gt; and &lt;b&gt;list.insert(0, x)&lt;/b&gt; are O(n) because every element shifts. &lt;b&gt;deque.popleft()&lt;/b&gt; and &lt;b&gt;appendleft()&lt;/b&gt; are O(1)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="820" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
