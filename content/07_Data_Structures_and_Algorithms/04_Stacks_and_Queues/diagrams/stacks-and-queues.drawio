<mxCell id="p14c94" value="No output until i ≥ k−1 = 2. Each index enters and leaves the deque once → O(N). A heap also works, at O(N log k)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="820" height="20" as="geometry"/></mxCell>
