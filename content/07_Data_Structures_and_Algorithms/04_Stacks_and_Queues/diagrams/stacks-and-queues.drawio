<mxCell id="p12c40" value="slot 2 is followed by slot 0" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="660" y="290" width="200" height="18" as="geometry"/></mxCell>
<mxCell id="p12c41" value="next_free = (head + size) % capacity   # enqueue writes here&lt;br&gt;head&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;  = (head + 1) % capacity&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;  # dequeue advances" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="520" height="46" as="geometry"/></mxCell>
<mxCell id="p12c42" value="&lt;b&gt;Why track size?&lt;/b&gt; With only head and tail indices, &lt;i&gt;head == tail&lt;/i&gt; means both “empty” and “full”. An explicit size removes the ambiguity." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="420" width="280" height="56" as="geometry"/></mxCell>
<mxCell id="p12c43" value="When full, pick one:" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="p12c44" value="&lt;b&gt;Raise&lt;/b&gt; OverflowError&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;RingQueue above: the caller decides what to do&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="400" height="46" as="geometry"/></mxCell>
<mxCell id="p12c45" value="&lt;b&gt;Overwrite the oldest&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;deque(maxlen=N): audio buffers, log tails, metrics&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="512" width="400" height="46" as="geometry"/></mxCell>
<mxCell id="p12c46" value="Worst-case O(1) enqueue and dequeue, no allocation after construction. That predictability is why drivers and audio pipelines use ring buffers." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="568" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
