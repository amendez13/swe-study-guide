<mxCell id="p16c27" value="Completion and clean shutdown (the card&#x27;s code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="p16c28" value="put(0) … put(4)" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="132" height="52" as="geometry"/></mxCell>
<mxCell id="p16c29" value="worker: get →&lt;br&gt;process → task_done()" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="177" y="420" width="132" height="52" as="geometry"/></mxCell>
<mxCell id="p16c30" value="jobs.join() returns&lt;br&gt;when all 5 are done" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="314" y="420" width="132" height="52" as="geometry"/></mxCell>
<mxCell id="p16c31" value="put(None)&lt;br&gt;(sentinel)" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="451" y="420" width="132" height="52" as="geometry"/></mxCell>
<mxCell id="p16c32" value="worker sees None&lt;br&gt;→ break" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="588" y="420" width="132" height="52" as="geometry"/></mxCell>
<mxCell id="p16c33" value="t.join():&lt;br&gt;thread exits" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="725" y="420" width="132" height="52" as="geometry"/></mxCell>
<mxCell id="p16c34" value="task_done() marks one item finished; join() waits until every put() has a matching task_done(). The sentinel lets the consumer exit instead of blocking in get() forever." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="p16c35" value="When the queue is full, pick a policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="p16c36" value="&lt;b&gt;Block&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;queue.Queue.put(): slow the producer down&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="562" width="266" height="50" as="geometry"/></mxCell>
<mxCell id="p16c37" value="&lt;b&gt;Reject&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;put_nowait() raises queue.Full; APIs answer 429/503&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="317" y="562" width="266" height="50" as="geometry"/></mxCell>
<mxCell id="p16c38" value="&lt;b&gt;Drop oldest&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;deque(maxlen=N): keep the newest (metrics, logs)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="594" y="562" width="266" height="50" as="geometry"/></mxCell>
<mxCell id="p16c39" value="Same idea across machines: SQS, RabbitMQ and Kafka put a durable, bounded buffer between many producers and many consumers." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="622" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
