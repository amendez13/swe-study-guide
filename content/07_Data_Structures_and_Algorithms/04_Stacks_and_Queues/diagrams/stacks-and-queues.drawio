<mxCell id="p10c48" value="O(n): shift to insert" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="540" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="p10c49" value="O(1): pop from the end" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="540" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="p10c50" value="O(1)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="540" width="180" height="28" as="geometry"/></mxCell>
<mxCell id="p10c51" value="binary heap (heapq)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="568" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="p10c52" value="O(log n)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="568" width="200" height="28" as="geometry"/></mxCell>
<mxCell id="p10c53" value="O(log n)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="568" width="220" height="28" as="geometry"/></mxCell>
<mxCell id="p10c54" value="O(1): heap[0]" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="568" width="180" height="28" as="geometry"/></mxCell>
<mxCell id="p10c55" value="⚠️ Tuples compare element by element. With equal priorities, heapq compares the items next and raises TypeError if they don&#x27;t support &amp;lt;. Use &lt;b&gt;(priority, counter, item)&lt;/b&gt; with an increasing counter: it breaks ties and keeps FIFO order among equals.&lt;br&gt;Priority queue = the interface; heap = the usual implementation (details in the Heaps topic)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="820" height="54" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
