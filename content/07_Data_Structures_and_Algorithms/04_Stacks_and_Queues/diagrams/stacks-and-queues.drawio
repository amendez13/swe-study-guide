<mxCell id="p10c42" value="peek min" style="whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="484" width="180" height="28" as="geometry"/></mxCell>
