<mxCell id="p3c14" value="Recursive: Python&#x27;s call stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="52" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="p3c15" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;fillColor=none;strokeWidth=3;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="335" y="90" width="210" height="122" as="geometry"/></mxCell>
<mxCell id="p3c16" value="dfs(D)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="345" y="100" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="p3c17" value="dfs(B)  resume in loop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontFamily=Courier New;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="345" y="134" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="p3c18" value="dfs(A)  resume in loop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontFamily=Courier New;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="345" y="168" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="p3c19" value="each frame remembers &lt;b&gt;where to resume&lt;/b&gt;;&lt;br&gt;RecursionError past ~1000 frames" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="310" y="214" width="260" height="34" as="geometry"/></mxCell>
<mxCell id="p3c20" value="def dfs(n):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;visited.add(n)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;for m in graph[n]:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if m not in visited:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;dfs(m)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Courier New;fontSize=10;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="310" y="256" width="260" height="106" as="geometry"/></mxCell>
<mxCell id="p3c21" value="Iterative: explicit stack (a list)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="52" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="p3c22" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;fillColor=none;strokeWidth=3;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="625" y="90" width="210" height="122" as="geometry"/></mxCell>
<mxCell id="p3c23" value="D" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="635" y="100" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="p3c24" value="E" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="635" y="134" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="p3c25" value="C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="635" y="168" width="190" height="34" as="geometry"/></mxCell>
<mxCell id="p3c26" value="top" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=3;fontColor=#d79b00;align=right;" vertex="1" parent="1"><mxGeometry x="572" y="102" width="40" height="30" as="geometry"/></mxCell>
<mxCell id="p3c27" value="holds &lt;b&gt;nodes still to visit&lt;/b&gt;; it lives on the&lt;br&gt;heap, so depth is limited only by memory" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="600" y="214" width="260" height="34" as="geometry"/></mxCell>
<mxCell id="p3c28" value="stack = [start]&lt;br&gt;while stack:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;n = stack.pop()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if n in visited: continue&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;visited.add(n)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;stack.extend(reversed(graph[n]))" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Courier New;fontSize=10;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="256" width="260" height="106" as="geometry"/></mxCell>
<mxCell id="p3c29" value="same moment: both are about to visit D" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="310" y="364" width="550" height="18" as="geometry"/></mxCell>
<mxCell id="p3c30" value="recursive call dfs(m)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="310" y="388" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="p3c31" value="stack.append(m)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="388" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="p3c32" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="p3c30" target="p3c31"><mxGeometry relative="1" as="geometry"/></mxCell>
