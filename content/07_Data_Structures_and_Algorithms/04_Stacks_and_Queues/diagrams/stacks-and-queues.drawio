<mxCell id="p5c87" value="after push 5, 3, 7, 2, 8: &lt;br&gt;only &lt;font color=&#x27;#2d7a1f&#x27;&gt;&lt;b&gt;new minimums&lt;/b&gt;&lt;/font&gt; reach mins" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="80" y="596" width="350" height="34" as="geometry"/></mxCell>
<mxCell id="p5c88" value="def push(x):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;data.append(x)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if not mins or x &amp;lt;= mins[-1]:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;mins.append(x)&lt;br&gt;&lt;br&gt;def pop():&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;x = data.pop()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if x == mins[-1]:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;mins.pop()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return x&lt;br&gt;&lt;br&gt;def get_min(): return mins[-1]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;fillColor=#272822;fontColor=#f8f8f2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470" y="428" width="390" height="200" as="geometry"/></mxCell>
<mxCell id="p5c89" value="⚠️ Use &lt;b&gt;≤&lt;/b&gt;, not &amp;lt;: if the min appears twice, both copies must go on mins, or popping one would lose the min.&lt;br&gt;Saves space when values rarely decrease; worst case (strictly decreasing input) matches the pair version." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="820" height="40" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
