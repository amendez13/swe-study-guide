<mxCell id="p3c12" value="A: [B, C]   B: [D, E]&lt;br&gt;C, D, E: []" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="240" height="36" as="geometry"/></mxCell>
