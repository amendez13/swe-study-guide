<mxCell id="hcf1-1" value="The problem with HttpClient" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="hcf1-2" value="Per-call clients exhaust sockets; one static client never sees DNS changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="hcf1-3" value="using var client = new HttpClient()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="260" height="200" as="geometry"/></mxCell>
<mxCell id="hcf1-4" value="dispose closes the connection&lt;br&gt;socket stays in TIME_WAIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="135" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="hcf1-5" value="under load: out of sockets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="215" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="hcf1-6" value="one static HttpClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="320" y="95" width="260" height="200" as="geometry"/></mxCell>
<mxCell id="hcf1-7" value="reuses connections well" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="335" y="135" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="hcf1-8" value="keeps them open indefinitely:&lt;br&gt;misses DNS changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="335" y="215" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="hcf1-9" value="good answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="600" y="95" width="260" height="200" as="geometry"/></mxCell>
<mxCell id="hcf1-10" value="IHttpClientFactory&lt;br&gt;pools + recycles handlers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="615" y="135" width="230" height="60" as="geometry"/></mxCell>
