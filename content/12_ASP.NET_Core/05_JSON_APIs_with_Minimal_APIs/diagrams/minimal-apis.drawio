<mxCell id="ma5-9" value="both responses carry&lt;br&gt;X-Api-Revision: 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="ma5-10" value="Uses only the request, so it wraps handlers with different signatures. An argument-based reusable filter needs a shared argument contract or a filter factory." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="220" height="140" as="geometry"/></mxCell>
<mxCell id="ma5-11" value="group nesting composes path prefixes · settings such as authorization metadata apply at group scope" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="820" height="22" as="geometry"/></mxCell>
