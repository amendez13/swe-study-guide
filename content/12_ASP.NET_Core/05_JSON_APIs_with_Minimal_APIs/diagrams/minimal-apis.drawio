<mxCell id="ma5-3" value="app.MapGroup(&quot;/api/rooms&quot;).AddEndpointFilter&amp;lt;RevisionFilter&amp;gt;()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="230" as="geometry"/></mxCell>
<mxCell id="ma5-4" value="rooms.MapGet(&quot;&quot;)&lt;br&gt;→ /api/rooms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="230" height="44" as="geometry"/></mxCell>
<mxCell id="ma5-5" value="rooms.MapGet(&quot;/{id}&quot;)&lt;br&gt;→ /api/rooms/1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="340" y="150" width="230" height="44" as="geometry"/></mxCell>
<mxCell id="ma5-6" value="RevisionFilter : IEndpointFilter&lt;br&gt;Response.Headers[&quot;X-Api-Revision&quot;] = &quot;1&quot; · return next(context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="500" height="60" as="geometry"/></mxCell>
<mxCell id="ma5-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="ma5-6" target="ma5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
