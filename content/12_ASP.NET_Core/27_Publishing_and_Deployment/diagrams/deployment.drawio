<mxCell id="d7-1" value="Publish a container image" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="d7-2" value="The SDK builds the image; configuration arrives at run time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="d7-3" value="dotnet publish /t:PublishContainer&lt;br&gt;-p:ContainerRepository=library-catalog&lt;br&gt;-p:ContainerImageTag=1.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="330" height="60" as="geometry"/></mxCell>
<mxCell id="d7-4" value="image library-catalog:1.0&lt;br&gt;.NET 10 default images: Ubuntu-based" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="d7-5" value="no Dockerfile" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d7-3" target="d7-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d7-6" value="docker run -p 5080:8080&lt;br&gt;-e ConnectionStrings__Library=&quot;...&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="330" height="60" as="geometry"/></mxCell>
<mxCell id="d7-7" value="container&lt;br&gt;listens on 8080 (ASPNETCORE_HTTP_PORTS)&lt;br&gt;runs as the non-root app user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="d7-8" value="host 5080 → 8080" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d7-6" target="d7-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d7-9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d7-4" target="d7-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d7-10" value="one image through every environment&lt;br&gt;env vars, not baked-in config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="300" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="d7-11" value="orchestrator restarts it&lt;br&gt;logs to stdout (JSON console)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460.0" y="300" width="400" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d8" name="Configure the app&#x27;s URLs">
