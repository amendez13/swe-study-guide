<mxCell id="d8-1" value="Configure the app&#x27;s URLs" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="d8-2" value="Kestrel binds the URLs it&#x27;s given; Kestrel:Endpoints overrides the rest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="d8-3" value="urls config key ·&lt;br&gt;ASPNETCORE_URLS env var" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="100" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="d8-4" value="--urls command line&lt;br&gt;overrides environment variables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="100" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="d8-5" value="Kestrel:Endpoints&lt;br&gt;overrides all of these" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="100" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="d8-6" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d8-3" target="d8-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d8-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d8-4" target="d8-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d8-8" value="also: code (&lt;font face=&quot;Courier New&quot;&gt;app.Urls.Add&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;app.Run(url)&lt;/font&gt;) · &lt;font face=&quot;Courier New&quot;&gt;ASPNETCORE_HTTP_PORTS&lt;/font&gt; / &lt;font face=&quot;Courier New&quot;&gt;ASPNETCORE_HTTPS_PORTS&lt;/font&gt; set ports on all interfaces (.NET 8+) · no setting → http://localhost:5000" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="820" height="34" as="geometry"/></mxCell>
<mxCell id="d8-9" value="Public · &quot;http://0.0.0.0:5080&quot;&lt;br&gt;all interfaces" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="d8-10" value="Admin · &quot;http://127.0.0.1:5081&quot;&lt;br&gt;local connections only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="220" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="d8-11" value="&lt;font face=&quot;Courier New&quot;&gt;*&lt;/font&gt; or &lt;font face=&quot;Courier New&quot;&gt;0.0.0.0&lt;/font&gt;: all interfaces · &lt;font face=&quot;Courier New&quot;&gt;localhost&lt;/font&gt; or &lt;font face=&quot;Courier New&quot;&gt;127.0.0.1&lt;/font&gt;: local only, as behind a reverse proxy" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="820" height="22" as="geometry"/></mxCell>
<mxCell id="d8-12" value="/urls on each port → { Bound = app.Urls, Local = context.Connection.LocalPort }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="820" height="36" as="geometry"/></mxCell>
