<mxCell id="d3-1" value="Framework-dependent and self-contained deployments" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="d3-2" value="Does the server provide the runtime, or does the publish output?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="d3-3" value="framework-dependent (default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="400" height="220" as="geometry"/></mxCell>
<mxCell id="d3-4" value="dotnet publish -o ./publish-fdd" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="360" height="36" as="geometry"/></mxCell>
<mxCell id="d3-5" value="app only · small output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="d3-6" value="server needs the matching ASP.NET Core runtime&lt;br&gt;runtime patched separately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="d3-7" value="self-contained" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="400" height="220" as="geometry"/></mxCell>
<mxCell id="d3-8" value="dotnet publish -r linux-x64 --self-contained" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="360" height="36" as="geometry"/></mxCell>
<mxCell id="d3-9" value="app + runtime · larger output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="d3-10" value="no .NET install on the server&lt;br&gt;ship runtime updates by republishing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="d3-11" value="-p:PublishSingleFile=true&lt;br&gt;one executable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="340" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="d3-12" value="trimming&lt;br&gt;removes unused code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="340" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="d3-13" value="Native AOT&lt;br&gt;native code · feature limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="610.0" y="340" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="d3-14" value="framework-dependent where you control the server image · self-contained where you don&#x27;t" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d4" name="Host on IIS">
