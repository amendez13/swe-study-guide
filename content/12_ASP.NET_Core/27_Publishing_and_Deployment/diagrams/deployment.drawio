<mxCell id="d6-1" value="Run as a Linux service" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="d6-2" value="A reverse proxy doesn&#x27;t start the app; systemd does" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="d6-3" value="[Service]&lt;br&gt;Type=notify&lt;br&gt;WorkingDirectory=/srv/catalog&lt;br&gt;ExecStart=/srv/catalog/StudyApi&lt;br&gt;  --urls http://127.0.0.1:5080&lt;br&gt;User=catalog&lt;br&gt;Environment=ASPNETCORE_ENVIRONMENT=Production&lt;br&gt;Restart=always" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=left;fontStyle=1;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="360" height="150" as="geometry"/></mxCell>
<mxCell id="d6-4" value="systemd&lt;br&gt;systemctl enable --now" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="d6-5" value="StudyApi&lt;br&gt;AddSystemd()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="d6-6" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d6-3" target="d6-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d6-7" value="starts ·&lt;br&gt;restarts" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d6-4" target="d6-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d6-8" value="startup finished" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d6-5" target="d6-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="190"/><mxPoint x="520" y="190"/></Array></mxGeometry></mxCell>
<mxCell id="d6-9" value="journal · journalctl -u" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="220" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="d6-10" value="Without AddSystemd use Type=simple · run as an unprivileged user · secrets through environment files only that user can read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="820" height="46" as="geometry"/></mxCell>
