<mxCell id="d5-1" value="Run behind a reverse proxy on Linux" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="d5-2" value="Trust X-Forwarded-For and X-Forwarded-Proto only from known proxies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="d5-3" value="client&lt;br&gt;real IP · https" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="140" height="60" as="geometry"/></mxCell>
<mxCell id="d5-4" value="nginx&lt;br&gt;terminates TLS&lt;br&gt;proxy_pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="d5-5" value="Kestrel (local port)&lt;br&gt;sees the proxy address + http&lt;br&gt;until forwarded headers are applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="330" height="80" as="geometry"/></mxCell>
<mxCell id="d5-6" value="https" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d5-3" target="d5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d5-7" value="http +&lt;br&gt;X-Forwarded-*" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d5-4" target="d5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d5-8" value="UseForwardedHeaders() first&lt;br&gt;ForwardedHeaders = XForwardedFor | XForwardedProto&lt;br&gt;KnownIPNetworks.Add(IPNetwork.Parse(&quot;10.0.0.0/24&quot;)) · loopback trusted by default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="520" height="64" as="geometry"/></mxCell>
<mxCell id="d5-9" value="/client&lt;br&gt;RemoteIpAddress via Scheme&lt;br&gt;→ client IP via https" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="620" y="220" width="240" height="64" as="geometry"/></mxCell>
<mxCell id="d5-10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d5-8" target="d5-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="d5-11" value=".NET 10: KnownNetworks and the old IPNetwork type are obsolete · use KnownIPNetworks with System.Net.IPNetwork" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="d5-12" value="without it: HTTPS redirection, absolute links, and client IP logging break" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
