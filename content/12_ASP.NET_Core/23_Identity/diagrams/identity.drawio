<mxCell id="i2-14" value="Since .NET 7, WebApplication adds both middleware automatically when their services are registered. Call them yourself only when middleware must run between them, like the logger here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="470" y="220" width="390" height="130" as="geometry"/></mxCell>
