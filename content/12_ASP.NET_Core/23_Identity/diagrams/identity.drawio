<mxCell id="i2-10" value="a scheme handler (cookies, JWT bearer, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="400" height="130" as="geometry"/></mxCell>
<mxCell id="i2-11" value="authenticate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="260" width="115" height="60" as="geometry"/></mxCell>
<mxCell id="i2-12" value="challenge&lt;br&gt;anonymous" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182.5" y="260" width="115" height="60" as="geometry"/></mxCell>
