<mxCell id="i1-7" value="authenticated because a scheme created it" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="340" height="50" as="geometry"/></mxCell>
<mxCell id="i1-8" value="GET /login&lt;br&gt;Results.SignIn(new ClaimsPrincipal(identity))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="340" height="50" as="geometry"/></mxCell>
<mxCell id="i1-9" value="GET /me (with the cookie)&lt;br&gt;Authenticated = true&lt;br&gt;Claims = Type=Value for the name and role claims" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="340" height="60" as="geometry"/></mxCell>
