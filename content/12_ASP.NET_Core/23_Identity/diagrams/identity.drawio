<mxCell id="i1-4" value="ClaimsIdentity · authentication type &quot;Cookies&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="380" height="190" as="geometry"/></mxCell>
<mxCell id="i1-5" value="ClaimTypes.Name = ada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="340" height="36" as="geometry"/></mxCell>
