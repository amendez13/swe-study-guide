<mxCell id="i1-11" value="Claims are statements by their issuer: trust them only from your app or a trusted identity provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="i1-12" value="authentication: who sent the request · authorization: what that caller may do" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
