<mxCell id="sh6-2" value="Parameters keep input as data; concatenation lets it become SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="sh6-3" value="?title=x&#x27; OR &#x27;1&#x27;=&#x27;1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="820" height="36" as="geometry"/></mxCell>
<mxCell id="sh6-4" value="FromSql($&quot;SELECT * FROM Books&lt;br&gt;WHERE Title = {title}&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="sh6-5" value="FromSqlRaw(&quot;SELECT * FROM Books&lt;br&gt;WHERE Title = &#x27;&quot; + title + &quot;&#x27;&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="170" width="380" height="60" as="geometry"/></mxCell>
