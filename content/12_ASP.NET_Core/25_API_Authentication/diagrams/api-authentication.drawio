<mxCell id="aa1-11" value="OAuth 2.0: client obtains an access token for an API&lt;br&gt;OpenID Connect: adds sign-in + ID token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="aa1-12" value="Cookies suit one browser + one app + one domain · single app: ASP.NET Core Identity API endpoints are simpler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="40" as="geometry"/></mxCell>
