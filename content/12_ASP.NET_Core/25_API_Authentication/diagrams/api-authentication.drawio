<mxCell id="aa2-4" value="payload (claims)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320.0" y="100" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="aa2-5" value="signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600.0" y="100" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="aa2-6" value="." style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="aa2-3" target="aa2-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="aa2-7" value="." style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="aa2-4" target="aa2-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="aa2-8" value="three Base64Url parts · signed, not encrypted: anyone holding it can read the payload" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="154" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="aa2-9" value="signature&lt;br&gt;issuer&#x27;s key from&lt;br&gt;Authority metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="200" width="185" height="70" as="geometry"/></mxCell>
<mxCell id="aa2-10" value="iss&lt;br&gt;Authority =&lt;br&gt;&quot;https://login.example.org/&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="251.66666666666666" y="200" width="185" height="70" as="geometry"/></mxCell>
<mxCell id="aa2-11" value="aud&lt;br&gt;Audience =&lt;br&gt;&quot;library-api&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="463.3333333333333" y="200" width="185" height="70" as="geometry"/></mxCell>
<mxCell id="aa2-12" value="exp&lt;br&gt;ClockSkew =&lt;br&gt;1 minute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675.0" y="200" width="185" height="70" as="geometry"/></mxCell>
<mxCell id="aa2-13" value="the JWT bearer handler checks all four before /loans runs" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="820" height="20" as="geometry"/></mxCell>
<mxCell id="aa2-14" value="Don&#x27;t put secrets in claims · the API never stores the token: each request carries it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
