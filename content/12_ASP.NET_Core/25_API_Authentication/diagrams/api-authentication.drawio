<mxCell id="aa1-4" value="identity provider&lt;br&gt;Entra ID · Auth0 · Keycloak&lt;br&gt;Duende IdentityServer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="aa1-5" value="API&lt;br&gt;AddJwtBearer()&lt;br&gt;validate + authorize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="260" height="70" as="geometry"/></mxCell>
