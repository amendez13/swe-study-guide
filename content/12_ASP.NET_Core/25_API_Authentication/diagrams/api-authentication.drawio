<mxCell id="aa1-9" value="/whoami&lt;br&gt;Name · Scheme · Claims" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="650" y="250" width="210" height="70" as="geometry"/></mxCell>
