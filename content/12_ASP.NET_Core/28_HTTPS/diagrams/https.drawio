<mxfile host="drawio">
  <diagram id="h1" name="Why every app needs HTTPS">
    <mxGraphModel dx="900" dy="412" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="412" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h1-1" value="Why every app needs HTTPS" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h1-2" value="TLS can end at Kestrel or at a proxy; the app must still know the original scheme" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h1-3" value="browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="h1-4" value="Kestrel terminates TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="h1-5" value="Scheme https&lt;br&gt;IsHttps true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="h1-6" value="https" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h1-3" target="h1-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h1-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h1-4" target="h1-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h1-8" value="browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="h1-9" value="proxy&lt;br&gt;terminates TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="210" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="h1-10" value="Kestrel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="210" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="h1-11" value="needs forwarded headers&lt;br&gt;to report https" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="640" y="210" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="h1-12" value="https" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h1-8" target="h1-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h1-13" value="http" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h1-9" target="h1-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h1-14" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h1-10" target="h1-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h1-15" value="cookies · bearer tokens&lt;br&gt;form posts · personal data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="300" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="h1-16" value="browsers mark&lt;br&gt;plain HTTP not secure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250.0" y="300" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="h1-17" value="service workers · some&lt;br&gt;cookie settings: secure context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460.0" y="300" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="h1-18" value="HTTP/2 in browsers&lt;br&gt;only over HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670.0" y="300" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="h1-19" value="the original scheme decides &lt;font face=&quot;Courier New&quot;&gt;https&lt;/font&gt; links and secure cookies · &lt;font face=&quot;Courier New&quot;&gt;/scheme&lt;/font&gt; shows Scheme, IsHttps, Protocol" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="h2" name="The development certificate">
    <mxGraphModel dx="900" dy="404" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="404" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h2-1" value="The development certificate" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h2-2" value="A self-signed localhost certificate from the .NET SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h2-3" value=".NET SDK creates&lt;br&gt;self-signed localhost cert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="h2-4" value="dotnet dev-certs https --trust&lt;br&gt;adds it to the trusted store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="h2-5" value="Kestrel uses it automatically&lt;br&gt;for https://localhost endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="h2-6" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h2-3" target="h2-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h2-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h2-4" target="h2-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h2-8" value="--check&lt;br&gt;reports its state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="210" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="h2-9" value="--clean&lt;br&gt;removes it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="210" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="h2-10" value="Linux: trust depends on&lt;br&gt;distribution and browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;fontStyle=1;fontColor=#aaaaaa;" vertex="1" parent="1"><mxGeometry x="610.0" y="210" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="h2-11" value="dotnet run --no-launch-profile -- --urls &quot;https://localhost:5443;http://localhost:5080&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="h2-12" value="Covers only localhost: useless in production · the templates&#x27; https launch profile does the same" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="h3" name="A production certificate in Kestrel">
    <mxGraphModel dx="900" dy="396" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="396" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h3-1" value="A production certificate in Kestrel" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h3-2" value="Give Kestrel a certificate trusted by clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h3-3" value="public CA&lt;br&gt;e.g. Let&#x27;s Encrypt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="h3-4" value="/etc/ssl/catalog/fullchain.pem&lt;br&gt;/etc/ssl/catalog/privkey.pem" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="h3-5" value="Kestrel:Endpoints:Https&lt;br&gt;Url &quot;https://0.0.0.0:443&quot;&lt;br&gt;Certificate Path + KeyPath" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="h3-6" value="issues" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h3-3" target="h3-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h3-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h3-4" target="h3-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h3-8" value="PEM certificate + key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="220" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="h3-9" value="PFX file + password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="220" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="h3-10" value="certificate store entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="220" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="h3-11" value="password and key file out of source control&lt;br&gt;environment variables or a secret store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="290" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="h3-12" value="certificates expire: automate renewal + restart&lt;br&gt;or terminate TLS at a proxy that renews" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460.0" y="290" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="h3-13" value="configuration endpoints replace &lt;font face=&quot;Courier New&quot;&gt;--urls&lt;/font&gt; and the port variables · &lt;font face=&quot;Courier New&quot;&gt;Kestrel:Certificates:Default&lt;/font&gt; covers endpoints without their own" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="h4" name="HTTP Strict Transport Security">
    <mxGraphModel dx="900" dy="460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h4-1" value="HTTP Strict Transport Security" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h4-2" value="After one secure visit, the browser uses only HTTPS for the site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h4-3" value="browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="140" height="280" as="geometry"/></mxCell>
<mxCell id="h4-4" value="app&lt;br&gt;UseHsts()&lt;br&gt;outside&lt;br&gt;Development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="140" height="280" as="geometry"/></mxCell>
<mxCell id="h4-5" value="1 · GET https://..." style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="140" as="sourcePoint"/><mxPoint x="720" y="140" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="h4-6" value="Strict-Transport-Security · MaxAge 60 days · IncludeSubDomains" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="180" as="sourcePoint"/><mxPoint x="180" y="180" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="h4-7" value="browser caches the policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="210" width="460" height="50" as="geometry"/></mxCell>
<mxCell id="h4-8" value="2 · http:// link → upgraded to https by the browser itself" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="300" as="sourcePoint"/><mxPoint x="720" y="300" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="h4-9" value="and certificate errors can&#x27;t be bypassed" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="200" y="320" width="500" height="50" as="geometry"/></mxCell>
<mxCell id="h4-10" value="Not in Development: a cached localhost policy affects every local site · raise MaxAge gradually · Preload only if every subdomain serves HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="h5" name="HTTPS redirection">
    <mxGraphModel dx="900" dy="392" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="392" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="h5-1" value="HTTPS redirection" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="h5-2" value="UseHttpsRedirection redirects plain HTTP to the same URL over HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="h5-3" value="GET http://host/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="h5-4" value="UseHttpsRedirection()&lt;br&gt;finds the HTTPS port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="h5-5" value="308 → https://host:5443/&lt;br&gt;(default 307)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="h5-6" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h5-3" target="h5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h5-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h5-4" target="h5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h5-8" value="HTTPS port sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="520" height="140" as="geometry"/></mxCell>
<mxCell id="h5-9" value="HttpsRedirectionOptions.HttpsPort (5443 here)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="235" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="h5-10" value="ASPNETCORE_HTTPS_PORT / ASPNETCORE_HTTPS_PORTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="269" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="h5-11" value="the server&#x27;s single HTTPS endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="303" width="480" height="28" as="geometry"/></mxCell>
<mxCell id="h5-12" value="none found → logs a warning&lt;br&gt;and doesn&#x27;t redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="h5-13" value="behind a TLS proxy: forwarded&lt;br&gt;headers first, or a redirect loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="h5-14" value="308 once stable: clients keep the method and body and may cache the redirect" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="h6" name="Reject HTTP in APIs">
