<mxCell id="l4-1" value="Message templates and structured data" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="l4-2" value="Placeholders become named properties; arguments fill them by position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="l4-3" value="logger.LogInformation(&quot;Renewed loan {LoanId} for {Days} days&quot;, loanId, days)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="820" height="40" as="geometry"/></mxCell>
<mxCell id="l4-4" value="named properties kept per event&lt;br&gt;LoanId = loanId&lt;br&gt;Days = days" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="l4-5" value="structured provider" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="l4-3" target="l4-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l4-6" value="search every event where LoanId is 42 · --Logging:Console:FormatterName=json shows separate JSON fields" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="l4-7" value="$&quot;Renewed {id}&quot;&lt;br&gt;built even when filtered out&lt;br&gt;properties lost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="l4-8" value="don&#x27;t interpolate in log calls" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="266" width="380" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
