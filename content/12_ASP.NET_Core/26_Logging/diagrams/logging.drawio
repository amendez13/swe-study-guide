<mxCell id="l3-1" value="Log categories" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="l3-2" value="Every logger has a category; filters match categories by prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="l3-3" value="ILogger&amp;lt;LoanService&amp;gt;&lt;br&gt;category = full name of LoanService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="l3-4" value="ILoggerFactory.CreateLogger(&quot;Name&quot;)&lt;br&gt;explicit category" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="l3-5" value="Microsoft" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;fontStyle=1;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="430" height="36" as="geometry"/></mxCell>
<mxCell id="l3-6" value="Microsoft.AspNetCore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;fontStyle=1;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="236" width="430" height="36" as="geometry"/></mxCell>
<mxCell id="l3-7" value="Microsoft.AspNetCore.Routing.EndpointMiddleware" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;fontStyle=1;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="120" y="282" width="430" height="36" as="geometry"/></mxCell>
<mxCell id="l3-8" value="A filter on Microsoft.AspNetCore matches every category under it: namespace-style names change a whole area at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="600" y="190" width="260" height="128" as="geometry"/></mxCell>
<mxCell id="l3-9" value="the console provider prints the category on each line · inject &lt;font face=&quot;Courier New&quot;&gt;ILogger&amp;lt;T&amp;gt;&lt;/font&gt; with each class&#x27;s own type" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="l4" name="Message templates and structured data">
    <mxGraphModel dx="900" dy="316" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="316" math="0" shadow="0">
      <root>
