<mxCell id="l5-1" value="Compile-time logging methods" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="l5-2" value="[LoggerMessage] turns a partial method into an efficient logging method" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="l5-3" value="[LoggerMessage(EventId = 1001, Level = LogLevel.Information, Message = &quot;Renewed loan {LoanId} for {Days} days&quot;)]&lt;br&gt;public static partial void LoanRenewed(this ILogger logger, int loanId, int days);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="820" height="56" as="geometry"/></mxCell>
<mxCell id="l5-4" value="source generator&lt;br&gt;writes the method body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="200" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="l5-5" value="checks the level is enabled&lt;br&gt;before any work · no boxing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="200" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="l5-6" value="call site&lt;br&gt;logger.LoanRenewed(loanId, days)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="200" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="l5-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="l5-4" target="l5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l5-8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="l5-5" target="l5-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
