<mxCell id="vt1-8" value="VT 1 blocked on I/O → unmounted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="190" height="40" as="geometry"/></mxCell>
