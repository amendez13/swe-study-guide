<mxCell id="vt1-12" value="Blocking code (JDBC, RestClient) scales again · waiting gets cheap, computing doesn&#x27;t get faster · Java 24 (JEP 491): blocking inside synchronized no longer pins the carrier · 10,000 one-second sleeps finish in about one second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="820" height="54" as="geometry"/></mxCell>
