<mxCell id="vt1-4" value="thin wrapper around an OS thread&lt;br&gt;large stack · kernel context switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="340" height="60" as="geometry"/></mxCell>
