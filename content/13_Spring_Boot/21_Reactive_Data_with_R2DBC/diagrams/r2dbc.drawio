<mxCell id="r1-13" value="slow reader → fewer rows requested → driver fetches fewer" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="240" as="sourcePoint"/><mxPoint x="820" y="240" as="targetPoint"/></mxGeometry></mxCell>
