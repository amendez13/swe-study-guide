<mxCell id="r4-2" value="Chain the inserts into one pipeline and subscribe once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r4-3" value="Flux.just(Book(null,&lt;br&gt;&quot;Dune&quot;, &quot;Herbert&quot;, 412),&lt;br&gt;Book(null, &quot;Emma&quot;,&lt;br&gt;&quot;Austen&quot;, 474))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=8;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="110" width="150" height="74" as="geometry"/></mxCell>
