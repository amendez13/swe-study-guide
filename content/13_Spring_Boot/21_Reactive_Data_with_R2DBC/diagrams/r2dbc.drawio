        <mxCell id="1" parent="0"/>
<mxCell id="r6-1" value="Show reactive data in a template" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="r6-2" value="Put the Flux in the model; WebFlux or the data driver feeds Thymeleaf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="r6-3" value="model &quot;books&quot; =&lt;br&gt;new ReactiveDataDriverContextVariable(&lt;br&gt;books.findAll(), 50)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="60" as="geometry"/></mxCell>
<mxCell id="r6-4" value="page streamed in batches of 50&lt;br&gt;as rows arrive from the database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="r6-5" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="r6-3" target="r6-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r6-6" value="POST /books&lt;br&gt;@ModelAttribute Book form" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="360" height="60" as="geometry"/></mxCell>
<mxCell id="r6-7" value="books.save(form)&lt;br&gt;.thenReturn(&quot;redirect:/books&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="460" y="220" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="r6-8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="r6-6" target="r6-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r6-9" value="without the data driver: WebFlux collects the Flux before rendering, same template as Spring MVC" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
