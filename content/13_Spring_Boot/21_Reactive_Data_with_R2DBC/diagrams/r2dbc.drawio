<mxCell id="r4-5" value="thenMany(select(Book.class)&lt;br&gt;.matching(query(where(&lt;br&gt;&quot;pages&quot;).greaterThan(450))))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=8;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="375.0" y="110" width="150" height="74" as="geometry"/></mxCell>
