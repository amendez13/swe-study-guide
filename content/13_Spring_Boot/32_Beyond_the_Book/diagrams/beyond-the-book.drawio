<mxCell id="bb1-7" value="notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="160" height="170" as="geometry"/></mxCell>
