<mxCell id="bb4-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="bb4-3" target="bb4-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
