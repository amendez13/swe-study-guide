<mxCell id="bb3-12" value="Boot runs jobs at startup unless spring.batch.job.enabled=false" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="820" height="22" as="geometry"/></mxCell>
