<mxCell id="bb3-9" value="one transaction per chunk · a restart continues from the last committed chunk" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="780" height="30" as="geometry"/></mxCell>
