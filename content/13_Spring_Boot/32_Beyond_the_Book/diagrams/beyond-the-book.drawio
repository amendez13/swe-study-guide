<mxCell id="bb3-5" value="processor&lt;br&gt;String::toUpperCase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330.0" y="140" width="240" height="70" as="geometry"/></mxCell>
