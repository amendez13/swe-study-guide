<mxCell id="ac1-4" value="app.aot&lt;br&gt;loaded + linked classes&lt;br&gt;method profiles (JEP 515)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="95" width="180" height="80" as="geometry"/></mxCell>
