<mxCell id="ac2-10" value="training needs what startup needs:&lt;br&gt;a database used at startup must be reachable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="ac2-11" value="recreate the cache when the application,&lt;br&gt;its dependencies, or the JDK change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="ac2-12" value="same workflow is documented for Class Data Sharing, the predecessor" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="820" height="22" as="geometry"/></mxCell>
