<mxCell id="ac5-9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ac5-5" target="ac5-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ac5-10" value="CRaC-enabled JDK (some Azul or BellSoft builds)&lt;br&gt;Linux · org.crac:crac dependency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="ac5-11" value="secrets loaded before the checkpoint are in it:&lt;br&gt;load them after restore · protect checkpoint files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="400" height="54" as="geometry"/></mxCell>
