<mxCell id="ac3-10" value="training runs in the build container:&lt;br&gt;no external calls at startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="270" width="340" height="54" as="geometry"/></mxCell>
