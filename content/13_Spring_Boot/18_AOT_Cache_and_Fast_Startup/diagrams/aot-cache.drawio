<mxCell id="ac2-4" value="training run&lt;br&gt;-XX:AOTCacheOutput=app.aot&lt;br&gt;spring.context.exit=onRefresh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="251.66666666666666" y="110" width="185" height="80" as="geometry"/></mxCell>
<mxCell id="ac2-5" value="context refreshes&lt;br&gt;every startup class loaded&lt;br&gt;then exits · no traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="463.3333333333333" y="110" width="185" height="80" as="geometry"/></mxCell>
