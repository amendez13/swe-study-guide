<mxCell id="ac3-8" value="&amp;lt;BP_JVM_AOTCACHE_ENABLED&amp;gt;true&lt;br&gt;&amp;lt;/BP_JVM_AOTCACHE_ENABLED&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="340" height="54" as="geometry"/></mxCell>
