<mxCell id="ac1-7" value="mapped at&lt;br&gt;startup" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ac1-4" target="ac1-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ac1-8" value="JDK 24 · JEP 483&lt;br&gt;AOT cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="210" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="ac1-9" value="Java 25 · JEP 514&lt;br&gt;simpler creation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="210" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="ac1-10" value="Java 25 · JEP 515&lt;br&gt;profiles: JIT optimizes sooner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="210" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="ac1-11" value="Valid only with the same JDK build and classpath as the training run → create it from the extracted jar · still a full JVM: dynamic loading, reflection, peak JIT · no code changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="820" height="46" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ac2" name="Enable the AOT cache for a Boot app">
