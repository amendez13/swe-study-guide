        <mxCell id="1" parent="0"/>
<mxCell id="ac5-1" value="Checkpoint and restore with CRaC" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="ac5-2" value="Snapshot a started JVM; restore it warm in milliseconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="ac5-3" value="java -XX:CRaCCheckpointTo=&lt;br&gt;./checkpoint&lt;br&gt;spring.context.checkpoint=&lt;br&gt;onRefresh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=8;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="110" width="185" height="80" as="geometry"/></mxCell>
<mxCell id="ac5-4" value="Spring closes sockets&lt;br&gt;and pools · snapshot&lt;br&gt;of process memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=8;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="251.66666666666666" y="110" width="185" height="80" as="geometry"/></mxCell>
<mxCell id="ac5-5" value="java -XX:CRaCRestoreFrom=&lt;br&gt;./checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=8;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="463.3333333333333" y="110" width="185" height="80" as="geometry"/></mxCell>
<mxCell id="ac5-6" value="restored: started and&lt;br&gt;warm · Spring reopens&lt;br&gt;sockets and pools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=8;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675.0" y="110" width="185" height="80" as="geometry"/></mxCell>
<mxCell id="ac5-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ac5-3" target="ac5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
