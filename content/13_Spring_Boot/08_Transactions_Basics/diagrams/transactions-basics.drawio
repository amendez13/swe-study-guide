<mxCell id="tb3-4" value="returns normally → commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="95" width="540" height="44" as="geometry"/></mxCell>
<mxCell id="tb3-5" value="RuntimeException or Error → rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="151" width="540" height="44" as="geometry"/></mxCell>
<mxCell id="tb3-6" value="checked exception → commit (surprise)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="207" width="540" height="44" as="geometry"/></mxCell>
<mxCell id="tb3-7" value="exception caught and not rethrown → commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="263" width="540" height="44" as="geometry"/></mxCell>
<mxCell id="tb3-8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tb3-3" target="tb3-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
