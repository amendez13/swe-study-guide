<mxCell id="prd2-4" value="concatMap(catalog::find)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="300" height="42" as="geometry"/></mxCell>
