<mxCell id="prd1-8" value="return the Mono to a subscribing caller (e.g. a WebFlux controller) or chain it into a returned pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="820" height="40" as="geometry"/></mxCell>
