<mxCell id="prd2-8" value="concurrent → emitted as they arrive (e.g. 2nd, 1st, 3rd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="214" width="480" height="42" as="geometry"/></mxCell>
