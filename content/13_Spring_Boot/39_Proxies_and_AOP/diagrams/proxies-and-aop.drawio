<mxCell id="paa1-1" value="Cross-cutting concerns" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="paa1-2" value="AOP puts shared behavior in one place and applies it from outside" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="paa1-3" value="without AOP: lend(id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="380" height="230" as="geometry"/></mxCell>
<mxCell id="paa1-4" value="start = System.nanoTime()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="340" height="36" as="geometry"/></mxCell>
<mxCell id="paa1-5" value="doLend(id)  ← business logic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="60" y="181" width="340" height="36" as="geometry"/></mxCell>
<mxCell id="paa1-6" value="println(&quot;lend took ... ms&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="60" y="227" width="340" height="36" as="geometry"/></mxCell>
<mxCell id="paa1-7" value="repeated in every method" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="275" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="paa1-8" value="@Transactional · @PreAuthorize ·&lt;br&gt;@Cacheable · @Async ·&lt;br&gt;@Retryable · @Observed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="paa1-9" value="annotated method: business logic only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="255" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="paa1-10" value="Spring adds the behavior around it" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="paa1-8" target="paa1-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
