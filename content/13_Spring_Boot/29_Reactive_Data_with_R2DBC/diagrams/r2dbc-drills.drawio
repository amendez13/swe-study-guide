<mxCell id="rd1-6" value="Flux.fromIterable(titles).map(t -&amp;gt; new Book(null, t, &quot;unknown&quot;, 100))&lt;br&gt;.concatMap(books::save).blockLast()   // fine in a startup runner, never in a handler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="820" height="50" as="geometry"/></mxCell>
