<mxCell id="rd1-2" value="Each save returns a Mono nobody subscribes to" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="rd1-3" value="for (title : &quot;Dune&quot;, &quot;Emma&quot;, &quot;Ulysses&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;books.save(...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="50" as="geometry"/></mxCell>
