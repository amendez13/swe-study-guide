<mxCell id="rd2-2" value="Add each condition only when its filter is present" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="rd2-3" value="Criteria.empty()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="44" as="geometry"/></mxCell>
<mxCell id="rd2-4" value="author != null?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="rd2-5" value="minPages != null?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="rd2-6" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="rd2-3" target="rd2-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rd2-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="rd2-4" target="rd2-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rd2-8" value=".and(&quot;author&quot;).is(author)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=8;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="200" height="44" as="geometry"/></mxCell>
<mxCell id="rd2-9" value=".and(&quot;pages&quot;)&lt;br&gt;.greaterThanOrEquals(minPages)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=8;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="200" height="44" as="geometry"/></mxCell>
<mxCell id="rd2-10" value="yes" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="rd2-4" target="rd2-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
