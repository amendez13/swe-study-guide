<mxCell id="oo5-10" value="GET /google/userinfo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="240" height="60" as="geometry"/></mxCell>
