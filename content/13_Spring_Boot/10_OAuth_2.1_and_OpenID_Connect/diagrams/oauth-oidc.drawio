<mxfile host="drawio">
  <diagram id="oo1" name="OAuth 2.1 roles and the code flow">
    <mxGraphModel dx="900" dy="496" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="496" math="0" shadow="0">
