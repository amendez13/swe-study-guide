<mxCell id="oo5-4" value="OAuth2AuthorizedClientManager&lt;br&gt;(default bean)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="240" height="70" as="geometry"/></mxCell>
