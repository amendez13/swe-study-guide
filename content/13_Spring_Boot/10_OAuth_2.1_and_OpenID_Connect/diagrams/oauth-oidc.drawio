        <mxCell id="1" parent="0"/>
<mxCell id="oo4-1" value="Sign in with oauth2Login" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="oo4-2" value="oauth2Login() sends users to the provider and handles the redirect back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="oo4-3" value="browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="150" height="310" as="geometry"/></mxCell>
<mxCell id="oo4-4" value="app · oauth2Login()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;verticalAlign=bottom;spacingBottom=80;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="200" height="310" as="geometry"/></mxCell>
<mxCell id="oo4-5" value="Google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="170" height="310" as="geometry"/></mxCell>
<mxCell id="oo4-6" value="protected page" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="140" as="sourcePoint"/><mxPoint x="330" y="140" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo4-7" value="/oauth2/authorization/google" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#d79b00;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="175" as="sourcePoint"/><mxPoint x="190" y="175" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo4-8" value="sign in at Google" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="215" as="sourcePoint"/><mxPoint x="690" y="215" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo4-9" value="redirect /login/oauth2/code/google?code=..." style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#82b366;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="255" as="sourcePoint"/><mxPoint x="190" y="255" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo4-10" value="callback" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="290" as="sourcePoint"/><mxPoint x="330" y="290" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo4-11" value="exchange the code" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="320" as="sourcePoint"/><mxPoint x="690" y="320" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo4-12" value="validate ID token&lt;br&gt;create the session" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="335" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="oo4-13" value="&quot;/&quot; stays public · logout ends the local session only, not the Google one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="oo5" name="Call an OAuth 2 API">
    <mxGraphModel dx="900" dy="394" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="394" math="0" shadow="0">
