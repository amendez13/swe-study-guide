<mxCell id="oo5-8" value="GET https://openidconnect.&lt;br&gt;googleapis.com/v1/userinfo&lt;br&gt;Authorization: Bearer ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="230" width="240" height="80" as="geometry"/></mxCell>
