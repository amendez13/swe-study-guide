<mxCell id="oo5-12" value="Spring Security 7 (Boot 4): @ClientRegistrationId on HTTP service client interfaces carries tokens the same way" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="820" height="34" as="geometry"/></mxCell>
