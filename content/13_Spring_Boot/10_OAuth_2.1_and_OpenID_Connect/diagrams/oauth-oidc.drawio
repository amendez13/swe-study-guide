<mxCell id="oo5-6" value="RestClient&lt;br&gt;+ OAuth2ClientHttpRequestInterceptor&lt;br&gt;clientRegistrationId(&quot;google&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="240" height="80" as="geometry"/></mxCell>
