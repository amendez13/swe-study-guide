<mxCell id="oo1-1" value="OAuth 2.1 roles and the code flow" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="oo1-2" value="Authorization code flow with PKCE: a stolen code is useless without the verifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="oo1-3" value="resource owner&lt;br&gt;(user&#x27;s browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="oo1-4" value="client&lt;br&gt;(your app)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="95" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="oo1-5" value="authorization&lt;br&gt;server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="oo1-6" value="resource&lt;br&gt;server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="95" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="oo1-7" value="" style="endArrow=none;endSize=6;html=1;strokeWidth=1;strokeColor=#bbbbbb;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="145" as="sourcePoint"/><mxPoint x="120" y="420" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-8" value="" style="endArrow=none;endSize=6;html=1;strokeWidth=1;strokeColor=#bbbbbb;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="145" as="sourcePoint"/><mxPoint x="340" y="420" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-9" value="" style="endArrow=none;endSize=6;html=1;strokeWidth=1;strokeColor=#bbbbbb;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="145" as="sourcePoint"/><mxPoint x="560" y="420" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-10" value="" style="endArrow=none;endSize=6;html=1;strokeWidth=1;strokeColor=#bbbbbb;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="145" as="sourcePoint"/><mxPoint x="780" y="420" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-11" value="1 · redirect + hash of verifier" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#82b366;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="170" as="sourcePoint"/><mxPoint x="120" y="170" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-12" value="2 · user authenticates" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="210" as="sourcePoint"/><mxPoint x="560" y="210" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-13" value="3 · redirect back with one-time code" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#82b366;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="250" as="sourcePoint"/><mxPoint x="120" y="250" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-14" value="4 · code to the client" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="290" as="sourcePoint"/><mxPoint x="340" y="290" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-15" value="5 · back channel: code + verifier → tokens" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="330" as="sourcePoint"/><mxPoint x="560" y="330" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-16" value="6 · access token" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="380" as="sourcePoint"/><mxPoint x="780" y="380" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="oo1-17" value="OAuth 2.1: no implicit or password grants · exact redirect URI matching · PKCE required · Spring Security applies PKCE for public clients; withPkce() adds it for a confidential client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="820" height="46" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="oo2" name="OAuth 2.0 and OpenID Connect">
    <mxGraphModel dx="900" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="oo2-1" value="OAuth 2.0 and OpenID Connect" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="oo2-2" value="Access tokens authorize; OIDC adds an ID token that identifies the user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="oo2-3" value="OAuth 2.0 · access token&lt;br&gt;what the client may do&lt;br&gt;not who the user is" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="380" height="100" as="geometry"/></mxCell>
<mxCell id="oo2-4" value="OIDC (scope openid) · ID token&lt;br&gt;signed JWT · claims sub, email, name&lt;br&gt;+ UserInfo endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="380" height="100" as="geometry"/></mxCell>
<mxCell id="oo2-5" value="plain OAuth 2.0 provider&lt;br&gt;→ OAuth2User from user-info" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="oo2-6" value="Spring Security validates the ID token&lt;br&gt;→ OidcUser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="240" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="oo2-7" value="/me: subject · email · issuer&lt;br&gt;idTokenExpires" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="oo2-8" value="@AuthenticationPrincipal" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="oo2-6" target="oo2-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oo2-9" value="Key local data by the stable sub claim, not the email address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="380" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="oo3" name="Register a Google client">
    <mxGraphModel dx="900" dy="374" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="374" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="oo3-1" value="Register a Google client" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="oo3-2" value="The redirect URI follows {baseUrl}/login/oauth2/code/{registrationId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="oo3-3" value="Google Cloud console&lt;br&gt;OAuth client ID · web application&lt;br&gt;→ client ID + client secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="oo3-4" value="authorized redirect URI&lt;br&gt;http://localhost:8080/login/oauth2/code/google" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="460" height="90" as="geometry"/></mxCell>
<mxCell id="oo3-5" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="oo3-3" target="oo3-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oo3-6" value="spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}&lt;br&gt;spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET}&lt;br&gt;spring.security.oauth2.client.registration.google.scope=openid,profile,email" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=left;fontStyle=1;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="820" height="80" as="geometry"/></mxCell>
<mxCell id="oo3-7" value="Spring Security already knows Google&#x27;s endpoints · secrets from environment variables · registration ID google appears in the login and redirect URLs" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="oo4" name="Sign in with oauth2Login">
