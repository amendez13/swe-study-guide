<mxCell id="jai3-7" value="COPY --from=builder ... snapshot-dependencies/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="420" y="218" width="420" height="36" as="geometry"/></mxCell>
<mxCell id="jai3-8" value="COPY --from=builder ... application/ · rebuilt on a code change" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="420" y="262" width="420" height="36" as="geometry"/></mxCell>
<mxCell id="jai3-9" value="ENTRYPOINT java -XX:MaxRAMPercentage=75 -jar application.jar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="420" y="310" width="420" height="36" as="geometry"/></mxCell>
<mxCell id="jai3-10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="jai3-3" target="jai3-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="jai3-11" value="Code changes push a few kilobytes, not the whole dependency set · non-root user · heap sized from the container memory limit · pin and patch the Java 25 base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="300" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
