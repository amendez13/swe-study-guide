<mxCell id="jai3-1" value="Write a Dockerfile" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="jai3-2" value="Multi-stage: extract layers, then copy them least to most frequently changed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="jai3-3" value="stage builder · eclipse-temurin:25-jre&lt;br&gt;COPY target/*.jar application.jar&lt;br&gt;extract --layers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="jai3-4" value="final image · eclipse-temurin:25-jre · USER spring (uid 10001)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="95" width="460" height="260" as="geometry"/></mxCell>
<mxCell id="jai3-5" value="COPY --from=builder ... dependencies/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="420" height="36" as="geometry"/></mxCell>
