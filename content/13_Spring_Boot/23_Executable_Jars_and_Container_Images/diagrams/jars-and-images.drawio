<mxCell id="jai4-10" value="&amp;lt;env&amp;gt;&amp;lt;BP_JVM_VERSION&amp;gt;25&amp;lt;/BP_JVM_VERSION&amp;gt;&amp;lt;/env&amp;gt;&lt;br&gt;buildpack settings are environment variables" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="jai4-11" value="a rebuild can update the base image or JRE&lt;br&gt;without changes to your code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="220" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="jai4-12" value="Buildpacks for consistent, patched images across services · a Dockerfile only when you need control they don&#x27;t offer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="820" height="40" as="geometry"/></mxCell>
