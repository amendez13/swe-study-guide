<mxCell id="k4-11" value="each partition → one consumer in the group" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="595" y="130" width="250" height="50" as="geometry"/></mxCell>
<mxCell id="k4-12" value="own offsets: reads every event independently" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="595" y="240" width="250" height="50" as="geometry"/></mxCell>
