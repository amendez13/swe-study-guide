<mxCell id="k4-7" value="partition 2 · append-only log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="246" width="260" height="44" as="geometry"/></mxCell>
<mxCell id="k4-8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="k4-3" target="k4-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
