<mxCell id="k4-15" value="Same key → same partition → in order · kept for a retention period, so new consumers can replay · partition count caps a group&#x27;s parallelism · Kafka 4 uses KRaft, no ZooKeeper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="54" as="geometry"/></mxCell>
