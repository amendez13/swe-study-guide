<mxCell id="kd2-1" value="Fix the out-of-order events" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="kd2-2" value="Kafka orders messages only within one partition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="kd2-3" value="kafka.send(&quot;employee-events&quot;, event)&lt;br&gt;no key → spread across partitions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="kd2-4" value="send(&quot;employee-events&quot;,&lt;br&gt;String.valueOf(event.employeeId()), event)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="kd2-5" value="add the key" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="kd2-3" target="kd2-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="kd2-6" value="EmployeeHired and EmployeeLeft for one employee → same partition → consumed in order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="820" height="44" as="geometry"/></mxCell>
