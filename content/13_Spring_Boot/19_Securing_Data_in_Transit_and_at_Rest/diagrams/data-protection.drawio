<mxfile host="drawio">
  <diagram id="dp1" name="HTTPS with an SSL bundle">
    <mxGraphModel dx="900" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="dp1-1" value="HTTPS with an SSL bundle" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="dp1-2" value="Define TLS material once as a named bundle, then refer to it by name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="dp1-3" value="openssl req -x509 ...&lt;br&gt;certs/server.crt&lt;br&gt;certs/server.key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="dp1-4" value="spring.ssl.bundle.pem.web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="dp1-5" value="keystore.certificate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="375" y="125" width="250" height="36" as="geometry"/></mxCell>
<mxCell id="dp1-6" value="keystore.private-key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="375" y="170" width="250" height="36" as="geometry"/></mxCell>
<mxCell id="dp1-7" value="file:certs/..." style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp1-3" target="dp1-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp1-8" value="embedded server&lt;br&gt;server.ssl.bundle=web&lt;br&gt;HTTPS only on 8443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="160" height="100" as="geometry"/></mxCell>
<mxCell id="dp1-9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp1-4" target="dp1-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp1-10" value="key store&lt;br&gt;certificate + private key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="260" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="dp1-11" value="trust store (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="260" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="dp1-12" value="protocol options" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="260" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="dp1-13" value="Self-signed for local testing, files out of source control · production certificates come from a CA, often via the platform&#x27;s certificate manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dp2" name="Reload rotated certificates">
    <mxGraphModel dx="900" dy="350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="dp2-1" value="Reload rotated certificates" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="dp2-2" value="reload-on-update applies a new certificate and key without a restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="dp2-3" value="renewal tool writes&lt;br&gt;server.crt + server.key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="110" width="185" height="70" as="geometry"/></mxCell>
<mxCell id="dp2-4" value="Boot watches the&lt;br&gt;bundle&#x27;s files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="251.66666666666666" y="110" width="185" height="70" as="geometry"/></mxCell>
<mxCell id="dp2-5" value="quiet period&lt;br&gt;10s by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="463.3333333333333" y="110" width="185" height="70" as="geometry"/></mxCell>
<mxCell id="dp2-6" value="Tomcat uses the new&lt;br&gt;certificate · no restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675.0" y="110" width="185" height="70" as="geometry"/></mxCell>
<mxCell id="dp2-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp2-3" target="dp2-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp2-8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp2-4" target="dp2-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp2-9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp2-5" target="dp2-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp2-10" value="spring.ssl.bundle.pem.web.reload-on-update=true · spring.ssl.bundle.watch.file.quiet-period=10s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="820" height="44" as="geometry"/></mxCell>
<mxCell id="dp2-11" value="Replace both files in one step (write temporary files, then rename) so the server never reads a certificate with the wrong key · still monitor expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dp3" name="Trust a private certificate authority">
    <mxGraphModel dx="900" dy="360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="dp3-1" value="Trust a private certificate authority" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="dp3-2" value="A trust-store-only bundle scoped to one client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="dp3-3" value="spring.ssl.bundle.pem.partner&lt;br&gt;truststore = certs/partner-ca.crt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="dp3-4" value="RestClient.Builder&lt;br&gt;.apply(ssl.fromBundle(&quot;partner&quot;))&lt;br&gt;RestClientSsl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="dp3-5" value="https://partner.&lt;br&gt;example.internal&lt;br&gt;(private CA cert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="dp3-6" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp3-3" target="dp3-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp3-7" value="TLS&lt;br&gt;verified" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp3-4" target="dp3-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp3-8" value="scoped to this client&lt;br&gt;(not the JVM-wide trust store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="220" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="dp3-9" value="mutual TLS: add a key store&lt;br&gt;to the same bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460.0" y="220" width="400" height="54" as="geometry"/></mxCell>
<mxCell id="dp3-10" value="never turn off certificate or hostname verification: point the bundle at the right CA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dp4" name="Require HTTPS in the browser">
    <mxGraphModel dx="900" dy="440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="dp4-1" value="Require HTTPS in the browser" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="dp4-2" value="Redirect insecure requests; HSTS keeps the browser on HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="dp4-3" value="browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="140" height="260" as="geometry"/></mxCell>
<mxCell id="dp4-4" value="proxy&lt;br&gt;terminates TLS&lt;br&gt;X-Forwarded-Proto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="160" height="260" as="geometry"/></mxCell>
<mxCell id="dp4-5" value="app&lt;br&gt;redirectToHttps&lt;br&gt;forward-headers-&lt;br&gt;strategy=native" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="180" height="260" as="geometry"/></mxCell>
<mxCell id="dp4-6" value="http" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="140" as="sourcePoint"/><mxPoint x="250" y="140" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="dp4-7" value="plain HTTP" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="140" as="sourcePoint"/><mxPoint x="680" y="140" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="dp4-8" value="redirect → https" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#d79b00;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="180" as="sourcePoint"/><mxPoint x="180" y="180" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="dp4-9" value="https" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="240" as="sourcePoint"/><mxPoint x="250" y="240" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="dp4-10" value="X-Forwarded-Proto: https" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="240" as="sourcePoint"/><mxPoint x="680" y="240" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="dp4-11" value="secure · Strict-Transport-Security (max-age 31536000)" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#82b366;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="290" as="sourcePoint"/><mxPoint x="180" y="290" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="dp4-12" value="Without a forward-headers strategy the app never sees the request as secure: the redirect loops and no HSTS header is sent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dp5" name="Encrypt sensitive columns">
    <mxGraphModel dx="900" dy="390" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="390" math="0" shadow="0">
      <root>
