        <mxCell id="1" parent="0"/>
<mxCell id="dp5-1" value="Encrypt sensitive columns" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="dp5-2" value="Encrypt what the app must read back; hash what it only compares" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="dp5-3" value="storage / disk encryption&lt;br&gt;against stolen storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="100" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="dp5-4" value="password hash&lt;br&gt;can&#x27;t be read back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="100" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="dp5-5" value="column encryption&lt;br&gt;read back, hidden from dumps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="100" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="dp5-6" value="Member.phone&lt;br&gt;@Convert(EncryptedText.class)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="dp5-7" value="EncryptedText converter (@Component)&lt;br&gt;Encryptors.delux(password, salt)&lt;br&gt;256-bit AES-GCM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="190" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="dp5-8" value="phone column&lt;br&gt;ciphertext" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="dp5-9" value="write" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp5-6" target="dp5-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp5-10" value="encrypt" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dp5-7" target="dp5-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dp5-11" value="decrypt on read" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp5-8" target="dp5-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="300"/><mxPoint x="170" y="300"/></Array></mxGeometry></mxCell>
<mxCell id="dp5-12" value="Secrets study.crypto.password and study.crypto.salt from the environment or a secrets manager · encrypted columns can&#x27;t be searched with WHERE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="820" height="40" as="geometry"/></mxCell>
