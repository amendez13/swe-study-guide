<mxCell id="sac1-9" value="knows nothing about your data&lt;br&gt;unless the prompt includes it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325.0" y="230" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="sac1-10" value="can be confidently wrong" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="230" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="sac1-11" value="Spring AI 2.0 for Boot 4 · import spring-ai-bom · providers: Anthropic, OpenAI, Ollama · API key from ANTHROPIC_API_KEY · model claude-sonnet-5-5" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="820" height="34" as="geometry"/></mxCell>
