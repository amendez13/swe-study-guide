<mxCell id="sac2-7" value="user message" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="sac2-4" target="sac2-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="sac2-8" value="content() → text · chatResponse() → metadata, token usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="260" width="380" height="44" as="geometry"/></mxCell>
<mxCell id="sac2-9" value="Never paste user input into the system prompt: that separation is the first defense against prompt injection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="820" height="40" as="geometry"/></mxCell>
