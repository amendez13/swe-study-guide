<mxCell id="sac2-5" value="chat.prompt()&lt;br&gt;.user(&quot;I want to read about &quot; + topic)&lt;br&gt;.call().content()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="380" height="80" as="geometry"/></mxCell>
