<mxCell id="hc2-8" value="5xx → HttpServerErrorException" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="300" height="40" as="geometry"/></mxCell>
<mxCell id="hc2-9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hc2-4" target="hc2-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="145"/><mxPoint x="530" y="110"/></Array></mxGeometry></mxCell>
<mxCell id="hc2-10" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hc2-4" target="hc2-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="145"/><mxPoint x="530" y="165"/></Array></mxGeometry></mxCell>
<mxCell id="hc2-11" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hc2-4" target="hc2-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="145"/><mxPoint x="530" y="220"/></Array></mxGeometry></mxCell>
<mxCell id="hc2-12" value="spring.http.clients.connect-timeout=2s&lt;br&gt;spring.http.clients.read-timeout=5s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="hc2-13" value="A stuck call still holds a database connection or a waiting user, even on virtual threads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="270" width="400" height="50" as="geometry"/></mxCell>
<mxCell id="hc2-14" value="&lt;font face=&quot;Courier New&quot;&gt;exchange&lt;/font&gt; gives full control over the response" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="820" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hc3" name="Declare an HTTP service interface">
    <mxGraphModel dx="900" dy="310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="310" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="hc3-1" value="Declare an HTTP service interface" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="hc3-2" value="Spring creates a proxy that turns each method call into an HTTP request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="hc3-3" value="@HttpExchange(&quot;/reviews&quot;) interface ReviewClient&lt;br&gt;@GetExchange(&quot;/{isbn}&quot;) forBook(&lt;br&gt;&amp;nbsp;&amp;nbsp;@PathVariable isbn,&lt;br&gt;&amp;nbsp;&amp;nbsp;@RequestParam(defaultValue = &quot;10&quot;) limit)&lt;br&gt;@PostExchange add(@RequestBody Review)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;fontStyle=1;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="hc3-4" value="proxy&lt;br&gt;(RestClient)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="140" height="90" as="geometry"/></mxCell>
<mxCell id="hc3-5" value="reviews&lt;br&gt;service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="120" height="90" as="geometry"/></mxCell>
<mxCell id="hc3-6" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="hc3-3" target="hc3-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hc3-7" value="GET /reviews/{isbn}?limit=10&lt;br&gt;POST /reviews" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=9;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="hc3-4" target="hc3-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hc3-8" value="Callers depend on an interface, easy to replace in tests · return types: the body, a ResponseEntity, or error-mapped handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="820" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hc4" name="Register HTTP service clients in Boot 4">
    <mxGraphModel dx="900" dy="360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="hc4-1" value="Register HTTP service clients in Boot 4" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="hc4-2" value="@ImportHttpServices registers interfaces as beans in a named group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="hc4-3" value="@ImportHttpServices(group = &quot;reviews&quot;,&lt;br&gt;types = ReviewClient.class)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="hc4-4" value="spring.http.serviceclient.reviews.base-url=&lt;br&gt;http://localhost:8082 · read-timeout=3s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=center;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="hc4-5" value="group &quot;reviews&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="380" height="170" as="geometry"/></mxCell>
<mxCell id="hc4-6" value="ReviewClient bean (proxy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="340" height="40" as="geometry"/></mxCell>
<mxCell id="hc4-7" value="client configured by Boot&lt;br&gt;from the group&#x27;s properties" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="185" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="hc4-8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="hc4-3" target="hc4-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hc4-9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="hc4-4" target="hc4-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hc4-10" value="RestClientHttpServiceGroupConfigurer: customize a group&#x27;s builder in code (auth header, interceptor) · no more HttpServiceProxyFactory by hand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="820" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hc5" name="Retry and limit calls with Spring Framework 7">
    <mxGraphModel dx="900" dy="330" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="330" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="hc5-1" value="Retry and limit calls with Spring Framework 7" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="30" as="geometry"/></mxCell>
<mxCell id="hc5-2" value="@Retryable and @ConcurrencyLimit are now in the core framework" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="820" height="32" as="geometry"/></mxCell>
<mxCell id="hc5-3" value="thousands of&lt;br&gt;virtual threads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="hc5-4" value="@ConcurrencyLimit(20)&lt;br&gt;at most 20 at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="hc5-5" value="@Retryable 5xx&lt;br&gt;maxRetries 3 · delay 200&lt;br&gt;multiplier 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="hc5-6" value="reviews&lt;br&gt;service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="100" height="80" as="geometry"/></mxCell>
<mxCell id="hc5-7" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="hc5-3" target="hc5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hc5-8" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="hc5-4" target="hc5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hc5-9" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="hc5-5" target="hc5-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hc5-10" value="retry only idempotent calls (GETs)&lt;br&gt;a timed-out POST may run twice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="250" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="hc5-11" value="@EnableResilientMethods enables both&lt;br&gt;(Boot 3 needed Spring Retry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460.0" y="250" width="400" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
